{
 "examId": "2024-12",
 "primarySrt": "2024年12月JLPT日语能力考试N1历年真题听力.srt",
 "segments": [
  {
   "index": 1,
   "startMs": 0,
   "endMs": 630,
   "text": "あ。"
  },
  {
   "index": 2,
   "startMs": 3790,
   "endMs": 6700,
   "text": "これから音を聞いてください。"
  },
  {
   "index": 3,
   "startMs": 7100,
   "endMs": 11090,
   "text": "音がよく聞こえない時きは手を挙げてください。"
  },
  {
   "index": 4,
   "startMs": 13410,
   "endMs": 16380,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 5,
   "startMs": 16790,
   "endMs": 19640,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 6,
   "startMs": 19990,
   "endMs": 22840,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 7,
   "startMs": 23170,
   "endMs": 26020,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 8,
   "startMs": 33350,
   "endMs": 38360,
   "text": "日本語能力試験聴解エヌ一。"
  },
  {
   "index": 9,
   "startMs": 39180,
   "endMs": 43470,
   "text": "これからエヌ一の懲戒試験を始めます。"
  },
  {
   "index": 10,
   "startMs": 43960,
   "endMs": 47950,
   "text": "問題用紙にメモを取っても構いません。"
  },
  {
   "index": 11,
   "startMs": 48710,
   "endMs": 51380,
   "text": "問題用紙を開けてください。"
  },
  {
   "index": 12,
   "startMs": 52350,
   "endMs": 57060,
   "text": "問題用紙のページがないときは手を挙げてください。"
  },
  {
   "index": 13,
   "startMs": 58170,
   "endMs": 62640,
   "text": "問題がよく見えない時も手を挙げてください。"
  },
  {
   "index": 14,
   "startMs": 63390,
   "endMs": 65280,
   "text": "いつでもいいです。"
  },
  {
   "index": 15,
   "startMs": 71890,
   "endMs": 73840,
   "text": "問題1。"
  },
  {
   "index": 16,
   "startMs": 74300,
   "endMs": 78890,
   "text": "問題一では、まず質問を聞いてください。"
  },
  {
   "index": 17,
   "startMs": 79410,
   "endMs": 81780,
   "text": "それから話を聞いて。"
  },
  {
   "index": 18,
   "startMs": 81870,
   "endMs": 85680,
   "text": "問題用紙の一から四の中から。"
  },
  {
   "index": 19,
   "startMs": 85820,
   "endMs": 89690,
   "text": "最も良いものを一つ選んでください。"
  },
  {
   "index": 20,
   "startMs": 91970,
   "endMs": 94100,
   "text": "では、始めます。"
  },
  {
   "index": 21,
   "startMs": 96690,
   "endMs": 97620,
   "text": "は。"
  },
  {
   "index": 22,
   "startMs": 99800,
   "endMs": 101090,
   "text": "一番。"
  },
  {
   "index": 23,
   "startMs": 101450,
   "endMs": 108380,
   "text": "大学の演劇サークルで女の学生と部長の男の学生が話して、います。"
  },
  {
   "index": 24,
   "startMs": 108470,
   "endMs": 113180,
   "text": "女の学生はこの後何をしなければなりませんか。"
  },
  {
   "index": 25,
   "startMs": 114470,
   "endMs": 126500,
   "text": "鈴木さん、来週の新入生勧誘のためのサークル体験会ポスターを見た人から早速参加の申し込みが来てますねうん、準備進めないとね。"
  },
  {
   "index": 26,
   "startMs": 126610,
   "endMs": 131920,
   "text": "当日来てもらった人には、演劇を一部実際に体験してもらうよね。"
  },
  {
   "index": 27,
   "startMs": 132050,
   "endMs": 138020,
   "text": "その時に使うシーン、台本から広報を選ぶのお願いしてたけどどう。"
  },
  {
   "index": 28,
   "startMs": 138230,
   "endMs": 148100,
   "text": "はい、体験者が多くても使えそうなシーンを三つピックアップしましたじゃあその中から僕が選んでセリフを印刷しておくよ。"
  },
  {
   "index": 29,
   "startMs": 148100,
   "endMs": 157460,
   "text": "あと、当日は受付とか誘導とかみんなにも手伝ってもらうから、誰が何を担当するか割り振ってほしいんだ。"
  },
  {
   "index": 30,
   "startMs": 157610,
   "endMs": 168080,
   "text": "わかりましたえっと、当日配る入学案内のチラシの準備はああ、それは二年生に印刷してもらおうと思ってるんだ。"
  },
  {
   "index": 31,
   "startMs": 168080,
   "endMs": 169880,
   "text": "僕から頼んでおくよ。"
  },
  {
   "index": 32,
   "startMs": 169970,
   "endMs": 171440,
   "text": "わかりました。"
  },
  {
   "index": 33,
   "startMs": 172970,
   "endMs": 173780,
   "text": "う？"
  },
  {
   "index": 34,
   "startMs": 176190,
   "endMs": 180900,
   "text": "女の学生はこの後何をしなければなりませんか。"
  },
  {
   "index": 35,
   "startMs": 193840,
   "endMs": 195010,
   "text": "二番？"
  },
  {
   "index": 36,
   "startMs": 195350,
   "endMs": 202160,
   "text": "食品の会社で男の課長と女の人が開発中の焼きそばについて話しています。"
  },
  {
   "index": 37,
   "startMs": 202270,
   "endMs": 207040,
   "text": "女の人はこの後どのように焼きそばを改良しますか？"
  },
  {
   "index": 38,
   "startMs": 208420,
   "endMs": 215590,
   "text": "上田さん、上田さんが開発担当の冷凍焼きそばですが、出会のアンケート結果を取りました。"
  },
  {
   "index": 39,
   "startMs": 215680,
   "endMs": 216730,
   "text": "はい。"
  },
  {
   "index": 40,
   "startMs": 216890,
   "endMs": 224000,
   "text": "上田さんがセールスポイントにしたいと言っていた具がたっぷり入っているという点は好評でしたね。"
  },
  {
   "index": 41,
   "startMs": 224120,
   "endMs": 225830,
   "text": "はい、ありがとうござ。"
  },
  {
   "index": 42,
   "startMs": 225830,
   "endMs": 231830,
   "text": "います、味については、恋とかしょっぱいとかいうコメントが思ったよりも多かったで、すね。"
  },
  {
   "index": 43,
   "startMs": 231940,
   "endMs": 235210,
   "text": "塩分量をもう少し押さえて作ってください。"
  },
  {
   "index": 44,
   "startMs": 235350,
   "endMs": 240840,
   "text": "それから、麺は適量とやや少ないと答えた人に分かれていました。"
  },
  {
   "index": 45,
   "startMs": 241020,
   "endMs": 245850,
   "text": "でも、原価から考えると麺の量を増やすのは難しいで、すね。"
  },
  {
   "index": 46,
   "startMs": 245980,
   "endMs": 248050,
   "text": "そうなんですよね。"
  },
  {
   "index": 47,
   "startMs": 248050,
   "endMs": 260890,
   "text": "麺を太くして食べ応えが出るようにする、のも一安かと思うのですが、でも麺の太さについて否定的な評価はなかったし、具とのバランスもあるから、とりあえず現状維持で。"
  },
  {
   "index": 48,
   "startMs": 261040,
   "endMs": 264490,
   "text": "では、次の試食会までに改良お願いします。"
  },
  {
   "index": 49,
   "startMs": 264690,
   "endMs": 266160,
   "text": "わかりました。"
  },
  {
   "index": 50,
   "startMs": 267590,
   "endMs": 268460,
   "text": "。"
  },
  {
   "index": 51,
   "startMs": 270770,
   "endMs": 275540,
   "text": "女の人はこの後どのように焼きそばを改良しますか？"
  },
  {
   "index": 52,
   "startMs": 288040,
   "endMs": 289390,
   "text": "3番。"
  },
  {
   "index": 53,
   "startMs": 289740,
   "endMs": 293490,
   "text": "森の自然教室でガイドが話して、います。"
  },
  {
   "index": 54,
   "startMs": 293670,
   "endMs": 299640,
   "text": "冬の森の散策ツアーに参加する人は、この後まず何をしますか？"
  },
  {
   "index": 55,
   "startMs": 301050,
   "endMs": 305760,
   "text": "今日は冬の森の散策ツアーにご参加ありがとうございます。"
  },
  {
   "index": 56,
   "startMs": 305840,
   "endMs": 312710,
   "text": "後ほど外に出て、雪の上を歩くためのスノーシュという道具を靴につけて散策します。"
  },
  {
   "index": 57,
   "startMs": 312840,
   "endMs": 324870,
   "text": "通常ですと先にこの森に住む動物を紹介したビデオをご覧いただくのですが、この後天気が崩れるようなので、順番を入れ替え、先に散策をします。"
  },
  {
   "index": 58,
   "startMs": 325090,
   "endMs": 330580,
   "text": "これから記念写真を撮るので、この建物の入り口に集まってください。"
  },
  {
   "index": 59,
   "startMs": 330770,
   "endMs": 333380,
   "text": "その後、スノーシュを吐きましょう。"
  },
  {
   "index": 60,
   "startMs": 333620,
   "endMs": 338450,
   "text": "先ほど受付でお渡しした地図は散策の時に使います。"
  },
  {
   "index": 61,
   "startMs": 339780,
   "endMs": 340830,
   "text": "。"
  },
  {
   "index": 62,
   "startMs": 343040,
   "endMs": 348770,
   "text": "冬の森の散策ツアーに参加する人は、この後、まず何をしますか？"
  },
  {
   "index": 63,
   "startMs": 361360,
   "endMs": 362590,
   "text": "四番。"
  },
  {
   "index": 64,
   "startMs": 362920,
   "endMs": 369790,
   "text": "電話でカフェの店長と建築会社の男の人が店のリフォームについて話しています。"
  },
  {
   "index": 65,
   "startMs": 370160,
   "endMs": 374630,
   "text": "男の人は今回のリフォーム案の何を直しますか？"
  },
  {
   "index": 66,
   "startMs": 376000,
   "endMs": 379150,
   "text": "もしもしカフェチリーの本田です。"
  },
  {
   "index": 67,
   "startMs": 379150,
   "endMs": 385990,
   "text": "メールで送ってもらった店のリフォームの修正案拝見しましたお世話になっております。"
  },
  {
   "index": 68,
   "startMs": 385990,
   "endMs": 395710,
   "text": "前回のご要望をもとに床の素材を木に変えたんですが、イメージ画像はいかがでしょうか温かみが出ましたね。"
  },
  {
   "index": 69,
   "startMs": 395810,
   "endMs": 402440,
   "text": "ただ、店内が前より暗く見えるんですが、壁と照明は前回と同じですよね。"
  },
  {
   "index": 70,
   "startMs": 402440,
   "endMs": 407300,
   "text": "はい、壁は恋愛色のままですし、照明も同じです。"
  },
  {
   "index": 71,
   "startMs": 407440,
   "endMs": 412330,
   "text": "床を同じ素材でもう少し明るいものに変えることもできますが。"
  },
  {
   "index": 72,
   "startMs": 412460,
   "endMs": 429770,
   "text": "床はこれでいいと思うので、壁の色のトーンを変えた案を作ってもらえますかそれを見て、場合によっては照明器具の変更を検討しようかな承知しましたじゃあトーンを上げて修正したものをお送りします。"
  },
  {
   "index": 73,
   "startMs": 429850,
   "endMs": 436720,
   "text": "あのカウンターのデザインも変更して、いますがいかがでしょうかあ、気に入りました。"
  },
  {
   "index": 74,
   "startMs": 436720,
   "endMs": 438400,
   "text": "これでお願いします。"
  },
  {
   "index": 75,
   "startMs": 438510,
   "endMs": 440100,
   "text": "かしこまりました。"
  },
  {
   "index": 76,
   "startMs": 441450,
   "endMs": 442380,
   "text": "。"
  },
  {
   "index": 77,
   "startMs": 444630,
   "endMs": 449700,
   "text": "男の人は今回のリフォーム案の何を直しますか？"
  },
  {
   "index": 78,
   "startMs": 462180,
   "endMs": 463290,
   "text": "5番。"
  },
  {
   "index": 79,
   "startMs": 463640,
   "endMs": 468890,
   "text": "介護用品を作る会社で、課長と男の人が話しています。"
  },
  {
   "index": 80,
   "startMs": 469000,
   "endMs": 473230,
   "text": "男の人は今日、何をしなければなりませんか？"
  },
  {
   "index": 81,
   "startMs": 474570,
   "endMs": 481200,
   "text": "田中さん、来月の介護用品の展示会のことで話したいんですが、はい、課長。"
  },
  {
   "index": 82,
   "startMs": 481450,
   "endMs": 499900,
   "text": "田中さんの担当は、会場で使う備品のレンタルの予約、顧客への案内状の送付、それからカタログの用意で、すねはい、取引先への案内上の文明案とレンタル会社に送る予定の注文書は昨日課長にお送りしたかと。"
  },
  {
   "index": 83,
   "startMs": 499980,
   "endMs": 506250,
   "text": "え、案内上はあれでいいので、今週中に取引先に送ってください。"
  },
  {
   "index": 84,
   "startMs": 506380,
   "endMs": 514630,
   "text": "備品のレンタルですが、会場で仕切りに使うパネルとか机とか去年と同じ数になっていますよね。"
  },
  {
   "index": 85,
   "startMs": 514740,
   "endMs": 520110,
   "text": "今年は商談のスペースが3つ増えるので、その分を増やしてください。"
  },
  {
   "index": 86,
   "startMs": 520550,
   "endMs": 522020,
   "text": "あ、すみません。"
  },
  {
   "index": 87,
   "startMs": 522190,
   "endMs": 529480,
   "text": "レンタル会社への注文前に、私が会計課に承認をもらうので、今日中に修正お願いします。"
  },
  {
   "index": 88,
   "startMs": 529590,
   "endMs": 530940,
   "text": "わかりました。"
  },
  {
   "index": 89,
   "startMs": 531050,
   "endMs": 537680,
   "text": "それからカタログは最新のものが納品されますから、当日はそれを持っていってください。"
  },
  {
   "index": 90,
   "startMs": 539230,
   "endMs": 540220,
   "text": "う。"
  },
  {
   "index": 91,
   "startMs": 542360,
   "endMs": 546650,
   "text": "男の人は今日何をしなければなりませんか？"
  },
  {
   "index": 92,
   "startMs": 559740,
   "endMs": 561510,
   "text": "問題二。"
  },
  {
   "index": 93,
   "startMs": 561760,
   "endMs": 566170,
   "text": "問題二では、まず質問を聞いてください。"
  },
  {
   "index": 94,
   "startMs": 566840,
   "endMs": 571010,
   "text": "その後、問題用紙の選択肢を読んでください。"
  },
  {
   "index": 95,
   "startMs": 571270,
   "endMs": 573220,
   "text": "読む時間があります。"
  },
  {
   "index": 96,
   "startMs": 574080,
   "endMs": 576390,
   "text": "それから話を聞いて。"
  },
  {
   "index": 97,
   "startMs": 576510,
   "endMs": 584040,
   "text": "問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 98,
   "startMs": 586450,
   "endMs": 588700,
   "text": "では、始めます。"
  },
  {
   "index": 99,
   "startMs": 595470,
   "endMs": 596700,
   "text": "一番。"
  },
  {
   "index": 100,
   "startMs": 597100,
   "endMs": 602530,
   "text": "ラジオでアナウンサーと花火の会社で働く男の人が話して、います。"
  },
  {
   "index": 101,
   "startMs": 602800,
   "endMs": 607810,
   "text": "男の人が花火の職人になりたいと思ったきっかけは何ですか？"
  },
  {
   "index": 102,
   "startMs": 630950,
   "endMs": 637340,
   "text": "今日は花火の制作と打ち上げの仕事をされている森田さんにお話を伺います。"
  },
  {
   "index": 103,
   "startMs": 637540,
   "endMs": 644770,
   "text": "森田さん、花火のお仕事は代々家業を受け継がれてという方が多いそうですね。"
  },
  {
   "index": 104,
   "startMs": 644910,
   "endMs": 650100,
   "text": "そうで、すね僕の場合は違うんですけどそうなんですか。"
  },
  {
   "index": 105,
   "startMs": 650310,
   "endMs": 657300,
   "text": "大学の時、初めて花火大会の会場で間近で花火を見たんですが、花火の響くよ。"
  },
  {
   "index": 106,
   "startMs": 657300,
   "endMs": 661740,
   "text": "うな音、その圧倒的な力強さに心を奪われたんです。"
  },
  {
   "index": 107,
   "startMs": 661930,
   "endMs": 670720,
   "text": "そのよ、うな花火を作って打ち上げてみたいと思って、家が花火の会社をしている友人に頼み込んでこの道に入りました。"
  },
  {
   "index": 108,
   "startMs": 670930,
   "endMs": 675460,
   "text": "そうですかこの仕事をされてみていかがですか？"
  },
  {
   "index": 109,
   "startMs": 675660,
   "endMs": 684570,
   "text": "玉を半分にしたものに花火材料を並べていくんですが、少しでもズレがあると空では大きく歪んでしまうんです。"
  },
  {
   "index": 110,
   "startMs": 684830,
   "endMs": 691460,
   "text": "正確に詰めるのが難しいので、うまくいった時の達成感は何にも変えがたいものです。"
  },
  {
   "index": 111,
   "startMs": 692780,
   "endMs": 693650,
   "text": "う。"
  },
  {
   "index": 112,
   "startMs": 695900,
   "endMs": 700970,
   "text": "男の人が花火の職人になりたいと思ったきっかけは何ですか？"
  },
  {
   "index": 113,
   "startMs": 713470,
   "endMs": 714580,
   "text": "2番。"
  },
  {
   "index": 114,
   "startMs": 714930,
   "endMs": 720120,
   "text": "宇宙科学館のコンテストで司会者と女の人が話して、います。"
  },
  {
   "index": 115,
   "startMs": 720570,
   "endMs": 726600,
   "text": "女の人は宇宙職の開発で最も大変だったことは何だと言っていますか？"
  },
  {
   "index": 116,
   "startMs": 749890,
   "endMs": 754360,
   "text": "宇宙食開発コンテスト優勝チームのリーダー中山さんです。"
  },
  {
   "index": 117,
   "startMs": 754360,
   "endMs": 755560,
   "text": "おめでとうござ。"
  },
  {
   "index": 118,
   "startMs": 755560,
   "endMs": 757060,
   "text": "います、ありがとうござ。"
  },
  {
   "index": 119,
   "startMs": 757060,
   "endMs": 757660,
   "text": "います。"
  },
  {
   "index": 120,
   "startMs": 757950,
   "endMs": 775200,
   "text": "中山さんのチームは魚の缶詰を開発されましたここまで開発するのは大変だったんじゃないですかそうですね宇宙で美味しく食べられるものにするのは大変でした魚の栄養もできるだけ損ねないようにしました。"
  },
  {
   "index": 121,
   "startMs": 775440,
   "endMs": 791190,
   "text": "先ほど一口いただいたんですが、味がずいぶん濃いですね宇宙では味覚が鈍るそうなのでかなり濃い味にしましたタレも飛び散らないようにとろみをつけましたそうなんですか。"
  },
  {
   "index": 122,
   "startMs": 791440,
   "endMs": 804370,
   "text": "硬さもちょうど良くて食べやすいですねそこが最大の難関でした宇宙ではスプーンしか使わないそうなので柔らかくしたんですが、食感も楽しめるように工夫しました。"
  },
  {
   "index": 123,
   "startMs": 804470,
   "endMs": 809480,
   "text": "最後まで試行錯誤して、ようやく今の柔らかさにたどり着いたんです。"
  },
  {
   "index": 124,
   "startMs": 810820,
   "endMs": 811810,
   "text": "。"
  },
  {
   "index": 125,
   "startMs": 813980,
   "endMs": 820070,
   "text": "女の人は宇宙職の開発で、最も大変だったことは何だと言っていますか？"
  },
  {
   "index": 126,
   "startMs": 832540,
   "endMs": 833890,
   "text": "3番。"
  },
  {
   "index": 127,
   "startMs": 834250,
   "endMs": 838000,
   "text": "会社のリーダー研修で講師が話して、います。"
  },
  {
   "index": 128,
   "startMs": 838410,
   "endMs": 843960,
   "text": "講師は部下と接するとに何を忘れないようにしていたと言っていますか。"
  },
  {
   "index": 129,
   "startMs": 867200,
   "endMs": 873470,
   "text": "チームで仕事を成功させるコツは、リーダーが部下と良好な関係を築くことです。"
  },
  {
   "index": 130,
   "startMs": 873760,
   "endMs": 875350,
   "text": "そのためには？"
  },
  {
   "index": 131,
   "startMs": 875440,
   "endMs": 880570,
   "text": "部下への感謝の気持ちを忘れてはいけないと聞いたことがあるかもしれません。"
  },
  {
   "index": 132,
   "startMs": 880810,
   "endMs": 884380,
   "text": "部下には笑顔で接するべきだとも言われますね。"
  },
  {
   "index": 133,
   "startMs": 884690,
   "endMs": 893000,
   "text": "とはいえ、私自身も部下の言い分ばかりを聞いてはいられず、厳しい指摘をせざるを得ないこともありました。"
  },
  {
   "index": 134,
   "startMs": 893300,
   "endMs": 896150,
   "text": "ただ、そんな時でも話の最後は？"
  },
  {
   "index": 135,
   "startMs": 896230,
   "endMs": 903820,
   "text": "これを糧に次は頑張ろうなどと部下の意識がプラスに転じることを言うように心がけていました。"
  },
  {
   "index": 136,
   "startMs": 904020,
   "endMs": 908130,
   "text": "部下との関係を築く方法は一つではありません。"
  },
  {
   "index": 137,
   "startMs": 908350,
   "endMs": 912700,
   "text": "今日の研修を通して、自分なりの方法を見出してください。"
  },
  {
   "index": 138,
   "startMs": 914030,
   "endMs": 914900,
   "text": "う。"
  },
  {
   "index": 139,
   "startMs": 917180,
   "endMs": 922850,
   "text": "講師は部下と接するとに何を忘れないようにしていたと言っていますか。"
  },
  {
   "index": 140,
   "startMs": 935370,
   "endMs": 936600,
   "text": "四番。"
  },
  {
   "index": 141,
   "startMs": 936840,
   "endMs": 941730,
   "text": "テレビでアナウンサーの男の人と花屋の店長が話して、います。"
  },
  {
   "index": 142,
   "startMs": 942030,
   "endMs": 948960,
   "text": "店長は花を届けるサービスのどんな点が最も客に喜ばれていると言っていますか。"
  },
  {
   "index": 143,
   "startMs": 972150,
   "endMs": 986640,
   "text": "こちらのお店ではお客様に定期的に花を届けるサービスが好評だそうで、すねはい、私どもの花の定期便ではお客様が希望された色の系統で花束を作ってお届けしています。"
  },
  {
   "index": 144,
   "startMs": 986770,
   "endMs": 991240,
   "text": "花は長く咲き続けるよう、丁寧に処理をしているんです。"
  },
  {
   "index": 145,
   "startMs": 991320,
   "endMs": 996090,
   "text": "そうですかあのどのぐらいの頻度で届くんですか。"
  },
  {
   "index": 146,
   "startMs": 996220,
   "endMs": 1001290,
   "text": "毎月毎週、もしくは2週間に一度からお選びいただけます。"
  },
  {
   "index": 147,
   "startMs": 1001470,
   "endMs": 1011340,
   "text": "それはいいで、すね花束の大きさも選べるんでしょうか大きさは決まっていて、小さなテーブルでも飾りやすいボリュームにしています。"
  },
  {
   "index": 148,
   "startMs": 1011450,
   "endMs": 1019520,
   "text": "毎回自分の好みの色を選択できるので、その点がお客様に何より高い評価をいたいていると感じています。"
  },
  {
   "index": 149,
   "startMs": 1019630,
   "endMs": 1021460,
   "text": "そうなんですね。"
  },
  {
   "index": 150,
   "startMs": 1022880,
   "endMs": 1023810,
   "text": "。"
  },
  {
   "index": 151,
   "startMs": 1026050,
   "endMs": 1032740,
   "text": "店長は花を届けるサービスのどんな点が最も客に喜ばれていると言っていますか。"
  },
  {
   "index": 152,
   "startMs": 1045310,
   "endMs": 1046480,
   "text": "五番。"
  },
  {
   "index": 153,
   "startMs": 1046940,
   "endMs": 1052250,
   "text": "高校サッカーの大会でアナウンサーが監督にインタビューして、います。"
  },
  {
   "index": 154,
   "startMs": 1052580,
   "endMs": 1056750,
   "text": "監督はどうして今日の試合に勝てたと言っていますか。"
  },
  {
   "index": 155,
   "startMs": 1079940,
   "endMs": 1085430,
   "text": "監督、おめでとうございます、今日の試合、いかがでしたでしょうか。"
  },
  {
   "index": 156,
   "startMs": 1085580,
   "endMs": 1088250,
   "text": "選手がよくやってくれました。"
  },
  {
   "index": 157,
   "startMs": 1088340,
   "endMs": 1097670,
   "text": "去年の優勝候補が相手だったので覚悟はしていたんですが、前半先制されて、なかなか普段の練習通りにはプレーできませんでした。"
  },
  {
   "index": 158,
   "startMs": 1097850,
   "endMs": 1105680,
   "text": "でも、勢いの中、攻撃の手を緩めず最後まで粘り強く戦ったことが勝利につながったと思います。"
  },
  {
   "index": 159,
   "startMs": 1105880,
   "endMs": 1113170,
   "text": "このような試合を戦い抜くことで、戦士の技術面も精神面も成長してくれることを願っています。"
  },
  {
   "index": 160,
   "startMs": 1113320,
   "endMs": 1118990,
   "text": "作戦面では選手交代のタイミングなど、改善すべき点はあると思っています。"
  },
  {
   "index": 161,
   "startMs": 1120510,
   "endMs": 1121320,
   "text": "。"
  },
  {
   "index": 162,
   "startMs": 1123700,
   "endMs": 1127870,
   "text": "監督はどうして今日の試合に勝てたと言っていますか。"
  },
  {
   "index": 163,
   "startMs": 1137190,
   "endMs": 1137880,
   "text": "あ。"
  },
  {
   "index": 164,
   "startMs": 1140360,
   "endMs": 1141590,
   "text": "6番。"
  },
  {
   "index": 165,
   "startMs": 1141900,
   "endMs": 1148770,
   "text": "市役所で女の上司と男の職員が市民向けのセミナーについて話しています。"
  },
  {
   "index": 166,
   "startMs": 1149120,
   "endMs": 1155210,
   "text": "二人は次のセミナーの企画として、会議でどんな提案をすることにしましたか。"
  },
  {
   "index": 167,
   "startMs": 1178360,
   "endMs": 1185410,
   "text": "伊藤さん、起業したい人向けのセミナーですが、今年の企画を来週の会議にかけたいんです。"
  },
  {
   "index": 168,
   "startMs": 1185490,
   "endMs": 1190560,
   "text": "去年の参加者アンケートを踏まえて案を考えておいてくれましたか。"
  },
  {
   "index": 169,
   "startMs": 1190670,
   "endMs": 1200300,
   "text": "はい、去年は有名起業家を講師に招きましたがアンケートでは具体的なノウハウをもっと知りたかったってコメントが結構ありました。"
  },
  {
   "index": 170,
   "startMs": 1200580,
   "endMs": 1206670,
   "text": "金融機関の人に資本金や融資などの資金調達について講演してもらうのはどうです。"
  },
  {
   "index": 171,
   "startMs": 1206670,
   "endMs": 1208470,
   "text": "かそうですね。"
  },
  {
   "index": 172,
   "startMs": 1208910,
   "endMs": 1216020,
   "text": "他には弁護士の先生に会社設立のための法律手続きの話を頼むのもいいかと。"
  },
  {
   "index": 173,
   "startMs": 1216110,
   "endMs": 1224299,
   "text": "あ、あと、企業経験者を呼んで業種別のグループで話す機会を設けてほしいなんていう意見もありました。"
  },
  {
   "index": 174,
   "startMs": 1224420,
   "endMs": 1230630,
   "text": "うん、座談会は会場の見直しが必要ですから、別の機会にしましょう。"
  },
  {
   "index": 175,
   "startMs": 1230770,
   "endMs": 1240220,
   "text": "両方の分野の人に講演をお願いしたいところですが、予算がね、アンケートではどちらに対するコメントが多かったですか？"
  },
  {
   "index": 176,
   "startMs": 1240310,
   "endMs": 1250720,
   "text": "そうで、すね、会社を立ち上げる際の法律手続きに自信がないというコメントもありましたが、資金調達に関するものの方が目につきました。"
  },
  {
   "index": 177,
   "startMs": 1250800,
   "endMs": 1255990,
   "text": "では、その方面の専門家を呼ぶことを次の企画として図りましょう。"
  },
  {
   "index": 178,
   "startMs": 1257390,
   "endMs": 1258320,
   "text": "う。"
  },
  {
   "index": 179,
   "startMs": 1260520,
   "endMs": 1266610,
   "text": "二人は次のセミナーの企画として、会議でどんな提案をすることにしましたか。"
  },
  {
   "index": 180,
   "startMs": 1280250,
   "endMs": 1283040,
   "text": "ここでちょっと休みましょう。"
  },
  {
   "index": 181,
   "startMs": 1302060,
   "endMs": 1302810,
   "text": "うん。"
  },
  {
   "index": 182,
   "startMs": 1315490,
   "endMs": 1318100,
   "text": "では、また続けます。"
  },
  {
   "index": 183,
   "startMs": 1323700,
   "endMs": 1325530,
   "text": "問題三。"
  },
  {
   "index": 184,
   "startMs": 1325860,
   "endMs": 1331050,
   "text": "問題三では、問題用紙に何も印刷されていません。"
  },
  {
   "index": 185,
   "startMs": 1331720,
   "endMs": 1336790,
   "text": "この問題は全体としてどんな内容かを聞く問題です。"
  },
  {
   "index": 186,
   "startMs": 1337720,
   "endMs": 1340570,
   "text": "話の前に質問はありません。"
  },
  {
   "index": 187,
   "startMs": 1341470,
   "endMs": 1343960,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 188,
   "startMs": 1344700,
   "endMs": 1348210,
   "text": "それから質問と選択肢を聞いて。"
  },
  {
   "index": 189,
   "startMs": 1348430,
   "endMs": 1354580,
   "text": "一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 190,
   "startMs": 1356850,
   "endMs": 1358920,
   "text": "では、始めます。"
  },
  {
   "index": 191,
   "startMs": 1364320,
   "endMs": 1365490,
   "text": "一番。"
  },
  {
   "index": 192,
   "startMs": 1365870,
   "endMs": 1371840,
   "text": "親子向けのクラシックコンサートの会場で、オーケストラの指揮者が話して、います。"
  },
  {
   "index": 193,
   "startMs": 1373280,
   "endMs": 1376190,
   "text": "緑オケサラの指揮者の山田です。"
  },
  {
   "index": 194,
   "startMs": 1376420,
   "endMs": 1382210,
   "text": "オーケストラにはいろいろな楽器がありますが、指揮者は指棒一本だけです。"
  },
  {
   "index": 195,
   "startMs": 1382550,
   "endMs": 1388160,
   "text": "リズムを取るぐらいで簡単そうに見えるかもしれませんが、そんなことはありません。"
  },
  {
   "index": 196,
   "startMs": 1388400,
   "endMs": 1394370,
   "text": "というのは、曲に対して持つイメージって人によってバラバラなんですよね。"
  },
  {
   "index": 197,
   "startMs": 1394480,
   "endMs": 1403150,
   "text": "同じ曲の楽譜を見ても、山場がどこにあるかとか、この部分は何を表しているのかなどの解釈が違います。"
  },
  {
   "index": 198,
   "startMs": 1403270,
   "endMs": 1409660,
   "text": "指揮者は自分なりの解釈をオーケストラの団員に伝えて、演奏をまとめ上げるんです。"
  },
  {
   "index": 199,
   "startMs": 1409990,
   "endMs": 1419140,
   "text": "それだけでなく、隊員との信頼関係を築き、演奏者が持つ表現力を最大限に引き出すことも求められるんです。"
  },
  {
   "index": 200,
   "startMs": 1420550,
   "endMs": 1421480,
   "text": "う。"
  },
  {
   "index": 201,
   "startMs": 1423850,
   "endMs": 1426820,
   "text": "指揮者は何について話していますか。"
  },
  {
   "index": 202,
   "startMs": 1428090,
   "endMs": 1429260,
   "text": "一？"
  },
  {
   "index": 203,
   "startMs": 1429590,
   "endMs": 1432320,
   "text": "楽器による演奏法の違い。"
  },
  {
   "index": 204,
   "startMs": 1433680,
   "endMs": 1434790,
   "text": "二？"
  },
  {
   "index": 205,
   "startMs": 1435100,
   "endMs": 1437530,
   "text": "演奏会の楽しみ方。"
  },
  {
   "index": 206,
   "startMs": 1438820,
   "endMs": 1440110,
   "text": "3。"
  },
  {
   "index": 207,
   "startMs": 1440380,
   "endMs": 1443950,
   "text": "団員の能力を信じることの大切さ。"
  },
  {
   "index": 208,
   "startMs": 1445290,
   "endMs": 1446400,
   "text": "四。"
  },
  {
   "index": 209,
   "startMs": 1446660,
   "endMs": 1448550,
   "text": "指揮者の役割。"
  },
  {
   "index": 210,
   "startMs": 1461210,
   "endMs": 1462380,
   "text": "二番？"
  },
  {
   "index": 211,
   "startMs": 1462780,
   "endMs": 1468930,
   "text": "テレビでアナウンサーの男の人は商店街の代表の人にインタビューしています。"
  },
  {
   "index": 212,
   "startMs": 1470410,
   "endMs": 1478780,
   "text": "地方の商店街が衰退していく傾向がある中で、この桜通り商店街はたくさんのお客様で賑わっていますね。"
  },
  {
   "index": 213,
   "startMs": 1478950,
   "endMs": 1480060,
   "text": "ありがとうござ。"
  },
  {
   "index": 214,
   "startMs": 1480060,
   "endMs": 1480720,
   "text": "います。"
  },
  {
   "index": 215,
   "startMs": 1480830,
   "endMs": 1486020,
   "text": "一時はお客様が減って、商店街全体が寂しい時期もありました。"
  },
  {
   "index": 216,
   "startMs": 1486150,
   "endMs": 1492240,
   "text": "それで三年ほど前から若い店主たちを中心にお客様に喜んでもらえるよ。"
  },
  {
   "index": 217,
   "startMs": 1492240,
   "endMs": 1495540,
   "text": "うな商店街全体のイベントを企画しているんです。"
  },
  {
   "index": 218,
   "startMs": 1495670,
   "endMs": 1499120,
   "text": "そうなんですかどんなイベントをやっていらっしゃる？"
  },
  {
   "index": 219,
   "startMs": 1499120,
   "endMs": 1499840,
   "text": "んですか。"
  },
  {
   "index": 220,
   "startMs": 1499970,
   "endMs": 1506000,
   "text": "例えば、学生デを設けて、その日は全店舗で学生割引を行ったり。"
  },
  {
   "index": 221,
   "startMs": 1506090,
   "endMs": 1509840,
   "text": "七夕など季節ごとにイベントを開催したりして、います。"
  },
  {
   "index": 222,
   "startMs": 1509980,
   "endMs": 1511810,
   "text": "そうですか？"
  },
  {
   "index": 223,
   "startMs": 1511900,
   "endMs": 1520390,
   "text": "他にも飲食店で写真を撮りたくなるような盛り付けを工夫したメニューを開発し、それをインターネットで発信したりしています。"
  },
  {
   "index": 224,
   "startMs": 1520500,
   "endMs": 1527010,
   "text": "おかげさまで近隣の方だけでなく、ネットの記事を見た遠方の方も来てくださっています。"
  },
  {
   "index": 225,
   "startMs": 1528510,
   "endMs": 1529440,
   "text": "。"
  },
  {
   "index": 226,
   "startMs": 1531680,
   "endMs": 1536150,
   "text": "商店街の代表の人は何について話していますか？"
  },
  {
   "index": 227,
   "startMs": 1537450,
   "endMs": 1538620,
   "text": "1。"
  },
  {
   "index": 228,
   "startMs": 1539040,
   "endMs": 1541770,
   "text": "商店街の店の入れ替わり。"
  },
  {
   "index": 229,
   "startMs": 1544090,
   "endMs": 1545140,
   "text": "二？"
  },
  {
   "index": 230,
   "startMs": 1545490,
   "endMs": 1548400,
   "text": "商店街の活性化の取り組み。"
  },
  {
   "index": 231,
   "startMs": 1550700,
   "endMs": 1551810,
   "text": "三？"
  },
  {
   "index": 232,
   "startMs": 1552180,
   "endMs": 1555450,
   "text": "商店街で新たに取り組むべき課題。"
  },
  {
   "index": 233,
   "startMs": 1557830,
   "endMs": 1558880,
   "text": "四。"
  },
  {
   "index": 234,
   "startMs": 1559250,
   "endMs": 1562520,
   "text": "商店街で一番人気があるイベント。"
  },
  {
   "index": 235,
   "startMs": 1571900,
   "endMs": 1572650,
   "text": "あ。"
  },
  {
   "index": 236,
   "startMs": 1574990,
   "endMs": 1576340,
   "text": "三番。"
  },
  {
   "index": 237,
   "startMs": 1576650,
   "endMs": 1581840,
   "text": "テレビの動物番組で専門家がゴリラについて話しています。"
  },
  {
   "index": 238,
   "startMs": 1583130,
   "endMs": 1586400,
   "text": "私はゴリラの生態を研究しています。"
  },
  {
   "index": 239,
   "startMs": 1586510,
   "endMs": 1593320,
   "text": "私の研究は、ジャングルで野生のゴリラの群れを追いかけ、観察することから始まります。"
  },
  {
   "index": 240,
   "startMs": 1593570,
   "endMs": 1601160,
   "text": "ただ、警戒しているゴリラに近づいて殴られたりすると危険ですから、少しずつ距離を縮めるんです。"
  },
  {
   "index": 241,
   "startMs": 1601470,
   "endMs": 1613500,
   "text": "ゴリラは他の動物を見ると相手をしようと近づきますが、相手が怖がって下を向いたり目をそらしたりすると相手を敵だと認識して威嚇してきます。"
  },
  {
   "index": 242,
   "startMs": 1613730,
   "endMs": 1617300,
   "text": "なので、我々も怯まずに目を合わせます。"
  },
  {
   "index": 243,
   "startMs": 1617450,
   "endMs": 1629540,
   "text": "そして、ゴリラの好為を真似してゴロっと横になったり、食べたりしているうちに、ゴリラは我々には適意がないと認識してくれ、近づくことを許すようになります。"
  },
  {
   "index": 244,
   "startMs": 1631040,
   "endMs": 1631850,
   "text": "。"
  },
  {
   "index": 245,
   "startMs": 1634260,
   "endMs": 1637530,
   "text": "専門家は何について話していますか？"
  },
  {
   "index": 246,
   "startMs": 1638890,
   "endMs": 1640060,
   "text": "一？"
  },
  {
   "index": 247,
   "startMs": 1640430,
   "endMs": 1643460,
   "text": "ゴリラが敵を攻撃する方法。"
  },
  {
   "index": 248,
   "startMs": 1645870,
   "endMs": 1646980,
   "text": "二？"
  },
  {
   "index": 249,
   "startMs": 1647210,
   "endMs": 1649580,
   "text": "ゴリラの記憶力の良さ。"
  },
  {
   "index": 250,
   "startMs": 1651990,
   "endMs": 1653160,
   "text": "3。"
  },
  {
   "index": 251,
   "startMs": 1653510,
   "endMs": 1656780,
   "text": "ゴリラと信頼関係を築く方法。"
  },
  {
   "index": 252,
   "startMs": 1659160,
   "endMs": 1660210,
   "text": "四？"
  },
  {
   "index": 253,
   "startMs": 1660530,
   "endMs": 1663380,
   "text": "ゴリラの研究を始めた理由。"
  },
  {
   "index": 254,
   "startMs": 1675850,
   "endMs": 1677140,
   "text": "四番。"
  },
  {
   "index": 255,
   "startMs": 1677570,
   "endMs": 1681260,
   "text": "ラジオである島の医師が話しています。"
  },
  {
   "index": 256,
   "startMs": 1682640,
   "endMs": 1690530,
   "text": "私は都会の大学病院で十年勤務し、三年前に小さな島の診療所に赴任しました。"
  },
  {
   "index": 257,
   "startMs": 1690710,
   "endMs": 1699140,
   "text": "ここでは様々な病気や怪我に対応する必要があり、医師としての総合的な技術が高められると感じて、います。"
  },
  {
   "index": 258,
   "startMs": 1699260,
   "endMs": 1705230,
   "text": "島は患者さんとの距離が近く、診療所以外でも患者さんによく会います。"
  },
  {
   "index": 259,
   "startMs": 1705600,
   "endMs": 1714750,
   "text": "薬や治療の効果について直接聞けたり、患者さんと一緒に病気に向き合っているという実感があって手応えが感じられます。"
  },
  {
   "index": 260,
   "startMs": 1715010,
   "endMs": 1725000,
   "text": "また、生活習慣について島の人たちに積極的にアドバイスして、地域の予防医療に貢献できることにも魅力を感じています。"
  },
  {
   "index": 261,
   "startMs": 1726540,
   "endMs": 1727290,
   "text": "え？"
  },
  {
   "index": 262,
   "startMs": 1729710,
   "endMs": 1733640,
   "text": "この島の石は何について話していますか？"
  },
  {
   "index": 263,
   "startMs": 1735010,
   "endMs": 1736180,
   "text": "1。"
  },
  {
   "index": 264,
   "startMs": 1736500,
   "endMs": 1739290,
   "text": "この島の石になったきっかけ。"
  },
  {
   "index": 265,
   "startMs": 1741720,
   "endMs": 1742770,
   "text": "二？"
  },
  {
   "index": 266,
   "startMs": 1742990,
   "endMs": 1745540,
   "text": "この島の意志としてのやりがい。"
  },
  {
   "index": 267,
   "startMs": 1747920,
   "endMs": 1749090,
   "text": "3。"
  },
  {
   "index": 268,
   "startMs": 1749400,
   "endMs": 1752190,
   "text": "この島の医療の困難な点。"
  },
  {
   "index": 269,
   "startMs": 1754640,
   "endMs": 1755690,
   "text": "四。"
  },
  {
   "index": 270,
   "startMs": 1755980,
   "endMs": 1760030,
   "text": "この島の生活習慣と病気の関係。"
  },
  {
   "index": 271,
   "startMs": 1772440,
   "endMs": 1773610,
   "text": "5番。"
  },
  {
   "index": 272,
   "startMs": 1773880,
   "endMs": 1778650,
   "text": "市民口座で発酵食品について講師が話しています。"
  },
  {
   "index": 273,
   "startMs": 1779990,
   "endMs": 1784940,
   "text": "皆さん、ヨーグルトやチーズなどの発酵食品は好きですか？"
  },
  {
   "index": 274,
   "startMs": 1785060,
   "endMs": 1798290,
   "text": "発酵食品はいろいろな実験を通して健康効果が実証されて、いますが加熱すると有益な菌の働きが損なわれるので、できるだけそのまま食べることをお勧めします。"
  },
  {
   "index": 275,
   "startMs": 1798560,
   "endMs": 1803210,
   "text": "毎日継続して摂取すると、より効果が期待できます。"
  },
  {
   "index": 276,
   "startMs": 1803410,
   "endMs": 1808120,
   "text": "それから、食べ物の組み合わせにも注意を払いたいですね。"
  },
  {
   "index": 277,
   "startMs": 1808300,
   "endMs": 1816010,
   "text": "バナナやごぼのように食物繊維が含まれているものと一緒にとると、菌の活動が活発になるんです。"
  },
  {
   "index": 278,
   "startMs": 1817510,
   "endMs": 1818380,
   "text": "う？"
  },
  {
   "index": 279,
   "startMs": 1820670,
   "endMs": 1823820,
   "text": "講師は何について話していますか？"
  },
  {
   "index": 280,
   "startMs": 1825110,
   "endMs": 1826220,
   "text": "一？"
  },
  {
   "index": 281,
   "startMs": 1826640,
   "endMs": 1829550,
   "text": "発酵食品に含まれる成分。"
  },
  {
   "index": 282,
   "startMs": 1832040,
   "endMs": 1833030,
   "text": "二？"
  },
  {
   "index": 283,
   "startMs": 1833340,
   "endMs": 1836130,
   "text": "発酵食品を使った料理。"
  },
  {
   "index": 284,
   "startMs": 1838450,
   "endMs": 1839620,
   "text": "3。"
  },
  {
   "index": 285,
   "startMs": 1840060,
   "endMs": 1842970,
   "text": "発酵食品が好まれる理由。"
  },
  {
   "index": 286,
   "startMs": 1845330,
   "endMs": 1846380,
   "text": "4。"
  },
  {
   "index": 287,
   "startMs": 1846750,
   "endMs": 1850080,
   "text": "発酵食品の効果的な食べ方。"
  },
  {
   "index": 288,
   "startMs": 1861610,
   "endMs": 1863440,
   "text": "問題4。"
  },
  {
   "index": 289,
   "startMs": 1863700,
   "endMs": 1868770,
   "text": "問題四では、問題用紙に何も印刷されていません。"
  },
  {
   "index": 290,
   "startMs": 1869240,
   "endMs": 1871970,
   "text": "まず文を聞いてください。"
  },
  {
   "index": 291,
   "startMs": 1872360,
   "endMs": 1876050,
   "text": "それからそれに対する返事を聞いて。"
  },
  {
   "index": 292,
   "startMs": 1876160,
   "endMs": 1882010,
   "text": "一から三の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 293,
   "startMs": 1884400,
   "endMs": 1886650,
   "text": "では、始めます。"
  },
  {
   "index": 294,
   "startMs": 1892280,
   "endMs": 1893510,
   "text": "一番。"
  },
  {
   "index": 295,
   "startMs": 1893840,
   "endMs": 1899090,
   "text": "先輩、テニスの全国大会、きっと優勝してみせます。"
  },
  {
   "index": 296,
   "startMs": 1900480,
   "endMs": 1901650,
   "text": "1。"
  },
  {
   "index": 297,
   "startMs": 1902080,
   "endMs": 1904210,
   "text": "全力を出してくるよ。"
  },
  {
   "index": 298,
   "startMs": 1905460,
   "endMs": 1906510,
   "text": "二？"
  },
  {
   "index": 299,
   "startMs": 1906890,
   "endMs": 1909440,
   "text": "諦めるのは早いんじゃない？"
  },
  {
   "index": 300,
   "startMs": 1910780,
   "endMs": 1911950,
   "text": "三？"
  },
  {
   "index": 301,
   "startMs": 1912450,
   "endMs": 1914940,
   "text": "うん、期待してるからね。"
  },
  {
   "index": 302,
   "startMs": 1927530,
   "endMs": 1928700,
   "text": "二番。"
  },
  {
   "index": 303,
   "startMs": 1929080,
   "endMs": 1935530,
   "text": "ねえ、歌手の森な明日のコンサートを最後に引退だって知ってた？"
  },
  {
   "index": 304,
   "startMs": 1936850,
   "endMs": 1938020,
   "text": "一？"
  },
  {
   "index": 305,
   "startMs": 1938510,
   "endMs": 1942380,
   "text": "え、明日で引退するのどうして。"
  },
  {
   "index": 306,
   "startMs": 1943800,
   "endMs": 1944850,
   "text": "二？"
  },
  {
   "index": 307,
   "startMs": 1945150,
   "endMs": 1946320,
   "text": "え？"
  },
  {
   "index": 308,
   "startMs": 1946320,
   "endMs": 1948660,
   "text": "コンサートだけは続けるんだ。"
  },
  {
   "index": 309,
   "startMs": 1949990,
   "endMs": 1951160,
   "text": "3。"
  },
  {
   "index": 310,
   "startMs": 1951440,
   "endMs": 1955310,
   "text": "え、明日のコンサート中止になったの？"
  },
  {
   "index": 311,
   "startMs": 1964740,
   "endMs": 1965490,
   "text": "あ。"
  },
  {
   "index": 312,
   "startMs": 1967860,
   "endMs": 1969210,
   "text": "三番。"
  },
  {
   "index": 313,
   "startMs": 1969620,
   "endMs": 1973910,
   "text": "ゼミでやった実験、データを整理するのに手こずったね。"
  },
  {
   "index": 314,
   "startMs": 1975440,
   "endMs": 1976610,
   "text": "1。"
  },
  {
   "index": 315,
   "startMs": 1976940,
   "endMs": 1979610,
   "text": "確かにスムーズに行ったよね。"
  },
  {
   "index": 316,
   "startMs": 1981080,
   "endMs": 1982130,
   "text": "2。"
  },
  {
   "index": 317,
   "startMs": 1982400,
   "endMs": 1986090,
   "text": "ああ、もっと大変だと思っていたんだね。"
  },
  {
   "index": 318,
   "startMs": 1987480,
   "endMs": 1988650,
   "text": "三。"
  },
  {
   "index": 319,
   "startMs": 1988970,
   "endMs": 1992420,
   "text": "ほ当途中で嫌になっちゃったよ。"
  },
  {
   "index": 320,
   "startMs": 2005140,
   "endMs": 2006370,
   "text": "4番。"
  },
  {
   "index": 321,
   "startMs": 2006730,
   "endMs": 2011500,
   "text": "美容師さんに言われるままにパーマかけちゃったけど、どうかな。"
  },
  {
   "index": 322,
   "startMs": 2012950,
   "endMs": 2014180,
   "text": "一。"
  },
  {
   "index": 323,
   "startMs": 2014490,
   "endMs": 2018420,
   "text": "美容師さんにアドバイスもらわなかったんだ。"
  },
  {
   "index": 324,
   "startMs": 2019760,
   "endMs": 2020870,
   "text": "二？"
  },
  {
   "index": 325,
   "startMs": 2021250,
   "endMs": 2024460,
   "text": "美容師さんの言う通りにして正解だよ。"
  },
  {
   "index": 326,
   "startMs": 2025780,
   "endMs": 2026890,
   "text": "三？"
  },
  {
   "index": 327,
   "startMs": 2027330,
   "endMs": 2031020,
   "text": "美容師さんの勧めるスタイルにすればよかったかもね。"
  },
  {
   "index": 328,
   "startMs": 2043560,
   "endMs": 2044610,
   "text": "5番。"
  },
  {
   "index": 329,
   "startMs": 2044970,
   "endMs": 2050160,
   "text": "研究会の発表の事前練習、明日なら見てあげられなくもないよ。"
  },
  {
   "index": 330,
   "startMs": 2051590,
   "endMs": 2052760,
   "text": "一？"
  },
  {
   "index": 331,
   "startMs": 2053140,
   "endMs": 2055990,
   "text": "どうしても明日は難しいですか。"
  },
  {
   "index": 332,
   "startMs": 2057440,
   "endMs": 2058430,
   "text": "二？"
  },
  {
   "index": 333,
   "startMs": 2058700,
   "endMs": 2062210,
   "text": "すみませんでは明日お願いします。"
  },
  {
   "index": 334,
   "startMs": 2063680,
   "endMs": 2064850,
   "text": "3。"
  },
  {
   "index": 335,
   "startMs": 2065170,
   "endMs": 2067960,
   "text": "じゃあ今日の方がいいんで、すね。"
  },
  {
   "index": 336,
   "startMs": 2080540,
   "endMs": 2081770,
   "text": "六番。"
  },
  {
   "index": 337,
   "startMs": 2082280,
   "endMs": 2089270,
   "text": "ねえ、私たち午後から出張だけど、新幹線今運転を見合わせてるって。"
  },
  {
   "index": 338,
   "startMs": 2090700,
   "endMs": 2091930,
   "text": "1。"
  },
  {
   "index": 339,
   "startMs": 2092320,
   "endMs": 2093190,
   "text": "え？"
  },
  {
   "index": 340,
   "startMs": 2093190,
   "endMs": 2095890,
   "text": "いつ頃運転を再開するんだろう。"
  },
  {
   "index": 341,
   "startMs": 2097310,
   "endMs": 2098420,
   "text": "二？"
  },
  {
   "index": 342,
   "startMs": 2098850,
   "endMs": 2102300,
   "text": "あ、新幹線動いたんだよかった。"
  },
  {
   "index": 343,
   "startMs": 2103650,
   "endMs": 2104760,
   "text": "三？"
  },
  {
   "index": 344,
   "startMs": 2105180,
   "endMs": 2108450,
   "text": "じゃあ、予定を変更しなくて良さそうだね。"
  },
  {
   "index": 345,
   "startMs": 2120980,
   "endMs": 2122150,
   "text": "7番。"
  },
  {
   "index": 346,
   "startMs": 2122490,
   "endMs": 2129660,
   "text": "あの、このカウンターで三千円以上のレシートの引き換えにお皿がもらえるって聞いたんですが。"
  },
  {
   "index": 347,
   "startMs": 2131140,
   "endMs": 2132250,
   "text": "1。"
  },
  {
   "index": 348,
   "startMs": 2132630,
   "endMs": 2136260,
   "text": "あ、商品のお取り換えをご希望ですね。"
  },
  {
   "index": 349,
   "startMs": 2137640,
   "endMs": 2138750,
   "text": "二？"
  },
  {
   "index": 350,
   "startMs": 2138980,
   "endMs": 2142130,
   "text": "三千円のご予算でお求めでしょうか。"
  },
  {
   "index": 351,
   "startMs": 2143620,
   "endMs": 2144790,
   "text": "三？"
  },
  {
   "index": 352,
   "startMs": 2145110,
   "endMs": 2148620,
   "text": "あ、はい、レシートをお預かりします。"
  },
  {
   "index": 353,
   "startMs": 2161190,
   "endMs": 2162420,
   "text": "8番。"
  },
  {
   "index": 354,
   "startMs": 2162750,
   "endMs": 2169920,
   "text": "ゼミの食事会、いつもの店に電話したんだけど、キャンセルが出ない限り、席確保できないって。"
  },
  {
   "index": 355,
   "startMs": 2171290,
   "endMs": 2172460,
   "text": "1。"
  },
  {
   "index": 356,
   "startMs": 2172790,
   "endMs": 2175580,
   "text": "あ、キャンセルできないんだね。"
  },
  {
   "index": 357,
   "startMs": 2176940,
   "endMs": 2177990,
   "text": "2？"
  },
  {
   "index": 358,
   "startMs": 2178300,
   "endMs": 2181510,
   "text": "じゃあなんとか予約取れそうだね。"
  },
  {
   "index": 359,
   "startMs": 2182890,
   "endMs": 2184060,
   "text": "3。"
  },
  {
   "index": 360,
   "startMs": 2184430,
   "endMs": 2187820,
   "text": "じゃあ、他の店探すしかないね。"
  },
  {
   "index": 361,
   "startMs": 2200340,
   "endMs": 2201510,
   "text": "9番。"
  },
  {
   "index": 362,
   "startMs": 2201920,
   "endMs": 2208490,
   "text": "山本課長って先月この視点に移動してきたと思ったら海外に転勤だって。"
  },
  {
   "index": 363,
   "startMs": 2209900,
   "endMs": 2211070,
   "text": "一？"
  },
  {
   "index": 364,
   "startMs": 2211390,
   "endMs": 2214480,
   "text": "この間来たばっかりなのにまた移動？"
  },
  {
   "index": 365,
   "startMs": 2215890,
   "endMs": 2217000,
   "text": "二？"
  },
  {
   "index": 366,
   "startMs": 2217360,
   "endMs": 2218410,
   "text": "え？"
  },
  {
   "index": 367,
   "startMs": 2218410,
   "endMs": 2221890,
   "text": "この視点に来るはずが海外転勤になったの？"
  },
  {
   "index": 368,
   "startMs": 2223340,
   "endMs": 2224510,
   "text": "三？"
  },
  {
   "index": 369,
   "startMs": 2224980,
   "endMs": 2228370,
   "text": "課長長いことをこの視点にいたもんね。"
  },
  {
   "index": 370,
   "startMs": 2241010,
   "endMs": 2242180,
   "text": "10番。"
  },
  {
   "index": 371,
   "startMs": 2242590,
   "endMs": 2247660,
   "text": "卒業論文の提出まで、あと10日で切羽詰待ってきたよ。"
  },
  {
   "index": 372,
   "startMs": 2249040,
   "endMs": 2250150,
   "text": "一？"
  },
  {
   "index": 373,
   "startMs": 2250470,
   "endMs": 2253140,
   "text": "余裕があるんだね。"
  },
  {
   "index": 374,
   "startMs": 2254520,
   "endMs": 2255570,
   "text": "二？"
  },
  {
   "index": 375,
   "startMs": 2255880,
   "endMs": 2258250,
   "text": "あと少しだから頑張って。"
  },
  {
   "index": 376,
   "startMs": 2259610,
   "endMs": 2260780,
   "text": "三？"
  },
  {
   "index": 377,
   "startMs": 2261100,
   "endMs": 2264130,
   "text": "すごいもう書き終わったんだ。"
  },
  {
   "index": 378,
   "startMs": 2273440,
   "endMs": 2274250,
   "text": "あ。"
  },
  {
   "index": 379,
   "startMs": 2276640,
   "endMs": 2278110,
   "text": "十一番。"
  },
  {
   "index": 380,
   "startMs": 2278540,
   "endMs": 2284090,
   "text": "緑車との共同研究、修止を余儀なくされたって課長が言ってたよ。"
  },
  {
   "index": 381,
   "startMs": 2285590,
   "endMs": 2286640,
   "text": "一？"
  },
  {
   "index": 382,
   "startMs": 2287030,
   "endMs": 2290000,
   "text": "今になって中止にはできないもんね。"
  },
  {
   "index": 383,
   "startMs": 2291400,
   "endMs": 2292390,
   "text": "二？"
  },
  {
   "index": 384,
   "startMs": 2292780,
   "endMs": 2295450,
   "text": "え、一体何があったの？"
  },
  {
   "index": 385,
   "startMs": 2296810,
   "endMs": 2297980,
   "text": "3。"
  },
  {
   "index": 386,
   "startMs": 2298390,
   "endMs": 2301600,
   "text": "ああ、続けられることになったんだね。"
  },
  {
   "index": 387,
   "startMs": 2316250,
   "endMs": 2318080,
   "text": "問題5。"
  },
  {
   "index": 388,
   "startMs": 2318190,
   "endMs": 2322000,
   "text": "問題五では、長めの話を聞きます。"
  },
  {
   "index": 389,
   "startMs": 2322790,
   "endMs": 2326300,
   "text": "問題用紙にメモを取っても構いません。"
  },
  {
   "index": 390,
   "startMs": 2328090,
   "endMs": 2329380,
   "text": "一番。"
  },
  {
   "index": 391,
   "startMs": 2329810,
   "endMs": 2333560,
   "text": "問題用紙に何も印刷されていません。"
  },
  {
   "index": 392,
   "startMs": 2334080,
   "endMs": 2336870,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 393,
   "startMs": 2337440,
   "endMs": 2341010,
   "text": "それから質問と選択肢を聞いて。"
  },
  {
   "index": 394,
   "startMs": 2341140,
   "endMs": 2347470,
   "text": "一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 395,
   "startMs": 2349760,
   "endMs": 2352070,
   "text": "では、始めます。"
  },
  {
   "index": 396,
   "startMs": 2354880,
   "endMs": 2355630,
   "text": "あ。"
  },
  {
   "index": 397,
   "startMs": 2358050,
   "endMs": 2359280,
   "text": "一番？"
  },
  {
   "index": 398,
   "startMs": 2359610,
   "endMs": 2362760,
   "text": "問題用紙に何も印刷されていません。"
  },
  {
   "index": 399,
   "startMs": 2362840,
   "endMs": 2365150,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 400,
   "startMs": 2365290,
   "endMs": 2373660,
   "text": "それから、質問と選択肢を聞いて一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 401,
   "startMs": 2375290,
   "endMs": 2379040,
   "text": "書店で店長と店員二人が話して、います。"
  },
  {
   "index": 402,
   "startMs": 2380570,
   "endMs": 2384620,
   "text": "最近お客様が減って売上げが落ちてるんだよね。"
  },
  {
   "index": 403,
   "startMs": 2384820,
   "endMs": 2391630,
   "text": "駅の近くに新しい書店もできたし、何か売上を回復するいい案はないかな。"
  },
  {
   "index": 404,
   "startMs": 2391760,
   "endMs": 2403490,
   "text": "今、全国の売上ランキングで上位に入ってる本を入り口近くに置いてますけど、もっとお客様の目に泊まりやすいようにレジに近いところに置くのはどうですか？"
  },
  {
   "index": 405,
   "startMs": 2403610,
   "endMs": 2411620,
   "text": "うちは近くにデザイン関係の会社が多いからか、以前からデザイン関連の本がよく売れてますよね。"
  },
  {
   "index": 406,
   "startMs": 2411730,
   "endMs": 2418120,
   "text": "それに店員の推薦文を書いたカードをつけて、もっとを目立たせたらどうですか？"
  },
  {
   "index": 407,
   "startMs": 2418240,
   "endMs": 2422410,
   "text": "前にもやったことがあるけど、手間がかかるんだよね。"
  },
  {
   "index": 408,
   "startMs": 2422540,
   "endMs": 2436790,
   "text": "それか雑誌をより充実させるのはどうでしょうか最近は種類も増えているので、雑誌が揃っていればそれを目当てに来てくれる新しいお客さんも増えるかもしれませんそうだね。"
  },
  {
   "index": 409,
   "startMs": 2436920,
   "endMs": 2442950,
   "text": "私は以前からのお客様を引き続きターゲットにした方がいいと思うんです。"
  },
  {
   "index": 410,
   "startMs": 2442950,
   "endMs": 2451470,
   "text": "写真集とか雑誌とか種類にかわらず、デザインに関連する本を一箇所にまとめたコーナーを作るのはどうですか？"
  },
  {
   "index": 411,
   "startMs": 2451590,
   "endMs": 2454560,
   "text": "それはうちの強みになると思うんです。"
  },
  {
   "index": 412,
   "startMs": 2454560,
   "endMs": 2457620,
   "text": "新しいコーナーですか場所はどうする？"
  },
  {
   "index": 413,
   "startMs": 2457620,
   "endMs": 2458460,
   "text": "んですか？"
  },
  {
   "index": 414,
   "startMs": 2458630,
   "endMs": 2459980,
   "text": "うん。"
  },
  {
   "index": 415,
   "startMs": 2459980,
   "endMs": 2466040,
   "text": "じゃあ、ソファーが置いてある閲覧スペースに棚を増やしてそこに集めようか。"
  },
  {
   "index": 416,
   "startMs": 2466040,
   "endMs": 2468920,
   "text": "一箇所にまとめてある方がアピールになるね。"
  },
  {
   "index": 417,
   "startMs": 2469040,
   "endMs": 2473090,
   "text": "推薦分のカードをつけるのは様子を見てからにしよう。"
  },
  {
   "index": 418,
   "startMs": 2474460,
   "endMs": 2475390,
   "text": "う。"
  },
  {
   "index": 419,
   "startMs": 2477640,
   "endMs": 2483010,
   "text": "書店の売上を回復するために、まずどうすることにしましたか。"
  },
  {
   "index": 420,
   "startMs": 2484260,
   "endMs": 2485370,
   "text": "一？"
  },
  {
   "index": 421,
   "startMs": 2485740,
   "endMs": 2488710,
   "text": "売れている本をレジの近くに置く。"
  },
  {
   "index": 422,
   "startMs": 2490210,
   "endMs": 2491260,
   "text": "二？"
  },
  {
   "index": 423,
   "startMs": 2491510,
   "endMs": 2495680,
   "text": "デザイン関連の本に推薦分のカードを付ける。"
  },
  {
   "index": 424,
   "startMs": 2497060,
   "endMs": 2498230,
   "text": "3。"
  },
  {
   "index": 425,
   "startMs": 2498610,
   "endMs": 2501040,
   "text": "雑誌のコーナーを広くする。"
  },
  {
   "index": 426,
   "startMs": 2502460,
   "endMs": 2503570,
   "text": "4。"
  },
  {
   "index": 427,
   "startMs": 2503820,
   "endMs": 2507090,
   "text": "デザイン関連の本のコーナーを作る。"
  },
  {
   "index": 428,
   "startMs": 2520130,
   "endMs": 2521300,
   "text": "二番？"
  },
  {
   "index": 429,
   "startMs": 2521660,
   "endMs": 2524270,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 430,
   "startMs": 2524740,
   "endMs": 2528010,
   "text": "それから二つの質問を聞いて。"
  },
  {
   "index": 431,
   "startMs": 2528120,
   "endMs": 2536250,
   "text": "それぞれ問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 432,
   "startMs": 2538610,
   "endMs": 2540920,
   "text": "では、始めます。"
  },
  {
   "index": 433,
   "startMs": 2543360,
   "endMs": 2549090,
   "text": "最近、一般の人が製品の工場を見学できるところがあります。"
  },
  {
   "index": 434,
   "startMs": 2549220,
   "endMs": 2552610,
   "text": "今日はその中から四つご紹介します。"
  },
  {
   "index": 435,
   "startMs": 2552890,
   "endMs": 2555440,
   "text": "まず東アの工場。"
  },
  {
   "index": 436,
   "startMs": 2555540,
   "endMs": 2567450,
   "text": "こちらでは、カップスープの製造工程を見学した後、カップに好きな具と粉末のスープを組み合わせて入れて、オリジナルのカップスープを作って盛って帰れます。"
  },
  {
   "index": 437,
   "startMs": 2567660,
   "endMs": 2570690,
   "text": "次は西丸牛乳工場です。"
  },
  {
   "index": 438,
   "startMs": 2570870,
   "endMs": 2579480,
   "text": "こちらでは製造管理のため、味覚の専門家が製品の風味を自分の下で確認するシステムを取り入れています。"
  },
  {
   "index": 439,
   "startMs": 2579650,
   "endMs": 2586460,
   "text": "見学の際、味覚の専門家から実際の牛乳の生算方法などについて聞くことができます。"
  },
  {
   "index": 440,
   "startMs": 2586620,
   "endMs": 2589470,
   "text": "南はサッカーボールの工場です。"
  },
  {
   "index": 441,
   "startMs": 2589600,
   "endMs": 2594310,
   "text": "ボール用の皮が次第に立体的になっていく様子に目を見張ります。"
  },
  {
   "index": 442,
   "startMs": 2594580,
   "endMs": 2600790,
   "text": "小さなボールに色付けする作業を体験できて、できたものはお土産に持って帰れます。"
  },
  {
   "index": 443,
   "startMs": 2600980,
   "endMs": 2603590,
   "text": "最後はおもちゃメーカーの北や。"
  },
  {
   "index": 444,
   "startMs": 2603750,
   "endMs": 2608820,
   "text": "この工場では、車や電車のおもちゃを作る家程が見学できます。"
  },
  {
   "index": 445,
   "startMs": 2609030,
   "endMs": 2615300,
   "text": "ここでしか入手できないオリジナル商品が購入可能なのも人気の理由なんだそうですよ。"
  },
  {
   "index": 446,
   "startMs": 2615590,
   "endMs": 2620540,
   "text": "へえ、面白そう、今度子供を連れて行ってみない？"
  },
  {
   "index": 447,
   "startMs": 2620620,
   "endMs": 2622450,
   "text": "うん、いいね。"
  },
  {
   "index": 448,
   "startMs": 2622540,
   "endMs": 2629710,
   "text": "僕は機械化されてる工場でも最終的には人間の下で確認しているっていうのを興味深かったけど。"
  },
  {
   "index": 449,
   "startMs": 2629710,
   "endMs": 2634510,
   "text": "でもまあ子供も一緒だから実際に作れるところの方がいいな。"
  },
  {
   "index": 450,
   "startMs": 2634610,
   "endMs": 2636380,
   "text": "ああ、ボールね。"
  },
  {
   "index": 451,
   "startMs": 2636630,
   "endMs": 2642600,
   "text": "あ、そっちじゃなくて、いつも飲んでる、のとちょっと違う味にできるなんて面白そう。"
  },
  {
   "index": 452,
   "startMs": 2642600,
   "endMs": 2644280,
   "text": "行くならそこがいいな。"
  },
  {
   "index": 453,
   "startMs": 2644410,
   "endMs": 2646480,
   "text": "君はどこがいいと思う？"
  },
  {
   "index": 454,
   "startMs": 2646610,
   "endMs": 2648619,
   "text": "良太が好きな乗り物。"
  },
  {
   "index": 455,
   "startMs": 2648720,
   "endMs": 2653310,
   "text": "うんうん、そこはオリジナル商品をねだられて買う羽目になりそう。"
  },
  {
   "index": 456,
   "startMs": 2653310,
   "endMs": 2657690,
   "text": "お土産をもらえるところならその心配がないからいいよね。"
  },
  {
   "index": 457,
   "startMs": 2657690,
   "endMs": 2659670,
   "text": "家ちに帰ってから遊べるし。"
  },
  {
   "index": 458,
   "startMs": 2659860,
   "endMs": 2663250,
   "text": "うん、じゃあ良太にも聞いてから決めよう。"
  },
  {
   "index": 459,
   "startMs": 2664730,
   "endMs": 2665660,
   "text": "う。"
  },
  {
   "index": 460,
   "startMs": 2668110,
   "endMs": 2669580,
   "text": "質問一？"
  },
  {
   "index": 461,
   "startMs": 2669900,
   "endMs": 2673890,
   "text": "男の人はどの工場に行きたいと言っていますか？"
  },
  {
   "index": 462,
   "startMs": 2675250,
   "endMs": 2676780,
   "text": "質問二。"
  },
  {
   "index": 463,
   "startMs": 2677140,
   "endMs": 2681370,
   "text": "女の人はどの工場に行きたいと言っていますか。"
  },
  {
   "index": 464,
   "startMs": 2683890,
   "endMs": 2684760,
   "text": "う。"
  },
  {
   "index": 465,
   "startMs": 2697670,
   "endMs": 2698480,
   "text": "たん？"
  },
  {
   "index": 466,
   "startMs": 2699840,
   "endMs": 2700590,
   "text": "あ。"
  },
  {
   "index": 467,
   "startMs": 2702030,
   "endMs": 2702900,
   "text": "。"
  },
  {
   "index": 468,
   "startMs": 2719900,
   "endMs": 2720650,
   "text": "あ？"
  },
  {
   "index": 469,
   "startMs": 2725210,
   "endMs": 2726020,
   "text": "。"
  },
  {
   "index": 470,
   "startMs": 2728640,
   "endMs": 2730410,
   "text": "あ。"
  }
 ],
 "audioVerified": false,
 "alternatives": {}
}