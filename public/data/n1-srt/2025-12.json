{
 "examId": "2025-12",
 "primarySrt": "2025年12月日语N1真题听力.srt",
 "segments": [
  {
   "index": 1,
   "startMs": 0,
   "endMs": 690,
   "text": "あ。"
  },
  {
   "index": 2,
   "startMs": 3770,
   "endMs": 6800,
   "text": "これから音を聞いてください。"
  },
  {
   "index": 3,
   "startMs": 7050,
   "endMs": 11100,
   "text": "音がよく聞こえないときは手を挙げてください。"
  },
  {
   "index": 4,
   "startMs": 13390,
   "endMs": 16480,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 5,
   "startMs": 16720,
   "endMs": 19690,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 6,
   "startMs": 19960,
   "endMs": 22870,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 7,
   "startMs": 23150,
   "endMs": 26120,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 8,
   "startMs": 29260,
   "endMs": 30310,
   "text": "。"
  },
  {
   "index": 9,
   "startMs": 33370,
   "endMs": 38380,
   "text": "日本語能力試験聴解エヌ一。"
  },
  {
   "index": 10,
   "startMs": 39180,
   "endMs": 43470,
   "text": "これからエヌ一の聴戒試験を始めます。"
  },
  {
   "index": 11,
   "startMs": 43940,
   "endMs": 47990,
   "text": "問題用紙にメモを取っても構いません。"
  },
  {
   "index": 12,
   "startMs": 48670,
   "endMs": 51400,
   "text": "問題用紙を開けてください。"
  },
  {
   "index": 13,
   "startMs": 52230,
   "endMs": 57060,
   "text": "問題用紙のページがない時きは手を挙げてください。"
  },
  {
   "index": 14,
   "startMs": 58080,
   "endMs": 62670,
   "text": "問題がよく見えない時も手を挙げてください。"
  },
  {
   "index": 15,
   "startMs": 63340,
   "endMs": 65290,
   "text": "いつでもいいです。"
  },
  {
   "index": 16,
   "startMs": 67960,
   "endMs": 68770,
   "text": "あ。"
  },
  {
   "index": 17,
   "startMs": 71840,
   "endMs": 73910,
   "text": "問題1。"
  },
  {
   "index": 18,
   "startMs": 74300,
   "endMs": 78890,
   "text": "問題一では、まず質問を聞いてください。"
  },
  {
   "index": 19,
   "startMs": 79420,
   "endMs": 81790,
   "text": "それから話を聞いて。"
  },
  {
   "index": 20,
   "startMs": 81890,
   "endMs": 89720,
   "text": "問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 21,
   "startMs": 91990,
   "endMs": 94180,
   "text": "では、始めます。"
  },
  {
   "index": 22,
   "startMs": 96780,
   "endMs": 97830,
   "text": "は。"
  },
  {
   "index": 23,
   "startMs": 100300,
   "endMs": 101710,
   "text": "一番。"
  },
  {
   "index": 24,
   "startMs": 101950,
   "endMs": 108760,
   "text": "雑誌を出版している会社で、男の社員とアルバイトの女の人が話しています。"
  },
  {
   "index": 25,
   "startMs": 109320,
   "endMs": 114690,
   "text": "女の人はこの後まず何をしなければなりませんか？"
  },
  {
   "index": 26,
   "startMs": 115760,
   "endMs": 119930,
   "text": "中村さん、取材の動向をお疲れ様でした。"
  },
  {
   "index": 27,
   "startMs": 120030,
   "endMs": 131040,
   "text": "今日取材した寿司屋いい切りになりそうだねはい、あのビルの名前が変わってたのに気づいてなくてすみませんでしたあうん。"
  },
  {
   "index": 28,
   "startMs": 131370,
   "endMs": 133980,
   "text": "取材先のリストを作ったでしょ？"
  },
  {
   "index": 29,
   "startMs": 134070,
   "endMs": 137940,
   "text": "記事を書く前にビル名を直しとかないといけないね。"
  },
  {
   "index": 30,
   "startMs": 137940,
   "endMs": 139020,
   "text": "はい。"
  },
  {
   "index": 31,
   "startMs": 139020,
   "endMs": 145140,
   "text": "今日はこの後、写真の整理と録音した音声の文字化をしなきゃいけないんだ。"
  },
  {
   "index": 32,
   "startMs": 145230,
   "endMs": 147480,
   "text": "写真は私がやるから。"
  },
  {
   "index": 33,
   "startMs": 147600,
   "endMs": 151110,
   "text": "パソコンのソフトで音声ファイルを文字化してくれる。"
  },
  {
   "index": 34,
   "startMs": 151110,
   "endMs": 156750,
   "text": "はい、正しくできてるか、音声と文字化したテキストの称合もしたね。"
  },
  {
   "index": 35,
   "startMs": 156930,
   "endMs": 163320,
   "text": "それと忘れないうちにリストの修正しとかないとそっちを先にね。"
  },
  {
   "index": 36,
   "startMs": 163410,
   "endMs": 170760,
   "text": "あと時間が余ったらもらってきたパンフレットとかの資料を電子ファイルにしてわかりました。"
  },
  {
   "index": 37,
   "startMs": 172040,
   "endMs": 173030,
   "text": "。"
  },
  {
   "index": 38,
   "startMs": 175860,
   "endMs": 181170,
   "text": "女の人はこの後、まず何をしなければなりませんか？"
  },
  {
   "index": 39,
   "startMs": 192480,
   "endMs": 193470,
   "text": "。"
  },
  {
   "index": 40,
   "startMs": 196040,
   "endMs": 197330,
   "text": "2番。"
  },
  {
   "index": 41,
   "startMs": 197520,
   "endMs": 203670,
   "text": "会社で本社の営業部長とアシスタントの男の人が話して、います。"
  },
  {
   "index": 42,
   "startMs": 204120,
   "endMs": 208050,
   "text": "男の人はどの日を予約しますか？"
  },
  {
   "index": 43,
   "startMs": 209160,
   "endMs": 219930,
   "text": "吉田さん、六月から水曜日に各支店の支店長と私たち本社営業部と合同で定例の営業会議を開きます。"
  },
  {
   "index": 44,
   "startMs": 219930,
   "endMs": 237330,
   "text": "それで六月分の会議室の予約お願いできますか時間はまだ決まっていないからひとまず終日ではい定例ということは毎週水曜日を抑えればよろしいでしょうかすみません学週でお願いします。"
  },
  {
   "index": 45,
   "startMs": 237330,
   "endMs": 239850,
   "text": "初回は六月九日です。"
  },
  {
   "index": 46,
   "startMs": 239850,
   "endMs": 243510,
   "text": "六月九日から一週間おきですね。"
  },
  {
   "index": 47,
   "startMs": 243640,
   "endMs": 261070,
   "text": "あの二十三日ですが、先日、部長副部長の二十四日の海外出張が早まる可能性があると伺ったかとあそうですたねじゃあ念のため、翌週もえておいて出張の予定が確定したらお知らせします。"
  },
  {
   "index": 48,
   "startMs": 261070,
   "endMs": 277750,
   "text": "はいそれから合同会議の前に私たち営業部内の打ち合わせも必要になるので、えと合同会議の週の月曜日も予約を入れてくれますか二十三日の次の週もね表知しました。"
  },
  {
   "index": 49,
   "startMs": 279090,
   "endMs": 280080,
   "text": "。"
  },
  {
   "index": 50,
   "startMs": 282910,
   "endMs": 286780,
   "text": "男の人はどの日を予約しますか？"
  },
  {
   "index": 51,
   "startMs": 298050,
   "endMs": 299100,
   "text": "。"
  },
  {
   "index": 52,
   "startMs": 301610,
   "endMs": 303080,
   "text": "三番。"
  },
  {
   "index": 53,
   "startMs": 303280,
   "endMs": 308530,
   "text": "大学の日本語の授業で先生が留学生に話して、います。"
  },
  {
   "index": 54,
   "startMs": 308810,
   "endMs": 315200,
   "text": "留学生は来週の授業の前までに何をしなければなりませんか。"
  },
  {
   "index": 55,
   "startMs": 316350,
   "endMs": 319140,
   "text": "来週の授業について連絡します。"
  },
  {
   "index": 56,
   "startMs": 319270,
   "endMs": 346180,
   "text": "今日は世界に共通する社会問題というテーマでグループで選んだトピックについて日本の現状を分析しました来週は日本人の学生が授業に来て、今日のグループに加わってもらい、皆さんと話し合いますその時に皆さんの選んだトピックについて自分の国の現状や施策などを共有してもらいますので、情報を収集しておいてください。"
  },
  {
   "index": 57,
   "startMs": 346280,
   "endMs": 355130,
   "text": "日本人の学生との話し合いで出た意見をもとに、皆さんが日常で取り組めることをいくつか挙げて発表してもらいます。"
  },
  {
   "index": 58,
   "startMs": 356460,
   "endMs": 357390,
   "text": "う。"
  },
  {
   "index": 59,
   "startMs": 360360,
   "endMs": 366810,
   "text": "留学生は来週の授業の前までに何をしなければなりませんか。"
  },
  {
   "index": 60,
   "startMs": 378070,
   "endMs": 379000,
   "text": "あ。"
  },
  {
   "index": 61,
   "startMs": 381600,
   "endMs": 383070,
   "text": "4番。"
  },
  {
   "index": 62,
   "startMs": 383280,
   "endMs": 387990,
   "text": "家具の会社で女の人と男の人が話して、います。"
  },
  {
   "index": 63,
   "startMs": 388550,
   "endMs": 393500,
   "text": "男の人はまず何をしなければなりませんか。"
  },
  {
   "index": 64,
   "startMs": 394600,
   "endMs": 409510,
   "text": "中田さん、来週の火曜日、山川デパートとの打ち合わせのアポが取れたので一緒にいってもらえますか来月行われる家具のフェアから中田さんに担当になってもらいますので、はいわかりました"
  },
  {
   "index": 65,
   "startMs": 410350,
   "endMs": 419050,
   "text": "山川デパートとの取引の記録がファイルにまとまっているので、それを見てこれまでの経緯を把握しておいてください。"
  },
  {
   "index": 66,
   "startMs": 419160,
   "endMs": 423990,
   "text": "口頭で引き継ぎたいこともありますから、早速取りかかってくださいね。"
  },
  {
   "index": 67,
   "startMs": 423990,
   "endMs": 425310,
   "text": "はい。"
  },
  {
   "index": 68,
   "startMs": 425310,
   "endMs": 436170,
   "text": "火曜日の打ち合わせで使う資料を事前に先頭に送るので、その時に担当者変更の連絡もしますね挨拶メールはその後にお願いします。"
  },
  {
   "index": 69,
   "startMs": 436170,
   "endMs": 437490,
   "text": "承知しました。"
  },
  {
   "index": 70,
   "startMs": 438800,
   "endMs": 439850,
   "text": "は。"
  },
  {
   "index": 71,
   "startMs": 442600,
   "endMs": 447550,
   "text": "男の人はまず何をしなければなりませんか。"
  },
  {
   "index": 72,
   "startMs": 458750,
   "endMs": 459620,
   "text": "は。"
  },
  {
   "index": 73,
   "startMs": 462300,
   "endMs": 463650,
   "text": "5番。"
  },
  {
   "index": 74,
   "startMs": 463870,
   "endMs": 468460,
   "text": "スーパーで店長と女の社員が話して、います。"
  },
  {
   "index": 75,
   "startMs": 468900,
   "endMs": 474330,
   "text": "女の社員はイベントの企画書をどう修正しますか？"
  },
  {
   "index": 76,
   "startMs": 475400,
   "endMs": 481310,
   "text": "山本さん、夏の小学生お仕事体験イベントの企画書を見ました。"
  },
  {
   "index": 77,
   "startMs": 481520,
   "endMs": 484550,
   "text": "子供たちに喜んでもらえるといいですね。"
  },
  {
   "index": 78,
   "startMs": 484630,
   "endMs": 493120,
   "text": "それで企画の内容ですが、倉庫の見学商品の陳列レジの作業という順で体験してもらう。"
  },
  {
   "index": 79,
   "startMs": 493120,
   "endMs": 512320,
   "text": "んで、すねはい店長参加者の受け入れは一日一回十人実施期間を五日で考えましたそこなんですが、十人受け入れるとレジの体験の時、いくらお客さんが少ない時間帯とはいえ、他のレジが混んでしまうようなことはありませんか。"
  },
  {
   "index": 80,
   "startMs": 512750,
   "endMs": 517700,
   "text": "だからといってエジだけを人数制限するとか哀いそうですよね。"
  },
  {
   "index": 81,
   "startMs": 517800,
   "endMs": 519630,
   "text": "そうで、すね。"
  },
  {
   "index": 82,
   "startMs": 519710,
   "endMs": 526160,
   "text": "じゃあ五人ずつにして一日二回実施するのはどうでしょうかうん。"
  },
  {
   "index": 83,
   "startMs": 526290,
   "endMs": 529560,
   "text": "それだと準備でバタバタしてしまいますよ。"
  },
  {
   "index": 84,
   "startMs": 529740,
   "endMs": 533670,
   "text": "受け入れは一日一回五人が限界でしょう。"
  },
  {
   "index": 85,
   "startMs": 533890,
   "endMs": 541360,
   "text": "たくさん受け入れようと思ったら期間を伸ばすしかないですが、店の負担を考えるとこれ以上はちょっとね。"
  },
  {
   "index": 86,
   "startMs": 541360,
   "endMs": 543040,
   "text": "わかりました。"
  },
  {
   "index": 87,
   "startMs": 543210,
   "endMs": 548040,
   "text": "では、今言った点を修正して、企画書の再提出をお願いします。"
  },
  {
   "index": 88,
   "startMs": 548040,
   "endMs": 549060,
   "text": "はい。"
  },
  {
   "index": 89,
   "startMs": 550360,
   "endMs": 551350,
   "text": "は。"
  },
  {
   "index": 90,
   "startMs": 554190,
   "endMs": 559620,
   "text": "女の社員はイベントの企画書をどう修正しますか？"
  },
  {
   "index": 91,
   "startMs": 571520,
   "endMs": 572510,
   "text": "。"
  },
  {
   "index": 92,
   "startMs": 575510,
   "endMs": 577280,
   "text": "問題二。"
  },
  {
   "index": 93,
   "startMs": 577530,
   "endMs": 582000,
   "text": "問題二では、まず質問を聞いてください。"
  },
  {
   "index": 94,
   "startMs": 582460,
   "endMs": 586870,
   "text": "その後、問題用紙の選択肢を読んでください。"
  },
  {
   "index": 95,
   "startMs": 587030,
   "endMs": 589100,
   "text": "読む時間があります。"
  },
  {
   "index": 96,
   "startMs": 589780,
   "endMs": 592150,
   "text": "それから話を聞いて。"
  },
  {
   "index": 97,
   "startMs": 592280,
   "endMs": 599810,
   "text": "問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 98,
   "startMs": 602210,
   "endMs": 604640,
   "text": "では、始めます。"
  },
  {
   "index": 99,
   "startMs": 607380,
   "endMs": 608370,
   "text": "。"
  },
  {
   "index": 100,
   "startMs": 610920,
   "endMs": 612330,
   "text": "一番。"
  },
  {
   "index": 101,
   "startMs": 612520,
   "endMs": 617470,
   "text": "テレビでレポーターとケーキ屋の店長が話して、います。"
  },
  {
   "index": 102,
   "startMs": 618020,
   "endMs": 624050,
   "text": "店長はこの店で一番重視していることは何だと言っていますか？"
  },
  {
   "index": 103,
   "startMs": 643330,
   "endMs": 644440,
   "text": "。"
  },
  {
   "index": 104,
   "startMs": 647210,
   "endMs": 655040,
   "text": "今日は話題のケーキ屋さんに来て、います、店生の木村さん、綺麗なケーキが並んで、いますね。"
  },
  {
   "index": 105,
   "startMs": 655170,
   "endMs": 661740,
   "text": "うちは全べてのケーキが期間限定で、季節ごとに商品を入れ替えているんです。"
  },
  {
   "index": 106,
   "startMs": 661910,
   "endMs": 667100,
   "text": "今はイチ号をメインに春の花をイメージしたケーキを揃えて、います。"
  },
  {
   "index": 107,
   "startMs": 667390,
   "endMs": 669520,
   "text": "季節ごとに全て入れ替える。"
  },
  {
   "index": 108,
   "startMs": 669520,
   "endMs": 676720,
   "text": "んですかその季節ならではの素材や形、彩りを味わっていただきたい。"
  },
  {
   "index": 109,
   "startMs": 676720,
   "endMs": 681580,
   "text": "それが何にも増して私どもがこだわっている点です。"
  },
  {
   "index": 110,
   "startMs": 681580,
   "endMs": 693160,
   "text": "そうなんですねケーキに飾られているフルーツが美味しそうですね果物は地元に限らず、全国の農園から直接仕入れて、います。"
  },
  {
   "index": 111,
   "startMs": 693300,
   "endMs": 695910,
   "text": "ケーキは大人も楽しめるよう。"
  },
  {
   "index": 112,
   "startMs": 695910,
   "endMs": 700110,
   "text": "甘さを控えめにして大きさもあえて小ぶりにしているんです。"
  },
  {
   "index": 113,
   "startMs": 700110,
   "endMs": 702210,
   "text": "お値段もお手頃ですよね。"
  },
  {
   "index": 114,
   "startMs": 702210,
   "endMs": 707970,
   "text": "いろろなケーキを味わっていただきたいので、大きさの分価格を抑えて、います。"
  },
  {
   "index": 115,
   "startMs": 708100,
   "endMs": 710350,
   "text": "ぜひ一度お越しください。"
  },
  {
   "index": 116,
   "startMs": 711590,
   "endMs": 712640,
   "text": "。"
  },
  {
   "index": 117,
   "startMs": 715500,
   "endMs": 721470,
   "text": "店長はこの店で一番重視していることは何だと言っていますか？"
  },
  {
   "index": 118,
   "startMs": 732700,
   "endMs": 733810,
   "text": "は。"
  },
  {
   "index": 119,
   "startMs": 736280,
   "endMs": 737570,
   "text": "二番？"
  },
  {
   "index": 120,
   "startMs": 737810,
   "endMs": 744020,
   "text": "ラジオで女の人が自分の会社の商品について話して、います。"
  },
  {
   "index": 121,
   "startMs": 744660,
   "endMs": 751230,
   "text": "女の人は、この商品の売り上が伸びたきっかけは何だと言っていますか？"
  },
  {
   "index": 122,
   "startMs": 770330,
   "endMs": 771560,
   "text": "。"
  },
  {
   "index": 123,
   "startMs": 774390,
   "endMs": 808020,
   "text": "皆さんもふんわりタッチという名前のティッシュペーパーを見たことがあるでしょうか実はこの商品、もともとは柔らかティッシュという商品名だったんです柔らかティッシュは従来の製品に比べて品質を向上させた分、価格設定が高く発売当初、販売に苦戦していましたですが、この肌触りの良さが敏感な肌を持つ人たちに必ず受け入れられると、私たちには確信がありました。"
  },
  {
   "index": 124,
   "startMs": 808140,
   "endMs": 823410,
   "text": "そこで、消費者の皆様に商品の特徴をよりわかりやすく伝えられるように、ふんわりタッチに改めたところ、コマーシャルなどの広告を増やすことなく、売上を伸ばすことができました。"
  },
  {
   "index": 125,
   "startMs": 824710,
   "endMs": 825700,
   "text": "う。"
  },
  {
   "index": 126,
   "startMs": 828580,
   "endMs": 835390,
   "text": "女の人は、この商品の売り上げが伸びたきっかけは何だと言っていますか？"
  },
  {
   "index": 127,
   "startMs": 846640,
   "endMs": 847750,
   "text": "。"
  },
  {
   "index": 128,
   "startMs": 850170,
   "endMs": 851640,
   "text": "3番。"
  },
  {
   "index": 129,
   "startMs": 851820,
   "endMs": 858990,
   "text": "靴下を作る会社の商品開発室で、リーダーが開発チームの人に話して、います。"
  },
  {
   "index": 130,
   "startMs": 859400,
   "endMs": 864950,
   "text": "リーダーはこの靴下の改良すべき点は何だと言っていますか？"
  },
  {
   "index": 131,
   "startMs": 884320,
   "endMs": 885430,
   "text": "。"
  },
  {
   "index": 132,
   "startMs": 888150,
   "endMs": 894360,
   "text": "酪農家さん向けに開発した靴下ですが、モニターをお願いした結果がまとまりました。"
  },
  {
   "index": 133,
   "startMs": 894610,
   "endMs": 897520,
   "text": "冬でも指先が冷たくならない。"
  },
  {
   "index": 134,
   "startMs": 897520,
   "endMs": 903040,
   "text": "汗をかいても匂わないと保温性消臭性に高い評価を受けました。"
  },
  {
   "index": 135,
   "startMs": 903390,
   "endMs": 909780,
   "text": "また、すぐに生地に穴が開くこともなく、耐久性についても合格点と考えて、います。"
  },
  {
   "index": 136,
   "startMs": 910340,
   "endMs": 916250,
   "text": "取り組むべきは、その部分にもっと弾力性が欲しい、衝撃が和らぐよ。"
  },
  {
   "index": 137,
   "startMs": 916250,
   "endMs": 919550,
   "text": "うな工夫をしてほしいという意見への対応です。"
  },
  {
   "index": 138,
   "startMs": 919840,
   "endMs": 925630,
   "text": "硬いコンプリートの上で作業することが多く、体への負担が大きいからだそうです。"
  },
  {
   "index": 139,
   "startMs": 926030,
   "endMs": 929420,
   "text": "この点について改良を行っていきましょう。"
  },
  {
   "index": 140,
   "startMs": 930780,
   "endMs": 931830,
   "text": "。"
  },
  {
   "index": 141,
   "startMs": 934610,
   "endMs": 940340,
   "text": "リーダーは、この靴下の改良すべき点は何だと言っていますか？"
  },
  {
   "index": 142,
   "startMs": 951610,
   "endMs": 952660,
   "text": "。"
  },
  {
   "index": 143,
   "startMs": 955160,
   "endMs": 956630,
   "text": "4番。"
  },
  {
   "index": 144,
   "startMs": 956860,
   "endMs": 962470,
   "text": "テレビでアナウンサーの女の人と絵本作家が話して、います。"
  },
  {
   "index": 145,
   "startMs": 962920,
   "endMs": 969910,
   "text": "絵本作家が桜町に美術館を作った理由は何だと言っていますか？"
  },
  {
   "index": 146,
   "startMs": 989180,
   "endMs": 990230,
   "text": "。"
  },
  {
   "index": 147,
   "startMs": 993060,
   "endMs": 1013970,
   "text": "高橋さんは自然をテーマにした絵本を多く書いてらっしゃいますが、最近、自然豊かなここ桜町に美術館を作られたそうですねはい、都心からのアクセスはいいとは言えませんが、親子で自然を体験していただくにはいい場所だと思います。"
  },
  {
   "index": 148,
   "startMs": 1014150,
   "endMs": 1019160,
   "text": "ちょっと遠くても訪れたくなるような素敵な場所ですよね。"
  },
  {
   "index": 149,
   "startMs": 1019410,
   "endMs": 1031500,
   "text": "美術館に展示されている絵本の弦がそのままの風景に見えますね桜町は自然を守る活動が盛んで、緑が豊かなんです。"
  },
  {
   "index": 150,
   "startMs": 1031740,
   "endMs": 1038010,
   "text": "この辺たりは、私が子供の頃遊んでいた自然の風景を思い起こさせます。"
  },
  {
   "index": 151,
   "startMs": 1038110,
   "endMs": 1053680,
   "text": "私にとって小さい時の風景や体験が絵本作りの原動力になっていると言っても過言ではありませんそうなんですねこの環境に身を置いてもらうことで、絵本の世界を疑似体験してほしい。"
  },
  {
   "index": 152,
   "startMs": 1053790,
   "endMs": 1058140,
   "text": "ここに作ることでそういったことが可能になると思ったんです。"
  },
  {
   "index": 153,
   "startMs": 1059610,
   "endMs": 1060780,
   "text": "。"
  },
  {
   "index": 154,
   "startMs": 1063410,
   "endMs": 1070220,
   "text": "絵本作家が桜町に美術館を作った理由は何だと言っていますか？"
  },
  {
   "index": 155,
   "startMs": 1081550,
   "endMs": 1082540,
   "text": "あは。"
  },
  {
   "index": 156,
   "startMs": 1085130,
   "endMs": 1086480,
   "text": "5番。"
  },
  {
   "index": 157,
   "startMs": 1086680,
   "endMs": 1093130,
   "text": "ラジオでアナウンサーの女の人と大学の学長が話して、います。"
  },
  {
   "index": 158,
   "startMs": 1093680,
   "endMs": 1101990,
   "text": "学長はこの大学で海外に留学する学生が増えた理由は何だと言っていますか？"
  },
  {
   "index": 159,
   "startMs": 1121270,
   "endMs": 1122260,
   "text": "は。"
  },
  {
   "index": 160,
   "startMs": 1125120,
   "endMs": 1171950,
   "text": "最近、日本の大学では海外留学をする学生が減っているそうですが、桜大学では増えているそうですね数年前までは留学をするよりも国内で資格を取った方が就職に有利だなどの理由から興味はあるものの留学を選択しない学生が多くいましたそれで留学から戻った学生を対象に日本での学校生活にスムーズに戻れるよう支援をしたり、留学で得た経験をキャリアにどうつなげるか就職科の職員に相談する機会を設けたりしましたほこのような支援体制を整えたことで、多くの学生たちが留学を決心できたと思います。"
  },
  {
   "index": 161,
   "startMs": 1172070,
   "endMs": 1187520,
   "text": "奨学金の充実や留学先の情報の発信が一般的には重要だと考えられますが、それだけではなかなか増えませんそうなんですね今後についてはどのようにお考えですかはい。"
  },
  {
   "index": 162,
   "startMs": 1187650,
   "endMs": 1194100,
   "text": "海外の大学との交流や交換プログラムをより一層拡充したいと考えて、います。"
  },
  {
   "index": 163,
   "startMs": 1195420,
   "endMs": 1196410,
   "text": "。"
  },
  {
   "index": 164,
   "startMs": 1199290,
   "endMs": 1206940,
   "text": "学長はこの大学で海外に留学する学生が増えた理由は何だと言っていますか？"
  },
  {
   "index": 165,
   "startMs": 1218330,
   "endMs": 1219380,
   "text": "。"
  },
  {
   "index": 166,
   "startMs": 1221980,
   "endMs": 1223390,
   "text": "6番。"
  },
  {
   "index": 167,
   "startMs": 1223540,
   "endMs": 1230410,
   "text": "ラジオで、アナウンサーと女の人が国会議員の選挙について話しています。"
  },
  {
   "index": 168,
   "startMs": 1230900,
   "endMs": 1238250,
   "text": "女の人は今回の選挙で票の獲得を左右するのは何だと言っていますか？"
  },
  {
   "index": 169,
   "startMs": 1257540,
   "endMs": 1258470,
   "text": "。"
  },
  {
   "index": 170,
   "startMs": 1261430,
   "endMs": 1266740,
   "text": "今回の選挙ですが、何が票の獲得を左右すると思いますか？"
  },
  {
   "index": 171,
   "startMs": 1266930,
   "endMs": 1298939,
   "text": "選挙前に汚職問題などもありましたがそうですね野党はそこを争点に選挙戦を戦っていますねただ国民はそれ以上に身近なことに関心を持っていると思いますよと言いますと先週の世論調査の結果を見ると物価高減税所得の向上といった言葉が選挙のキーワードとして多く上げられていましたこの点については党によって政策が大きく異なっています。"
  },
  {
   "index": 172,
   "startMs": 1299040,
   "endMs": 1310230,
   "text": "育児休業制度の拡充や高齢者の福祉政策を上げた人もいますけど、こちらはどの等も掲げている政策に大差はないですからね。"
  },
  {
   "index": 173,
   "startMs": 1310340,
   "endMs": 1315830,
   "text": "自然エネルギーなど、環境問題解決のための政策はどうでしょうか。"
  },
  {
   "index": 174,
   "startMs": 1315920,
   "endMs": 1317570,
   "text": "注目度も上がっている？"
  },
  {
   "index": 175,
   "startMs": 1317570,
   "endMs": 1327050,
   "text": "かと思うんですが、それが表に結びつくかは別問題じゃないでしょうか長期的な問題は表に結びつきにくいと思います。"
  },
  {
   "index": 176,
   "startMs": 1328410,
   "endMs": 1329400,
   "text": "。"
  },
  {
   "index": 177,
   "startMs": 1332260,
   "endMs": 1339670,
   "text": "女の人は今回の選挙で、票の獲得を左右するのは何だと言っていますか？"
  },
  {
   "index": 178,
   "startMs": 1351770,
   "endMs": 1354680,
   "text": "ここでちょっと休みましょう。"
  },
  {
   "index": 179,
   "startMs": 1354990,
   "endMs": 1355860,
   "text": "。"
  },
  {
   "index": 180,
   "startMs": 1373530,
   "endMs": 1374880,
   "text": "。"
  },
  {
   "index": 181,
   "startMs": 1387010,
   "endMs": 1389800,
   "text": "では、また続けます。"
  },
  {
   "index": 182,
   "startMs": 1391400,
   "endMs": 1392210,
   "text": "で。"
  },
  {
   "index": 183,
   "startMs": 1395260,
   "endMs": 1397030,
   "text": "問題三。"
  },
  {
   "index": 184,
   "startMs": 1397390,
   "endMs": 1402640,
   "text": "問題三では、問題用紙に何も印刷されていません。"
  },
  {
   "index": 185,
   "startMs": 1403270,
   "endMs": 1408400,
   "text": "この問題は、全体としてどんな内容かを聞く問題です。"
  },
  {
   "index": 186,
   "startMs": 1409170,
   "endMs": 1412140,
   "text": "話の前に質問はありません。"
  },
  {
   "index": 187,
   "startMs": 1413040,
   "endMs": 1415590,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 188,
   "startMs": 1416130,
   "endMs": 1419760,
   "text": "それから質問と選択肢を聞いて。"
  },
  {
   "index": 189,
   "startMs": 1420010,
   "endMs": 1426160,
   "text": "一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 190,
   "startMs": 1428420,
   "endMs": 1430670,
   "text": "では、始めます。"
  },
  {
   "index": 191,
   "startMs": 1434170,
   "endMs": 1435280,
   "text": "で。"
  },
  {
   "index": 192,
   "startMs": 1437760,
   "endMs": 1439110,
   "text": "一番。"
  },
  {
   "index": 193,
   "startMs": 1439330,
   "endMs": 1445000,
   "text": "日本茶の専門店で男の人がお茶の説明をしています。"
  },
  {
   "index": 194,
   "startMs": 1446240,
   "endMs": 1453830,
   "text": "近年、海外でも人気がある日本茶ですが、お茶の葉は日本各地で栽培されて、います。"
  },
  {
   "index": 195,
   "startMs": 1453930,
   "endMs": 1460440,
   "text": "大きく分けると、平地で育てられたものと三間部で育てられたものがあります。"
  },
  {
   "index": 196,
   "startMs": 1460440,
   "endMs": 1469800,
   "text": "平地は遮るものがないので、気の光を長時間浴びますから、お茶の葉がよく育ち、葉っぱに厚みが出て渋みが増すんです。"
  },
  {
   "index": 197,
   "startMs": 1470280,
   "endMs": 1477210,
   "text": "平室に比べて日の当たる時間が短いのが山と山に挟まれた山間部です。"
  },
  {
   "index": 198,
   "startMs": 1477210,
   "endMs": 1483810,
   "text": "一日の気温差が大きく、それがお茶の葉の甘みと香りを引き出すことがわかって、います。"
  },
  {
   "index": 199,
   "startMs": 1484120,
   "endMs": 1487810,
   "text": "どうぞいろいろな種類のお茶を試してみてください。"
  },
  {
   "index": 200,
   "startMs": 1489060,
   "endMs": 1489990,
   "text": "。"
  },
  {
   "index": 201,
   "startMs": 1492940,
   "endMs": 1496990,
   "text": "男の人は何について話していますか？"
  },
  {
   "index": 202,
   "startMs": 1498140,
   "endMs": 1499370,
   "text": "一？"
  },
  {
   "index": 203,
   "startMs": 1499450,
   "endMs": 1503380,
   "text": "栽培地の地形によるお茶の味の違い。"
  },
  {
   "index": 204,
   "startMs": 1505530,
   "endMs": 1506760,
   "text": "二？"
  },
  {
   "index": 205,
   "startMs": 1506860,
   "endMs": 1510610,
   "text": "お茶の葉を育てるのが難しい気候。"
  },
  {
   "index": 206,
   "startMs": 1512720,
   "endMs": 1514070,
   "text": "三。"
  },
  {
   "index": 207,
   "startMs": 1514170,
   "endMs": 1517560,
   "text": "海外で人気がある日本茶の種類。"
  },
  {
   "index": 208,
   "startMs": 1519750,
   "endMs": 1521040,
   "text": "四。"
  },
  {
   "index": 209,
   "startMs": 1521120,
   "endMs": 1524030,
   "text": "香りを引き出すお茶の入れ方。"
  },
  {
   "index": 210,
   "startMs": 1531400,
   "endMs": 1532450,
   "text": "は。"
  },
  {
   "index": 211,
   "startMs": 1534880,
   "endMs": 1536230,
   "text": "2番。"
  },
  {
   "index": 212,
   "startMs": 1536440,
   "endMs": 1540850,
   "text": "地域のテレビ番組でレポーターが話して、います。"
  },
  {
   "index": 213,
   "startMs": 1542130,
   "endMs": 1547140,
   "text": "今、私がいるのは桜川の西にある竹林です。"
  },
  {
   "index": 214,
   "startMs": 1547370,
   "endMs": 1556280,
   "text": "こちらの竹の林、数年前まで手入れされず、竹が密集して、昼でも薄暗い雰囲気でした。"
  },
  {
   "index": 215,
   "startMs": 1556440,
   "endMs": 1564570,
   "text": "そこで地元の融資が協力して竹を切って地元の見どころとなるよう整備したんです。"
  },
  {
   "index": 216,
   "startMs": 1564850,
   "endMs": 1576040,
   "text": "まず、林を整理する費用を得るために、切った竹を土壌改良剤やカごなどの竹細工の製品にして販売しました。"
  },
  {
   "index": 217,
   "startMs": 1576350,
   "endMs": 1586640,
   "text": "その売上げで遊歩道を設置し、イベントを行ったり、夜間にライトアップしたりしてエスエヌエスにも投稿しました。"
  },
  {
   "index": 218,
   "startMs": 1587180,
   "endMs": 1595130,
   "text": "幻想的な風景が受け、今では海外からも多くの人が訪れるようになったとのことです。"
  },
  {
   "index": 219,
   "startMs": 1596520,
   "endMs": 1597630,
   "text": "。"
  },
  {
   "index": 220,
   "startMs": 1600390,
   "endMs": 1605160,
   "text": "レポーターはこの林の何について話していますか？"
  },
  {
   "index": 221,
   "startMs": 1606300,
   "endMs": 1607590,
   "text": "一？"
  },
  {
   "index": 222,
   "startMs": 1607690,
   "endMs": 1610960,
   "text": "環境に負担をかけない開発。"
  },
  {
   "index": 223,
   "startMs": 1613030,
   "endMs": 1614260,
   "text": "二？"
  },
  {
   "index": 224,
   "startMs": 1614380,
   "endMs": 1617170,
   "text": "整備に必要な条件。"
  },
  {
   "index": 225,
   "startMs": 1619360,
   "endMs": 1620650,
   "text": "3。"
  },
  {
   "index": 226,
   "startMs": 1620740,
   "endMs": 1624010,
   "text": "竹を使った新製品の魅力。"
  },
  {
   "index": 227,
   "startMs": 1626260,
   "endMs": 1627550,
   "text": "4。"
  },
  {
   "index": 228,
   "startMs": 1627670,
   "endMs": 1630700,
   "text": "観光地化されるまでの家程。"
  },
  {
   "index": 229,
   "startMs": 1637920,
   "endMs": 1639030,
   "text": "。"
  },
  {
   "index": 230,
   "startMs": 1641540,
   "endMs": 1642950,
   "text": "三番。"
  },
  {
   "index": 231,
   "startMs": 1643170,
   "endMs": 1646500,
   "text": "テレビでアナウンサーが話して、います。"
  },
  {
   "index": 232,
   "startMs": 1647960,
   "endMs": 1655190,
   "text": "北山駅の改札口の脇に設置されている犬型ロボットが話題になって、います。"
  },
  {
   "index": 233,
   "startMs": 1655720,
   "endMs": 1669610,
   "text": "人が触ると、頭に埋め込まれたセンサーで、触った人の力の強さを読み取ると同時に、内蔵されたカメラとマイクで声や表状を認識します。"
  },
  {
   "index": 234,
   "startMs": 1670150,
   "endMs": 1682180,
   "text": "人工知能が受け取った情報を分析し、触った人の気持ちを推測した上で、それに合うように鳴き声や尻尾の振り方を決めます。"
  },
  {
   "index": 235,
   "startMs": 1682400,
   "endMs": 1688730,
   "text": "そして、嬉しい驚いたなどの感情を表現してくれます。"
  },
  {
   "index": 236,
   "startMs": 1689210,
   "endMs": 1693020,
   "text": "皆さんも一度行って触ってみてください。"
  },
  {
   "index": 237,
   "startMs": 1694310,
   "endMs": 1695360,
   "text": "。"
  },
  {
   "index": 238,
   "startMs": 1698220,
   "endMs": 1705570,
   "text": "アナウンサーは北山駅にある犬型のロボットの波について話していますか？"
  },
  {
   "index": 239,
   "startMs": 1706850,
   "endMs": 1708080,
   "text": "一？"
  },
  {
   "index": 240,
   "startMs": 1708180,
   "endMs": 1711630,
   "text": "触った人に反応を返す仕組み。"
  },
  {
   "index": 241,
   "startMs": 1713750,
   "endMs": 1714920,
   "text": "二？"
  },
  {
   "index": 242,
   "startMs": 1715020,
   "endMs": 1717870,
   "text": "駅に設置されたきっかけ。"
  },
  {
   "index": 243,
   "startMs": 1719990,
   "endMs": 1721220,
   "text": "三。"
  },
  {
   "index": 244,
   "startMs": 1721380,
   "endMs": 1725070,
   "text": "人の感情表現を真似する能力。"
  },
  {
   "index": 245,
   "startMs": 1727200,
   "endMs": 1728490,
   "text": "四。"
  },
  {
   "index": 246,
   "startMs": 1728580,
   "endMs": 1731670,
   "text": "駅の利用者を見守る機能。"
  },
  {
   "index": 247,
   "startMs": 1739000,
   "endMs": 1739930,
   "text": "。"
  },
  {
   "index": 248,
   "startMs": 1742550,
   "endMs": 1744020,
   "text": "四番。"
  },
  {
   "index": 249,
   "startMs": 1744130,
   "endMs": 1749920,
   "text": "起業を考えている人向けのセミナーで、男の人が話して、います。"
  },
  {
   "index": 250,
   "startMs": 1751140,
   "endMs": 1756390,
   "text": "私は東京から車で三時間ほどの若梨市で起業しました。"
  },
  {
   "index": 251,
   "startMs": 1756510,
   "endMs": 1763260,
   "text": "地方都市って事務所を構える場合でも、家賃や初期費用がかなり抑えられるんですよ。"
  },
  {
   "index": 252,
   "startMs": 1763390,
   "endMs": 1768940,
   "text": "低コストだから失敗を恐れずにやってみようという気持ちで挑戦できたんです。"
  },
  {
   "index": 253,
   "startMs": 1769440,
   "endMs": 1773430,
   "text": "自治体によっては補助金が出るところもありますよ。"
  },
  {
   "index": 254,
   "startMs": 1773560,
   "endMs": 1782110,
   "text": "それに競合する相手が少ない分、地元の会社にも覚えてもらえて、共同で仕事をする機会が増えるんです。"
  },
  {
   "index": 255,
   "startMs": 1782370,
   "endMs": 1788820,
   "text": "また、地方には特有の人脈というか、ネットワークがありますよね。"
  },
  {
   "index": 256,
   "startMs": 1788960,
   "endMs": 1793550,
   "text": "これも起業する上ではプラスに働くことが多いんです。"
  },
  {
   "index": 257,
   "startMs": 1794000,
   "endMs": 1799490,
   "text": "皆さんも地方を拠点とすることをぜひ検討してみてください。"
  },
  {
   "index": 258,
   "startMs": 1800680,
   "endMs": 1801790,
   "text": "。"
  },
  {
   "index": 259,
   "startMs": 1804530,
   "endMs": 1808520,
   "text": "男の人は何について話していますか？"
  },
  {
   "index": 260,
   "startMs": 1809710,
   "endMs": 1811000,
   "text": "一？"
  },
  {
   "index": 261,
   "startMs": 1811090,
   "endMs": 1814180,
   "text": "地方で起業するための手続き。"
  },
  {
   "index": 262,
   "startMs": 1816420,
   "endMs": 1817530,
   "text": "二？"
  },
  {
   "index": 263,
   "startMs": 1817710,
   "endMs": 1821340,
   "text": "地方での企業に適した仕事の分野。"
  },
  {
   "index": 264,
   "startMs": 1823500,
   "endMs": 1824850,
   "text": "三。"
  },
  {
   "index": 265,
   "startMs": 1824970,
   "endMs": 1828300,
   "text": "地元の会社との協力の仕方。"
  },
  {
   "index": 266,
   "startMs": 1830380,
   "endMs": 1831670,
   "text": "四。"
  },
  {
   "index": 267,
   "startMs": 1831820,
   "endMs": 1834430,
   "text": "地方で起業するメリット。"
  },
  {
   "index": 268,
   "startMs": 1841700,
   "endMs": 1842750,
   "text": "。"
  },
  {
   "index": 269,
   "startMs": 1845250,
   "endMs": 1846600,
   "text": "5番。"
  },
  {
   "index": 270,
   "startMs": 1846850,
   "endMs": 1850900,
   "text": "ラジオで心理カウンセラーが話して、います。"
  },
  {
   "index": 271,
   "startMs": 1852110,
   "endMs": 1857780,
   "text": "日常生活の中で怒りを感じることってありますよね。"
  },
  {
   "index": 272,
   "startMs": 1857780,
   "endMs": 1864020,
   "text": "そんな時は深呼吸するとか数字を数えるのが効果的だと言われています。"
  },
  {
   "index": 273,
   "startMs": 1864200,
   "endMs": 1872090,
   "text": "先日、ある研究グループによって怒りを感じた時の行動について実験が行われました。"
  },
  {
   "index": 274,
   "startMs": 1872210,
   "endMs": 1883460,
   "text": "実験では、参加者に怒りを感じさせる状況を作り、その後で全員にどのように怒りを感じたかを紙に書いてもらいました。"
  },
  {
   "index": 275,
   "startMs": 1883560,
   "endMs": 1890250,
   "text": "書いた紙をそのまま持っていた人たちは、怒りの程度があまり変わらなかったそうです。"
  },
  {
   "index": 276,
   "startMs": 1890500,
   "endMs": 1898570,
   "text": "一方、髪を丸めて捨てたり、シュレッダーで裁断した人たちは怒りが軽減したそうです。"
  },
  {
   "index": 277,
   "startMs": 1898840,
   "endMs": 1902170,
   "text": "皆さんも参考にしてみてくださいね。"
  },
  {
   "index": 278,
   "startMs": 1903500,
   "endMs": 1904370,
   "text": "。"
  },
  {
   "index": 279,
   "startMs": 1907420,
   "endMs": 1911710,
   "text": "心理カウンセラーは何について話していますか？"
  },
  {
   "index": 280,
   "startMs": 1912960,
   "endMs": 1914190,
   "text": "1。"
  },
  {
   "index": 281,
   "startMs": 1914290,
   "endMs": 1917080,
   "text": "怒りの気持ちの伝え方。"
  },
  {
   "index": 282,
   "startMs": 1919230,
   "endMs": 1920400,
   "text": "2？"
  },
  {
   "index": 283,
   "startMs": 1920520,
   "endMs": 1923670,
   "text": "怒りを抑えることの大切さ。"
  },
  {
   "index": 284,
   "startMs": 1925860,
   "endMs": 1927030,
   "text": "三？"
  },
  {
   "index": 285,
   "startMs": 1927230,
   "endMs": 1930560,
   "text": "感じた怒りに対処する方法。"
  },
  {
   "index": 286,
   "startMs": 1932650,
   "endMs": 1933940,
   "text": "4。"
  },
  {
   "index": 287,
   "startMs": 1934080,
   "endMs": 1937770,
   "text": "怒りを感じた時にとりがちな行動。"
  },
  {
   "index": 288,
   "startMs": 1945230,
   "endMs": 1946100,
   "text": "あ。"
  },
  {
   "index": 289,
   "startMs": 1949120,
   "endMs": 1950890,
   "text": "問題4。"
  },
  {
   "index": 290,
   "startMs": 1951120,
   "endMs": 1956250,
   "text": "問題四では、問題用紙に何も印刷されていません。"
  },
  {
   "index": 291,
   "startMs": 1956690,
   "endMs": 1959420,
   "text": "まず文を聞いてください。"
  },
  {
   "index": 292,
   "startMs": 1959940,
   "endMs": 1963510,
   "text": "それからそれに対する返事を聞いて。"
  },
  {
   "index": 293,
   "startMs": 1963590,
   "endMs": 1969500,
   "text": "一から三の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 294,
   "startMs": 1971780,
   "endMs": 1974150,
   "text": "では、始めます。"
  },
  {
   "index": 295,
   "startMs": 1977410,
   "endMs": 1978460,
   "text": "は。"
  },
  {
   "index": 296,
   "startMs": 1980930,
   "endMs": 1982340,
   "text": "一番。"
  },
  {
   "index": 297,
   "startMs": 1982540,
   "endMs": 1989230,
   "text": "小野くん、昨日小野くんが出たサッカー部の試合いたけど、チームがまとまってたね。"
  },
  {
   "index": 298,
   "startMs": 1990420,
   "endMs": 1991590,
   "text": "一？"
  },
  {
   "index": 299,
   "startMs": 1991760,
   "endMs": 1995090,
   "text": "うん、何が問題なんだろうね。"
  },
  {
   "index": 300,
   "startMs": 1996210,
   "endMs": 1997380,
   "text": "二。"
  },
  {
   "index": 301,
   "startMs": 1997500,
   "endMs": 2001730,
   "text": "ありがとうお互いのプレーを信頼してるからね。"
  },
  {
   "index": 302,
   "startMs": 2002890,
   "endMs": 2004060,
   "text": "三？"
  },
  {
   "index": 303,
   "startMs": 2004230,
   "endMs": 2007860,
   "text": "チームがバラバラなの見ててもわかるんだね。"
  },
  {
   "index": 304,
   "startMs": 2015220,
   "endMs": 2016210,
   "text": "。"
  },
  {
   "index": 305,
   "startMs": 2018790,
   "endMs": 2020080,
   "text": "二番？"
  },
  {
   "index": 306,
   "startMs": 2020240,
   "endMs": 2027050,
   "text": "課長来月からカメラの部品の値上げをすること、青場車にお話願いますか。"
  },
  {
   "index": 307,
   "startMs": 2028110,
   "endMs": 2029400,
   "text": "一。"
  },
  {
   "index": 308,
   "startMs": 2029530,
   "endMs": 2031900,
   "text": "ありがとう説明してくれる。"
  },
  {
   "index": 309,
   "startMs": 2031900,
   "endMs": 2032800,
   "text": "んで、すね。"
  },
  {
   "index": 310,
   "startMs": 2033880,
   "endMs": 2035050,
   "text": "二？"
  },
  {
   "index": 311,
   "startMs": 2035270,
   "endMs": 2038480,
   "text": "わかりました任せておいてください。"
  },
  {
   "index": 312,
   "startMs": 2039670,
   "endMs": 2040900,
   "text": "3。"
  },
  {
   "index": 313,
   "startMs": 2041040,
   "endMs": 2044730,
   "text": "じゃあ、青場に価格を聞いておいてください。"
  },
  {
   "index": 314,
   "startMs": 2052020,
   "endMs": 2052830,
   "text": "あ。"
  },
  {
   "index": 315,
   "startMs": 2055570,
   "endMs": 2056980,
   "text": "三番。"
  },
  {
   "index": 316,
   "startMs": 2057180,
   "endMs": 2061950,
   "text": "来週のグループ発表の準備グずぐズしてはいられないね。"
  },
  {
   "index": 317,
   "startMs": 2063130,
   "endMs": 2064360,
   "text": "一？"
  },
  {
   "index": 318,
   "startMs": 2064470,
   "endMs": 2066720,
   "text": "急いでまとめないとね。"
  },
  {
   "index": 319,
   "startMs": 2067850,
   "endMs": 2069020,
   "text": "2。"
  },
  {
   "index": 320,
   "startMs": 2069130,
   "endMs": 2071860,
   "text": "じゃあ、ゆっくり進めようか。"
  },
  {
   "index": 321,
   "startMs": 2073040,
   "endMs": 2074210,
   "text": "三。"
  },
  {
   "index": 322,
   "startMs": 2074420,
   "endMs": 2075350,
   "text": "え？"
  },
  {
   "index": 323,
   "startMs": 2075350,
   "endMs": 2077450,
   "text": "準備一緒にできないの？"
  },
  {
   "index": 324,
   "startMs": 2084760,
   "endMs": 2085750,
   "text": "はい。"
  },
  {
   "index": 325,
   "startMs": 2088350,
   "endMs": 2089760,
   "text": "四番。"
  },
  {
   "index": 326,
   "startMs": 2089950,
   "endMs": 2096280,
   "text": "さっき見た映画の主役、あの迫力のある演技は彼ならではだよね。"
  },
  {
   "index": 327,
   "startMs": 2097410,
   "endMs": 2098640,
   "text": "一？"
  },
  {
   "index": 328,
   "startMs": 2098810,
   "endMs": 2101360,
   "text": "彼にはできない演技だよね。"
  },
  {
   "index": 329,
   "startMs": 2102570,
   "endMs": 2103740,
   "text": "2？"
  },
  {
   "index": 330,
   "startMs": 2103840,
   "endMs": 2106210,
   "text": "彼の演技に不満なの？"
  },
  {
   "index": 331,
   "startMs": 2107400,
   "endMs": 2108630,
   "text": "三。"
  },
  {
   "index": 332,
   "startMs": 2108790,
   "endMs": 2111460,
   "text": "あれは彼にしかできないよね。"
  },
  {
   "index": 333,
   "startMs": 2118690,
   "endMs": 2119680,
   "text": "。"
  },
  {
   "index": 334,
   "startMs": 2122240,
   "endMs": 2123590,
   "text": "五番。"
  },
  {
   "index": 335,
   "startMs": 2123880,
   "endMs": 2130630,
   "text": "昼に駅前の店で食べてきたけど、昼の営業は本日をもって終了って書いてあったよ。"
  },
  {
   "index": 336,
   "startMs": 2131820,
   "endMs": 2132990,
   "text": "一？"
  },
  {
   "index": 337,
   "startMs": 2133130,
   "endMs": 2137300,
   "text": "本当明日から昼はやらないのか。"
  },
  {
   "index": 338,
   "startMs": 2138530,
   "endMs": 2139640,
   "text": "二？"
  },
  {
   "index": 339,
   "startMs": 2139780,
   "endMs": 2140650,
   "text": "え？"
  },
  {
   "index": 340,
   "startMs": 2140750,
   "endMs": 2143180,
   "text": "今日は早めに終わっちゃうの？"
  },
  {
   "index": 341,
   "startMs": 2144400,
   "endMs": 2145570,
   "text": "三？"
  },
  {
   "index": 342,
   "startMs": 2145750,
   "endMs": 2149800,
   "text": "ああ、今日は昼だけの営業なんだ。"
  },
  {
   "index": 343,
   "startMs": 2157160,
   "endMs": 2158270,
   "text": "は。"
  },
  {
   "index": 344,
   "startMs": 2160760,
   "endMs": 2162170,
   "text": "6番。"
  },
  {
   "index": 345,
   "startMs": 2162410,
   "endMs": 2167420,
   "text": "佐藤君んの誕生日会、本人に内緒のはずがバレてたよ。"
  },
  {
   "index": 346,
   "startMs": 2168610,
   "endMs": 2169840,
   "text": "一？"
  },
  {
   "index": 347,
   "startMs": 2169940,
   "endMs": 2172910,
   "text": "いつわかっちゃうかハラハラするね。"
  },
  {
   "index": 348,
   "startMs": 2174110,
   "endMs": 2175280,
   "text": "二？"
  },
  {
   "index": 349,
   "startMs": 2175430,
   "endMs": 2178520,
   "text": "まだ佐藤君んは気づいてないんだね。"
  },
  {
   "index": 350,
   "startMs": 2179720,
   "endMs": 2180950,
   "text": "三？"
  },
  {
   "index": 351,
   "startMs": 2181080,
   "endMs": 2183930,
   "text": "えどうしてわかっちゃったの？"
  },
  {
   "index": 352,
   "startMs": 2191290,
   "endMs": 2192220,
   "text": "。"
  },
  {
   "index": 353,
   "startMs": 2194850,
   "endMs": 2196260,
   "text": "7番。"
  },
  {
   "index": 354,
   "startMs": 2196370,
   "endMs": 2202160,
   "text": "うちの一年生、次の大会で期待できそうなのは早いさんぐらいだよね。"
  },
  {
   "index": 355,
   "startMs": 2203190,
   "endMs": 2204480,
   "text": "1。"
  },
  {
   "index": 356,
   "startMs": 2204610,
   "endMs": 2207940,
   "text": "他の一年生のレベル上げなきゃね。"
  },
  {
   "index": 357,
   "startMs": 2209070,
   "endMs": 2210240,
   "text": "二？"
  },
  {
   "index": 358,
   "startMs": 2210410,
   "endMs": 2214400,
   "text": "今年の一年生、みんなレベル高いからね。"
  },
  {
   "index": 359,
   "startMs": 2215450,
   "endMs": 2216800,
   "text": "3。"
  },
  {
   "index": 360,
   "startMs": 2216930,
   "endMs": 2219780,
   "text": "じゃあどの人ならいいと思う？"
  },
  {
   "index": 361,
   "startMs": 2227160,
   "endMs": 2228030,
   "text": "あ。"
  },
  {
   "index": 362,
   "startMs": 2230760,
   "endMs": 2232110,
   "text": "八番。"
  },
  {
   "index": 363,
   "startMs": 2232310,
   "endMs": 2237740,
   "text": "今の会議、私が最後に質問したばっかりに長引いちゃったね。"
  },
  {
   "index": 364,
   "startMs": 2238870,
   "endMs": 2240040,
   "text": "一？"
  },
  {
   "index": 365,
   "startMs": 2240170,
   "endMs": 2242720,
   "text": "気にしないで聞けばよかったのに。"
  },
  {
   "index": 366,
   "startMs": 2243910,
   "endMs": 2245020,
   "text": "二？"
  },
  {
   "index": 367,
   "startMs": 2245440,
   "endMs": 2248170,
   "text": "聞きたいことあったんだからいいんじゃない。"
  },
  {
   "index": 368,
   "startMs": 2249310,
   "endMs": 2250480,
   "text": "三。"
  },
  {
   "index": 369,
   "startMs": 2250730,
   "endMs": 2253820,
   "text": "他にも質問したいこと出てきちゃったの？"
  },
  {
   "index": 370,
   "startMs": 2261110,
   "endMs": 2262160,
   "text": "。"
  },
  {
   "index": 371,
   "startMs": 2264680,
   "endMs": 2266150,
   "text": "九番。"
  },
  {
   "index": 372,
   "startMs": 2266380,
   "endMs": 2271150,
   "text": "田中さん、新商品の発表会前倒しでやれない。"
  },
  {
   "index": 373,
   "startMs": 2271150,
   "endMs": 2273010,
   "text": "かって社長が。"
  },
  {
   "index": 374,
   "startMs": 2274120,
   "endMs": 2275350,
   "text": "一？"
  },
  {
   "index": 375,
   "startMs": 2275530,
   "endMs": 2278680,
   "text": "え、予定より遅れるんですか？"
  },
  {
   "index": 376,
   "startMs": 2279810,
   "endMs": 2280980,
   "text": "2。"
  },
  {
   "index": 377,
   "startMs": 2281100,
   "endMs": 2282270,
   "text": "え？"
  },
  {
   "index": 378,
   "startMs": 2282270,
   "endMs": 2284130,
   "text": "発表会の前に何をする？"
  },
  {
   "index": 379,
   "startMs": 2284130,
   "endMs": 2284970,
   "text": "んですか？"
  },
  {
   "index": 380,
   "startMs": 2286070,
   "endMs": 2287240,
   "text": "三？"
  },
  {
   "index": 381,
   "startMs": 2287480,
   "endMs": 2290810,
   "text": "えどのくらい早めたいんでしょうか。"
  },
  {
   "index": 382,
   "startMs": 2298130,
   "endMs": 2299120,
   "text": "。"
  },
  {
   "index": 383,
   "startMs": 2301680,
   "endMs": 2303150,
   "text": "十番。"
  },
  {
   "index": 384,
   "startMs": 2303440,
   "endMs": 2305810,
   "text": "サッカーの森監督。"
  },
  {
   "index": 385,
   "startMs": 2305810,
   "endMs": 2311090,
   "text": "来年はチームの監督を務めると同時に会長にもつくんだってね。"
  },
  {
   "index": 386,
   "startMs": 2312140,
   "endMs": 2313370,
   "text": "一？"
  },
  {
   "index": 387,
   "startMs": 2313500,
   "endMs": 2314430,
   "text": "え？"
  },
  {
   "index": 388,
   "startMs": 2314430,
   "endMs": 2316170,
   "text": "監督やめちゃうの？"
  },
  {
   "index": 389,
   "startMs": 2317330,
   "endMs": 2318500,
   "text": "二？"
  },
  {
   "index": 390,
   "startMs": 2318590,
   "endMs": 2321380,
   "text": "どちらか選ばざるを得ないんだね。"
  },
  {
   "index": 391,
   "startMs": 2322540,
   "endMs": 2323830,
   "text": "3。"
  },
  {
   "index": 392,
   "startMs": 2323970,
   "endMs": 2326580,
   "text": "両方なんて大変そうだね。"
  },
  {
   "index": 393,
   "startMs": 2333870,
   "endMs": 2334920,
   "text": "。"
  },
  {
   "index": 394,
   "startMs": 2337360,
   "endMs": 2339190,
   "text": "11番。"
  },
  {
   "index": 395,
   "startMs": 2339310,
   "endMs": 2346360,
   "text": "さっき言ってた奨学金の申請、先輩に聞いた限りでは、学年の条件はないって。"
  },
  {
   "index": 396,
   "startMs": 2347540,
   "endMs": 2348770,
   "text": "一？"
  },
  {
   "index": 397,
   "startMs": 2348890,
   "endMs": 2349580,
   "text": "え？"
  },
  {
   "index": 398,
   "startMs": 2349580,
   "endMs": 2352340,
   "text": "これから先輩が調べてくれるの？"
  },
  {
   "index": 399,
   "startMs": 2353610,
   "endMs": 2354720,
   "text": "2。"
  },
  {
   "index": 400,
   "startMs": 2354820,
   "endMs": 2357550,
   "text": "じゃあ、僕も申し込めるかも。"
  },
  {
   "index": 401,
   "startMs": 2358720,
   "endMs": 2359950,
   "text": "3。"
  },
  {
   "index": 402,
   "startMs": 2360140,
   "endMs": 2362630,
   "text": "先輩も自信がないんだね。"
  },
  {
   "index": 403,
   "startMs": 2369840,
   "endMs": 2370770,
   "text": "。"
  },
  {
   "index": 404,
   "startMs": 2373730,
   "endMs": 2375440,
   "text": "問題5。"
  },
  {
   "index": 405,
   "startMs": 2375690,
   "endMs": 2379560,
   "text": "問題五では長めの話を聞きます。"
  },
  {
   "index": 406,
   "startMs": 2380190,
   "endMs": 2383760,
   "text": "問題用紙にメモを取っても構いません。"
  },
  {
   "index": 407,
   "startMs": 2385520,
   "endMs": 2386930,
   "text": "一番。"
  },
  {
   "index": 408,
   "startMs": 2387280,
   "endMs": 2391090,
   "text": "問題用紙に何も印刷されていません。"
  },
  {
   "index": 409,
   "startMs": 2391610,
   "endMs": 2394400,
   "text": "まず、話を聞いてください。"
  },
  {
   "index": 410,
   "startMs": 2394750,
   "endMs": 2398500,
   "text": "それから質問と選択肢を聞いて。"
  },
  {
   "index": 411,
   "startMs": 2398600,
   "endMs": 2404990,
   "text": "一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 412,
   "startMs": 2407240,
   "endMs": 2409730,
   "text": "では、始めます。"
  },
  {
   "index": 413,
   "startMs": 2413050,
   "endMs": 2414040,
   "text": "あ。"
  },
  {
   "index": 414,
   "startMs": 2416640,
   "endMs": 2421170,
   "text": "スーパーで店長と店員二人が話して、います。"
  },
  {
   "index": 415,
   "startMs": 2422400,
   "endMs": 2429870,
   "text": "食品の廃棄が問題になってるけど、うちの店でもどうしても売れずに廃棄するものが出てしまっているよね。"
  },
  {
   "index": 416,
   "startMs": 2429870,
   "endMs": 2455490,
   "text": "今も消費期限が近いものは割引してるけど、もっといい方法ないかな売り場に消期限が近いものから購入してくださいてポスタをってますけどねもっと増やしましょかね売れ残りそうな食品を引き取って福祉活動に役立てている体もあるって聞きまたそういう団体に食品を提供するとか。"
  },
  {
   "index": 417,
   "startMs": 2455620,
   "endMs": 2513610,
   "text": "店側でできることを考えた方がいいと思いますいい案だと思うけどそれだと提供できる品物は限られるから結局廃棄するものはあまり減らないよ消期限が近い商品に付のをて当たりが出たらその商品が無料になるうでお客様に喜んでもらえと思います前にイベントで使っ在庫かられを活用できそう楽しそうは仕入れですが今は経験のが売れ行きを予測し仕入れを調整していますが需要を予測するを導入するのはうもっと正確に予測できるからを減らと思は利用料がかかります経験がなくても仕入れが調整できるように考えないといけないけどコストを考えるとね。"
  },
  {
   "index": 418,
   "startMs": 2513790,
   "endMs": 2518500,
   "text": "うん、じゃあお客様に喜んでもらえそうなことから始めよう。"
  },
  {
   "index": 419,
   "startMs": 2518500,
   "endMs": 2523720,
   "text": "それであまり効果がなかったら、ソフトウェアの利用も検討しよう。"
  },
  {
   "index": 420,
   "startMs": 2523720,
   "endMs": 2527380,
   "text": "ゆくゆくは福祉活動にも協力できるといいね。"
  },
  {
   "index": 421,
   "startMs": 2528670,
   "endMs": 2529780,
   "text": "。"
  },
  {
   "index": 422,
   "startMs": 2532500,
   "endMs": 2538050,
   "text": "食品の廃棄を減らすために、まず何をすることにしましたか？"
  },
  {
   "index": 423,
   "startMs": 2539140,
   "endMs": 2540370,
   "text": "一？"
  },
  {
   "index": 424,
   "startMs": 2540500,
   "endMs": 2542870,
   "text": "売り場のポスターを増やす。"
  },
  {
   "index": 425,
   "startMs": 2545090,
   "endMs": 2546320,
   "text": "二？"
  },
  {
   "index": 426,
   "startMs": 2546420,
   "endMs": 2549690,
   "text": "福祉団体に食品を提供する。"
  },
  {
   "index": 427,
   "startMs": 2551920,
   "endMs": 2553150,
   "text": "三。"
  },
  {
   "index": 428,
   "startMs": 2553250,
   "endMs": 2556400,
   "text": "商品にくじ付きのシールを貼る。"
  },
  {
   "index": 429,
   "startMs": 2558610,
   "endMs": 2559840,
   "text": "四。"
  },
  {
   "index": 430,
   "startMs": 2559990,
   "endMs": 2563680,
   "text": "需要を予測するソフトウェアを利用する。"
  },
  {
   "index": 431,
   "startMs": 2570720,
   "endMs": 2571530,
   "text": "The。"
  },
  {
   "index": 432,
   "startMs": 2574590,
   "endMs": 2575880,
   "text": "2番。"
  },
  {
   "index": 433,
   "startMs": 2576150,
   "endMs": 2578820,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 434,
   "startMs": 2579090,
   "endMs": 2582480,
   "text": "それから二つの質問を聞いて。"
  },
  {
   "index": 435,
   "startMs": 2582620,
   "endMs": 2590750,
   "text": "それぞれ問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 436,
   "startMs": 2593090,
   "endMs": 2595400,
   "text": "では、始めます。"
  },
  {
   "index": 437,
   "startMs": 2598600,
   "endMs": 2599650,
   "text": "は。"
  },
  {
   "index": 438,
   "startMs": 2602210,
   "endMs": 2608120,
   "text": "ラジオを聞きながら、学生二人が船のツアーについて話して、います。"
  },
  {
   "index": 439,
   "startMs": 2609510,
   "endMs": 2618360,
   "text": "今日は東湾から出発する観光クルーズの中で、船の上から夜景が楽しめるコースを四つご紹介します。"
  },
  {
   "index": 440,
   "startMs": 2618520,
   "endMs": 2623110,
   "text": "一番のコースは緑側を登って帰ってくるコースです。"
  },
  {
   "index": 441,
   "startMs": 2623260,
   "endMs": 2626710,
   "text": "ライトアップされた橋をいくつもくぐります。"
  },
  {
   "index": 442,
   "startMs": 2627000,
   "endMs": 2635130,
   "text": "二番のコースは、海沿いの観覧車や高層ビル群が美しく浮かび上がる景色が楽しめます。"
  },
  {
   "index": 443,
   "startMs": 2635130,
   "endMs": 2642570,
   "text": "三番のコースはルートは二番と同じですが、クルーズ中に本格的なコース料理が楽しめます。"
  },
  {
   "index": 444,
   "startMs": 2642850,
   "endMs": 2647380,
   "text": "四番のコースは工業地帯の夜景が満喫できます。"
  },
  {
   "index": 445,
   "startMs": 2647490,
   "endMs": 2653340,
   "text": "煙突から吹き出す水蒸気が幻想的で、エスエフ映画のようだと評判です。"
  },
  {
   "index": 446,
   "startMs": 2653520,
   "endMs": 2660810,
   "text": "なお、こちらのコースのみ不定期ですが、その他のコースは毎週末運行されています。"
  },
  {
   "index": 447,
   "startMs": 2660910,
   "endMs": 2664120,
   "text": "詳細はホームページをご覧ください。"
  },
  {
   "index": 448,
   "startMs": 2665320,
   "endMs": 2666970,
   "text": "面白そう。"
  },
  {
   "index": 449,
   "startMs": 2666970,
   "endMs": 2669010,
   "text": "今週末行ってみない。"
  },
  {
   "index": 450,
   "startMs": 2669010,
   "endMs": 2672910,
   "text": "ライトアップされた橋もいいけど、興業地帯もいいね。"
  },
  {
   "index": 451,
   "startMs": 2672910,
   "endMs": 2674710,
   "text": "どっちも良さそうだね。"
  },
  {
   "index": 452,
   "startMs": 2674950,
   "endMs": 2677560,
   "text": "一つは不定期運行でしょう？"
  },
  {
   "index": 453,
   "startMs": 2677560,
   "endMs": 2681340,
   "text": "今週末やってるのか在トを見てみるね。"
  },
  {
   "index": 454,
   "startMs": 2682070,
   "endMs": 2684380,
   "text": "ああ、ないみたい。"
  },
  {
   "index": 455,
   "startMs": 2684380,
   "endMs": 2700520,
   "text": "じゃあ決まりだねうんあ、来月家族が遊びに来るんだけど、その時も行こうかなビルとか車とかの夜景喜びそうだからそれがいいな家族と船の上で食事ができるのいいんじゃない？"
  },
  {
   "index": 456,
   "startMs": 2700520,
   "endMs": 2705980,
   "text": "それも魅力的だけど、食べながらだと景識がゆっくり楽しめないから。"
  },
  {
   "index": 457,
   "startMs": 2707260,
   "endMs": 2708370,
   "text": "。"
  },
  {
   "index": 458,
   "startMs": 2711170,
   "endMs": 2713179,
   "text": "質問一？"
  },
  {
   "index": 459,
   "startMs": 2713390,
   "endMs": 2718220,
   "text": "二人は今週末、どのコースに行くと言っていますか？"
  },
  {
   "index": 460,
   "startMs": 2727380,
   "endMs": 2728370,
   "text": "。"
  },
  {
   "index": 461,
   "startMs": 2731220,
   "endMs": 2733110,
   "text": "ひ問二。"
  },
  {
   "index": 462,
   "startMs": 2733280,
   "endMs": 2739430,
   "text": "女の学生は来月、家族とどのコースに行きたいと言っていますか？"
  }
 ],
 "audioVerified": false,
 "alternatives": {}
}