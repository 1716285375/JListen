{
 "examId": "2022-12",
 "primarySrt": "2022年12月JLPT日语能力考试N1历年真题听力.srt",
 "segments": [
  {
   "index": 1,
   "startMs": 2530,
   "endMs": 6220,
   "text": "これから音を聞いてください"
  },
  {
   "index": 2,
   "startMs": 7240,
   "endMs": 10540,
   "text": "音がよく聞こえないときは手をあげてください"
  },
  {
   "index": 3,
   "startMs": 13600,
   "endMs": 15880,
   "text": "天気がいいから散歩しましょう"
  },
  {
   "index": 4,
   "startMs": 16960,
   "endMs": 19480,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 5,
   "startMs": 19810,
   "endMs": 22600,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 6,
   "startMs": 22970,
   "endMs": 25940,
   "text": "天気がいいから散歩しましょう。"
  },
  {
   "index": 7,
   "startMs": 32890,
   "endMs": 36880,
   "text": "日本語能力試験聴解エヌ一。"
  },
  {
   "index": 8,
   "startMs": 37230,
   "endMs": 41400,
   "text": "これからエヌ一の懲戒試験を始めます。"
  },
  {
   "index": 9,
   "startMs": 41840,
   "endMs": 44930,
   "text": "問題用紙にメモを取っても構いません。"
  },
  {
   "index": 10,
   "startMs": 45410,
   "endMs": 47780,
   "text": "問題用紙を開けてください。"
  },
  {
   "index": 11,
   "startMs": 48790,
   "endMs": 53020,
   "text": "問題用紙のページがない時は手を挙げてください。"
  },
  {
   "index": 12,
   "startMs": 53710,
   "endMs": 57520,
   "text": "問題がよく見えない時も手を挙げてください。"
  },
  {
   "index": 13,
   "startMs": 57520,
   "endMs": 59380,
   "text": "いつでもいいです。"
  },
  {
   "index": 14,
   "startMs": 65420,
   "endMs": 67370,
   "text": "問題1。"
  },
  {
   "index": 15,
   "startMs": 67780,
   "endMs": 72490,
   "text": "問題一では、まず質問を聞いてください。"
  },
  {
   "index": 16,
   "startMs": 72940,
   "endMs": 75370,
   "text": "それから話を聞いて。"
  },
  {
   "index": 17,
   "startMs": 75450,
   "endMs": 79260,
   "text": "問題用紙の一から四の中から。"
  },
  {
   "index": 18,
   "startMs": 79340,
   "endMs": 83270,
   "text": "最も良いものを一つ選んでください。"
  },
  {
   "index": 19,
   "startMs": 85540,
   "endMs": 88270,
   "text": "では、練習しましょう。"
  },
  {
   "index": 20,
   "startMs": 94190,
   "endMs": 95240,
   "text": "例？"
  },
  {
   "index": 21,
   "startMs": 95520,
   "endMs": 101790,
   "text": "女の人が新しい製品の企画書について男の人と話して、います。"
  },
  {
   "index": 22,
   "startMs": 102500,
   "endMs": 106970,
   "text": "女の人はこの後、何をしなければなりませんか。"
  },
  {
   "index": 23,
   "startMs": 108160,
   "endMs": 114010,
   "text": "課長、明日の会議の企画書見ていただけたでしょうかうん。"
  },
  {
   "index": 24,
   "startMs": 114110,
   "endMs": 116119,
   "text": "わかりやすく出来上がってるね。"
  },
  {
   "index": 25,
   "startMs": 116119,
   "endMs": 117800,
   "text": "ありがとうござ。"
  },
  {
   "index": 26,
   "startMs": 117800,
   "endMs": 127100,
   "text": "います、ただ、実は製品の説明がちょっと弱いかなって気になってるんですがうん、そうだね。"
  },
  {
   "index": 27,
   "startMs": 127260,
   "endMs": 129690,
   "text": "でもまあこの部分はいいかな。"
  },
  {
   "index": 28,
   "startMs": 129800,
   "endMs": 132470,
   "text": "でえっと。"
  },
  {
   "index": 29,
   "startMs": 132750,
   "endMs": 134880,
   "text": "この十一ページのグラフ。"
  },
  {
   "index": 30,
   "startMs": 135000,
   "endMs": 137250,
   "text": "これずいぶん前のだね。"
  },
  {
   "index": 31,
   "startMs": 137250,
   "endMs": 141570,
   "text": "あ、すみませんじゃあそのグラフは変えて。"
  },
  {
   "index": 32,
   "startMs": 141650,
   "endMs": 146180,
   "text": "あ、それから会議室のパソコンやマイクの準備はできてる。"
  },
  {
   "index": 33,
   "startMs": 146180,
   "endMs": 148520,
   "text": "あ、そちらは大丈夫です。"
  },
  {
   "index": 34,
   "startMs": 150000,
   "endMs": 150990,
   "text": "。"
  },
  {
   "index": 35,
   "startMs": 153820,
   "endMs": 158230,
   "text": "女の人はこの後、何をしなければなりませんか。"
  },
  {
   "index": 36,
   "startMs": 159460,
   "endMs": 162790,
   "text": "最も良いものは三番です。"
  },
  {
   "index": 37,
   "startMs": 163210,
   "endMs": 168340,
   "text": "解答用紙の問題一の例のところを見てください。"
  },
  {
   "index": 38,
   "startMs": 168800,
   "endMs": 172190,
   "text": "最も良いものは三番ですから。"
  },
  {
   "index": 39,
   "startMs": 172310,
   "endMs": 174680,
   "text": "答えはこのように書きます。"
  },
  {
   "index": 40,
   "startMs": 177290,
   "endMs": 179480,
   "text": "では、始めます。"
  },
  {
   "index": 41,
   "startMs": 185730,
   "endMs": 187020,
   "text": "一番。"
  },
  {
   "index": 42,
   "startMs": 187240,
   "endMs": 192610,
   "text": "男の学生が大学の学習支援センターに電話をしています。"
  },
  {
   "index": 43,
   "startMs": 193210,
   "endMs": 198700,
   "text": "男の学生はこの後、まず何をしなければなりませんか？"
  },
  {
   "index": 44,
   "startMs": 199880,
   "endMs": 206930,
   "text": "もしもし学習支援センターですかそちらで学生アシスタントを募集していると聞いたんですが。"
  },
  {
   "index": 45,
   "startMs": 207060,
   "endMs": 225330,
   "text": "詳しく教えていただけますかはい、今回は学部生のレポート作成の支援をしてくれる大学院生を募集して、います、大学院生ですかはい修士一年ですそうですか募集人数が限られていて書類と面接で先行します。"
  },
  {
   "index": 46,
   "startMs": 225330,
   "endMs": 230250,
   "text": "はい、応募には指導教員の先生の許可が必要です。"
  },
  {
   "index": 47,
   "startMs": 230370,
   "endMs": 233760,
   "text": "応募することを伝えて承諾を得てきてください。"
  },
  {
   "index": 48,
   "startMs": 233760,
   "endMs": 237780,
   "text": "はい、その上で一度センターまで来てください。"
  },
  {
   "index": 49,
   "startMs": 237780,
   "endMs": 240060,
   "text": "応募書類の用紙をお渡しします。"
  },
  {
   "index": 50,
   "startMs": 240060,
   "endMs": 241440,
   "text": "わかりました？"
  },
  {
   "index": 51,
   "startMs": 241530,
   "endMs": 251520,
   "text": "あの説明会があるって聞いたんですが、いつですかああ、採用が決まった後に行います、事務手続きの説明もありますので。"
  },
  {
   "index": 52,
   "startMs": 251830,
   "endMs": 256540,
   "text": "何か応募前に質問があれば、またこちらに連絡してください。"
  },
  {
   "index": 53,
   "startMs": 256540,
   "endMs": 267940,
   "text": "あ、時々今活動中のアシスタントに話を聞きに来る人がいるんですが、仕事の邪魔になるので、それはお断りしています、わかりました。"
  },
  {
   "index": 54,
   "startMs": 269390,
   "endMs": 270440,
   "text": "。"
  },
  {
   "index": 55,
   "startMs": 273220,
   "endMs": 278770,
   "text": "男の学生はこの後、まず何をしなければなりませんか。"
  },
  {
   "index": 56,
   "startMs": 293760,
   "endMs": 294990,
   "text": "2番。"
  },
  {
   "index": 57,
   "startMs": 295280,
   "endMs": 299390,
   "text": "会社で女の人と男の人が話して、います。"
  },
  {
   "index": 58,
   "startMs": 299680,
   "endMs": 306250,
   "text": "女の人はこの後、昇格のために最初に何をしなければなりませんか。"
  },
  {
   "index": 59,
   "startMs": 307540,
   "endMs": 311230,
   "text": "課長お呼びでしょ、うかああ、加藤さん。"
  },
  {
   "index": 60,
   "startMs": 311390,
   "endMs": 318920,
   "text": "実は部長と話したんだけど、加藤さんに来月末の昇格試験を受けてもらおうということになったよ。"
  },
  {
   "index": 61,
   "startMs": 319050,
   "endMs": 320100,
   "text": "ありがとうござ。"
  },
  {
   "index": 62,
   "startMs": 320100,
   "endMs": 320760,
   "text": "います。"
  },
  {
   "index": 63,
   "startMs": 320880,
   "endMs": 359850,
   "text": "先週部長と面談があって、その際に上を目指して頑張っていきたいという気持ちをお伝えしていたんです昇格試験は一日目は筆記試験二日目はプレゼプレゼンは当日テーマを与えられてそれについて十分くらい話すんだ分かりましたそれで試験を受ける条件としてマネメント研修を受けてく必要があるんだけどそれが今月の終わりにあるからね詳細は後で知らせるよプレゼン心配かもしれないけど日頃の仕事の範囲のことが出るわだからね分かりました頑張ります。"
  },
  {
   "index": 64,
   "startMs": 361480,
   "endMs": 362530,
   "text": "。"
  },
  {
   "index": 65,
   "startMs": 365310,
   "endMs": 371820,
   "text": "女の人はこの後、昇格のために最初に何をしなければなりませんか。"
  },
  {
   "index": 66,
   "startMs": 386870,
   "endMs": 388280,
   "text": "3番。"
  },
  {
   "index": 67,
   "startMs": 388470,
   "endMs": 393180,
   "text": "大学のオーケストラの部長が部員に話しています。"
  },
  {
   "index": 68,
   "startMs": 393260,
   "endMs": 396290,
   "text": "部員は何をしなければなりませんか？"
  },
  {
   "index": 69,
   "startMs": 397470,
   "endMs": 412800,
   "text": "毎年恒例の定期演奏会の季節がやってきました今年は例年使用していたホールが改想中のため、別の会場を探すことになりましたが無事青葉ホールを抑えることができました協力してくれた皆さん、ありがとうござ。"
  },
  {
   "index": 70,
   "startMs": 412800,
   "endMs": 413340,
   "text": "います。"
  },
  {
   "index": 71,
   "startMs": 413730,
   "endMs": 421320,
   "text": "ポスターとチラシが来週印刷会社から届く予定で、ポスターはすでに各所に貼っていただくよう交渉済みです。"
  },
  {
   "index": 72,
   "startMs": 421610,
   "endMs": 425600,
   "text": "チラシの方は全員で手分けして配布したいと思います。"
  },
  {
   "index": 73,
   "startMs": 425700,
   "endMs": 438870,
   "text": "それから皆さんには毎年一人六枚無料の招待券を渡していましたがここ数年非常に好評でチケットが足りないくらいなので、今年は販売のみとしたいと思います。"
  },
  {
   "index": 74,
   "startMs": 440510,
   "endMs": 441560,
   "text": "。"
  },
  {
   "index": 75,
   "startMs": 444310,
   "endMs": 447880,
   "text": "部員は何をしなければなりませんか？"
  },
  {
   "index": 76,
   "startMs": 462770,
   "endMs": 464120,
   "text": "4番。"
  },
  {
   "index": 77,
   "startMs": 464270,
   "endMs": 469160,
   "text": "本屋で男の店員と女の店長が話して、います。"
  },
  {
   "index": 78,
   "startMs": 469730,
   "endMs": 474920,
   "text": "男の店員は今日何をしなければなりませんか。"
  },
  {
   "index": 79,
   "startMs": 475960,
   "endMs": 484810,
   "text": "店長、おはようござ、います、おはようござ、います、あの、この瞬刊なんですが、思ってたほど売れ行きが良くないですよね。"
  },
  {
   "index": 80,
   "startMs": 484900,
   "endMs": 487570,
   "text": "売り場に置いた僕が書いた本の紹介文。"
  },
  {
   "index": 81,
   "startMs": 487570,
   "endMs": 493150,
   "text": "いまいちでしょうかうん、十分興味を引いていると思いますけど。"
  },
  {
   "index": 82,
   "startMs": 493260,
   "endMs": 534510,
   "text": "陳列の仕方かな今棚の真ん中の段に入ってたと思いますけど、お客さんの目線て下の方に行きやすいからちょっと工夫した方がいいかもしれませんね早速今日お願いします昨日テレビで取り上げられた料理本ありますよね買いに来るお客様や問い合わせがえるだろか在庫がどれぐらいあるか確認してください一応さっき確認したでがまだ十分あるので大丈夫だと思いますか在庫が少なければ出版社に注文しといた方がいいと思ったんですけじゃそれは今日の様子を見てからま考えましょ。"
  },
  {
   "index": 83,
   "startMs": 535920,
   "endMs": 537030,
   "text": "。"
  },
  {
   "index": 84,
   "startMs": 539770,
   "endMs": 544720,
   "text": "男の店員は今日何をしなければなりませんか。"
  },
  {
   "index": 85,
   "startMs": 559590,
   "endMs": 560820,
   "text": "5番。"
  },
  {
   "index": 86,
   "startMs": 561030,
   "endMs": 566040,
   "text": "大学で男の職員と女の職員が話して、います。"
  },
  {
   "index": 87,
   "startMs": 566770,
   "endMs": 572320,
   "text": "女の職員はこれからまず何をしなければなりませんか。"
  },
  {
   "index": 88,
   "startMs": 573590,
   "endMs": 579920,
   "text": "山中先生の退職記念の講演会だけど、今日の会議で予定通りの日に決まったよ。"
  },
  {
   "index": 89,
   "startMs": 580000,
   "endMs": 582790,
   "text": "卒業生にお知らせのメールを出してくれる。"
  },
  {
   "index": 90,
   "startMs": 582790,
   "endMs": 590470,
   "text": "あはい、公演のテーマとか詳細は未定だけど、皆さんお忙しいから日程を知らせておかないと。"
  },
  {
   "index": 91,
   "startMs": 590640,
   "endMs": 598230,
   "text": "で、詳細が決まったら改めてお知らせして、それから大学のホームページにも情報を掲載してね。"
  },
  {
   "index": 92,
   "startMs": 598230,
   "endMs": 600870,
   "text": "わかりましたそれで。"
  },
  {
   "index": 93,
   "startMs": 600990,
   "endMs": 608040,
   "text": "講演会の時間は午前か午後二つ案があったけど、午後の方になったよそうですか。"
  },
  {
   "index": 94,
   "startMs": 608220,
   "endMs": 616890,
   "text": "講委会の会場は午前も午後も予約してましたが午前はキャンセルですねあ、それだけさっきやっといたよ。"
  },
  {
   "index": 95,
   "startMs": 616990,
   "endMs": 623440,
   "text": "他に予約希望が出てるから決まり次第知らせてくれって言われてたからそうなんですか。"
  },
  {
   "index": 96,
   "startMs": 624250,
   "endMs": 631600,
   "text": "講演会の後、学内でお祝いの食事会を開くかもって話でしたがどうなったでしょうか。"
  },
  {
   "index": 97,
   "startMs": 631680,
   "endMs": 640710,
   "text": "必要ならそちらも会場を予約しますが、まあ、学内ではやらないことになったから、僕たちの方では手配しなくて大丈夫だよ。"
  },
  {
   "index": 98,
   "startMs": 640810,
   "endMs": 643120,
   "text": "ありがとうわかりました。"
  },
  {
   "index": 99,
   "startMs": 644490,
   "endMs": 645540,
   "text": "。"
  },
  {
   "index": 100,
   "startMs": 648320,
   "endMs": 653870,
   "text": "女の職員はこれからまず何をしなければなりませんか。"
  },
  {
   "index": 101,
   "startMs": 669780,
   "endMs": 671550,
   "text": "問題二。"
  },
  {
   "index": 102,
   "startMs": 671760,
   "endMs": 676230,
   "text": "問題二では、まず質問を聞いてください。"
  },
  {
   "index": 103,
   "startMs": 676720,
   "endMs": 681070,
   "text": "その後、問題用紙の選択肢を読んでください。"
  },
  {
   "index": 104,
   "startMs": 681210,
   "endMs": 683280,
   "text": "読む時間があります。"
  },
  {
   "index": 105,
   "startMs": 683990,
   "endMs": 694040,
   "text": "それから話を聞いて問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 106,
   "startMs": 696480,
   "endMs": 698790,
   "text": "では、始めます。"
  },
  {
   "index": 107,
   "startMs": 704640,
   "endMs": 705930,
   "text": "一番。"
  },
  {
   "index": 108,
   "startMs": 706180,
   "endMs": 707710,
   "text": "大学で。"
  },
  {
   "index": 109,
   "startMs": 707810,
   "endMs": 713540,
   "text": "女の学生と男の学生が動画の撮影について話して、います。"
  },
  {
   "index": 110,
   "startMs": 714160,
   "endMs": 721030,
   "text": "男の学生が今使っている照明器具を選んだ理由は何ですか？"
  },
  {
   "index": 111,
   "startMs": 744200,
   "endMs": 785750,
   "text": "森く森くがインターネットで配信してる食べ歩き動画を見たんだけど夜でもすごく綺麗に撮れてる照明器具使ってる暗いところで撮影するなら照明は羊品だよそうだよね私キャンプの動画の配信を始めたんけど夜だとうまく取れなくて森どんなの使ってる光の強さとか調節できる動画る人にはそういうのがかなり細かく調節できるのが人気だでも僕はそれより持ち運びやすさを基準にして決めたあちこち店を移動するからほどね。"
  },
  {
   "index": 112,
   "startMs": 785870,
   "endMs": 788900,
   "text": "私もキャンプに持っていくからな。"
  },
  {
   "index": 113,
   "startMs": 788900,
   "endMs": 791060,
   "text": "片手に収まるぐらい小型なんだ。"
  },
  {
   "index": 114,
   "startMs": 791060,
   "endMs": 794240,
   "text": "まあ、値段はそこそこしたけどね。"
  },
  {
   "index": 115,
   "startMs": 794240,
   "endMs": 797420,
   "text": "キャンプで使うなら防水機能があるのがいいんじゃない？"
  },
  {
   "index": 116,
   "startMs": 797420,
   "endMs": 801380,
   "text": "ああ、防水機能もかありがとう。"
  },
  {
   "index": 117,
   "startMs": 802880,
   "endMs": 803810,
   "text": "。"
  },
  {
   "index": 118,
   "startMs": 806700,
   "endMs": 813330,
   "text": "男の学生が今使っている照明器具を選んだ理由は何ですか？"
  },
  {
   "index": 119,
   "startMs": 828240,
   "endMs": 829470,
   "text": "2番。"
  },
  {
   "index": 120,
   "startMs": 829720,
   "endMs": 834190,
   "text": "オフィス用品の会社の会議で課長が話して、います。"
  },
  {
   "index": 121,
   "startMs": 834980,
   "endMs": 840590,
   "text": "この部署では、今年の展示会の準備で何を担当しますか？"
  },
  {
   "index": 122,
   "startMs": 840710,
   "endMs": 842060,
   "text": "今年です。"
  },
  {
   "index": 123,
   "startMs": 865340,
   "endMs": 871550,
   "text": "今年も新規顧客の獲得のため、展示会に出店することになりました。"
  },
  {
   "index": 124,
   "startMs": 871680,
   "endMs": 875610,
   "text": "部署ごとの仕事の割り振りが決まったので説明します。"
  },
  {
   "index": 125,
   "startMs": 875870,
   "endMs": 887120,
   "text": "うちの部署は例年、展示用のポスターの作成とサンプル商品の会場への運搬を担当していましたが、運搬の方は担当から外れました。"
  },
  {
   "index": 126,
   "startMs": 887300,
   "endMs": 896990,
   "text": "ポスターでは、当社の製品を使用している企業の事例を紹介するので、早速事例の候補を検討してください。"
  },
  {
   "index": 127,
   "startMs": 897210,
   "endMs": 901500,
   "text": "ウェブサイトで紹介しているのとは別の例がいいと思います。"
  },
  {
   "index": 128,
   "startMs": 902280,
   "endMs": 908070,
   "text": "展示会で配るパンフレットは、広報部が作成してくれることになっています。"
  },
  {
   "index": 129,
   "startMs": 909690,
   "endMs": 910620,
   "text": "う。"
  },
  {
   "index": 130,
   "startMs": 913350,
   "endMs": 918900,
   "text": "この部署では、今年の展示会の準備で何を担当しますか？"
  },
  {
   "index": 131,
   "startMs": 933800,
   "endMs": 935210,
   "text": "3番。"
  },
  {
   "index": 132,
   "startMs": 935370,
   "endMs": 940620,
   "text": "大学で男の学生と女の学生が話して、います。"
  },
  {
   "index": 133,
   "startMs": 941250,
   "endMs": 943200,
   "text": "女の学生は？"
  },
  {
   "index": 134,
   "startMs": 943330,
   "endMs": 946960,
   "text": "インターネットで就職の面接を受ける時に。"
  },
  {
   "index": 135,
   "startMs": 947070,
   "endMs": 950880,
   "text": "最も気をつけていることは何だと言っていますか？"
  },
  {
   "index": 136,
   "startMs": 974120,
   "endMs": 980510,
   "text": "山下さん、僕、来週初めてインターネットで就職の面接を受けるんだ。"
  },
  {
   "index": 137,
   "startMs": 980620,
   "endMs": 985450,
   "text": "山下さん、何回か受けたって聞いたけど、どんなことに気をつけてる？"
  },
  {
   "index": 138,
   "startMs": 985550,
   "endMs": 987380,
   "text": "そうだね。"
  },
  {
   "index": 139,
   "startMs": 987690,
   "endMs": 993600,
   "text": "相手が聞き取りやすいようにゆっくりはっきり話すようにってよく言われてるよね。"
  },
  {
   "index": 140,
   "startMs": 993600,
   "endMs": 997080,
   "text": "ああ、それは僕も気をつけようと思ってる。"
  },
  {
   "index": 141,
   "startMs": 997250,
   "endMs": 1009040,
   "text": "面接の前には画面上の設定も変えないとねそれなんかで見た画面上で顔が明るく見えるように設定を変え方がいいまだ"
  },
  {
   "index": 142,
   "startMs": 1010000,
   "endMs": 1046060,
   "text": "ないれもき画面といえばデオ通話カメラを見ないで画面に映る相手の顔を見てず目線がままと面接に集中してないて誤解を与えてい面接で話る私特に意識して面接の時の接続に問題が起きて相手に声が聞こえならどうしよううことはあるかもしれないけど。"
  },
  {
   "index": 143,
   "startMs": 1046140,
   "endMs": 1051030,
   "text": "まあ、冷静に対処すればなんとかなるよわかった。"
  },
  {
   "index": 144,
   "startMs": 1052430,
   "endMs": 1053360,
   "text": "。"
  },
  {
   "index": 145,
   "startMs": 1056250,
   "endMs": 1058140,
   "text": "女の学生は？"
  },
  {
   "index": 146,
   "startMs": 1058260,
   "endMs": 1061950,
   "text": "インターネットで就職の面接を受ける時に。"
  },
  {
   "index": 147,
   "startMs": 1062030,
   "endMs": 1065840,
   "text": "最も気をつけていることは何だと言っていますか？"
  },
  {
   "index": 148,
   "startMs": 1080840,
   "endMs": 1082190,
   "text": "4番。"
  },
  {
   "index": 149,
   "startMs": 1082420,
   "endMs": 1085570,
   "text": "テレビでレポーターが話して、います。"
  },
  {
   "index": 150,
   "startMs": 1086050,
   "endMs": 1093400,
   "text": "レポーターは先月発売されたスーツのどのような点が新しいと言っていますか。"
  },
  {
   "index": 151,
   "startMs": 1116570,
   "endMs": 1127700,
   "text": "今日は先月発売された南車のスーツを紹介しますなんと男性用のスーツが小さく畳めて手のひらサイズの袋に入れられるんです。"
  },
  {
   "index": 152,
   "startMs": 1127870,
   "endMs": 1137920,
   "text": "南はこれまでにも水を弾じく加工が施されたスーツや、汗の匂いを消す消臭効果が高いスーツを発売して話題を呼びました。"
  },
  {
   "index": 153,
   "startMs": 1138080,
   "endMs": 1143510,
   "text": "今回はコンパクトに折りたたんでも型が崩れることがないスーツです。"
  },
  {
   "index": 154,
   "startMs": 1143590,
   "endMs": 1146380,
   "text": "出張の多い方には便利ですね。"
  },
  {
   "index": 155,
   "startMs": 1146550,
   "endMs": 1158700,
   "text": "また、南では宇宙服の素材を参考に、衣服の中の温度を素材が感知調節し、一年中快適に過ごせるスーツの開発にも取り組んでいるとのことです。"
  },
  {
   "index": 156,
   "startMs": 1160180,
   "endMs": 1161110,
   "text": "。"
  },
  {
   "index": 157,
   "startMs": 1164020,
   "endMs": 1171190,
   "text": "レポーターは先月発売されたスーツのどのような点が新しいと言っていますか。"
  },
  {
   "index": 158,
   "startMs": 1186220,
   "endMs": 1187450,
   "text": "5番。"
  },
  {
   "index": 159,
   "startMs": 1187750,
   "endMs": 1193840,
   "text": "カメラの部品を作る会社で女の人と男の人が話して、います。"
  },
  {
   "index": 160,
   "startMs": 1194450,
   "endMs": 1199880,
   "text": "男の人はどうして出張することになったと言っていますか？"
  },
  {
   "index": 161,
   "startMs": 1223090,
   "endMs": 1236560,
   "text": "さっき部長に呼ばれて話し込んでたね京都に新しい工場ができて、今稼働させる準備をしてるんだけど、その件で来週から出張に行ってこいって何かあったの？"
  },
  {
   "index": 162,
   "startMs": 1236560,
   "endMs": 1250180,
   "text": "数ヶ月前に検査スタッフを大量に採用して研修もやったんだけど、理解に差があって技術がみんなに均一に定着していないから品質検査が決められた通りにできてないことがあるみたいなんだ。"
  },
  {
   "index": 163,
   "startMs": 1250180,
   "endMs": 1256600,
   "text": "それで作業効率も落ちてて工場が本格的に稼働する日も近いんでしょ。"
  },
  {
   "index": 164,
   "startMs": 1256710,
   "endMs": 1258660,
   "text": "稼働の予定に間に合うの？"
  },
  {
   "index": 165,
   "startMs": 1258660,
   "endMs": 1263100,
   "text": "その前に本社の専門家の品質検査も入るしな。"
  },
  {
   "index": 166,
   "startMs": 1263230,
   "endMs": 1269740,
   "text": "それまでに研修もう一回しっかりやって全体的にスタッフのスキルを上げてこなくちゃいけないんだ。"
  },
  {
   "index": 167,
   "startMs": 1269740,
   "endMs": 1272920,
   "text": "これで機械のトラブルでも起きたら最悪だよ。"
  },
  {
   "index": 168,
   "startMs": 1272920,
   "endMs": 1274780,
   "text": "間に合わなくなっちゃうよ。"
  },
  {
   "index": 169,
   "startMs": 1274780,
   "endMs": 1275920,
   "text": "頑張ってね。"
  },
  {
   "index": 170,
   "startMs": 1277570,
   "endMs": 1278380,
   "text": "う。"
  },
  {
   "index": 171,
   "startMs": 1281260,
   "endMs": 1286510,
   "text": "男の人はどうして出張することになったと言っていますか。"
  },
  {
   "index": 172,
   "startMs": 1301450,
   "endMs": 1302800,
   "text": "6番。"
  },
  {
   "index": 173,
   "startMs": 1303070,
   "endMs": 1308680,
   "text": "ラジオでアナウンサーと建築士の男の人が話して、います。"
  },
  {
   "index": 174,
   "startMs": 1309360,
   "endMs": 1315090,
   "text": "男の人は今お客さんに畳の部屋が好まれるのは。"
  },
  {
   "index": 175,
   "startMs": 1315220,
   "endMs": 1317410,
   "text": "どうしてだと言っていますか。"
  },
  {
   "index": 176,
   "startMs": 1340740,
   "endMs": 1344790,
   "text": "今日は建築士の伊藤さんにお話を伺います。"
  },
  {
   "index": 177,
   "startMs": 1345180,
   "endMs": 1384690,
   "text": "伊藤さん、最近は新築の家を建てる際に畳の部屋を希望する人が増えているそうですね生活や建築の洋風化に伴って畳部屋が好ない時期も長く続いたんですがここ数年、お客様の好みが変化畳独特の香りは体や心を安らかにゆったりした気分にしてくれるとことで、畳部屋にしれという依頼が増加傾向にもともと畳は湿気を吸収したり放出した湿度を調節してくれるので、日本の気候には合っているんです。"
  },
  {
   "index": 178,
   "startMs": 1384800,
   "endMs": 1406190,
   "text": "それに、空気中の有害物質も吸収してくれますしねそうした利点もあるんですね畳はクッション性があるので点倒しても怪我をしにくく、小さなお子さんがいるご家庭にもご安心いただけますおすすめですよ今後さらにお客様からの需要が高まりそうですね。"
  },
  {
   "index": 179,
   "startMs": 1407660,
   "endMs": 1408590,
   "text": "。"
  },
  {
   "index": 180,
   "startMs": 1411460,
   "endMs": 1413110,
   "text": "男の人は？"
  },
  {
   "index": 181,
   "startMs": 1413200,
   "endMs": 1419410,
   "text": "今、お客さんに畳の部屋が好まれるのはどうしてだと言っていますか。"
  },
  {
   "index": 182,
   "startMs": 1431520,
   "endMs": 1434490,
   "text": "ここでちょっと休みましょう。"
  },
  {
   "index": 183,
   "startMs": 1434830,
   "endMs": 1435640,
   "text": "。"
  },
  {
   "index": 184,
   "startMs": 1466890,
   "endMs": 1469440,
   "text": "では、また続けます。"
  },
  {
   "index": 185,
   "startMs": 1475050,
   "endMs": 1476880,
   "text": "問題三。"
  },
  {
   "index": 186,
   "startMs": 1477190,
   "endMs": 1482440,
   "text": "問題三では、問題用紙に何も印刷されていません。"
  },
  {
   "index": 187,
   "startMs": 1483040,
   "endMs": 1488110,
   "text": "この問題は全体としてどんな内容かを聞く問題です。"
  },
  {
   "index": 188,
   "startMs": 1488950,
   "endMs": 1491980,
   "text": "話の前に質問はありません。"
  },
  {
   "index": 189,
   "startMs": 1492790,
   "endMs": 1495400,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 190,
   "startMs": 1495930,
   "endMs": 1499680,
   "text": "それから質問と選択肢を聞いて。"
  },
  {
   "index": 191,
   "startMs": 1499790,
   "endMs": 1505940,
   "text": "一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 192,
   "startMs": 1508030,
   "endMs": 1510220,
   "text": "では、始めます。"
  },
  {
   "index": 193,
   "startMs": 1516080,
   "endMs": 1517370,
   "text": "一番？"
  },
  {
   "index": 194,
   "startMs": 1517580,
   "endMs": 1521330,
   "text": "文房具の会社で社長が話して、います。"
  },
  {
   "index": 195,
   "startMs": 1522790,
   "endMs": 1526600,
   "text": "このところ、新たなヒット商品が出せていません。"
  },
  {
   "index": 196,
   "startMs": 1526900,
   "endMs": 1534970,
   "text": "既存の商品の売り上げは順調ですが、会社が飛躍するためには新しいものを生み出す必要があります。"
  },
  {
   "index": 197,
   "startMs": 1535380,
   "endMs": 1544230,
   "text": "伝統にしがみつかず、これまでにないものを提案することは新しい文化の創造だと言っても過言ではありません。"
  },
  {
   "index": 198,
   "startMs": 1544420,
   "endMs": 1548950,
   "text": "皆さん、批判を恐れずにどんどん挑戦してください。"
  },
  {
   "index": 199,
   "startMs": 1549250,
   "endMs": 1557140,
   "text": "今はパソコンで文章を書くことが当たり前になって、いますが、昔は文字を書くと言えば手だったわけです。"
  },
  {
   "index": 200,
   "startMs": 1557260,
   "endMs": 1562870,
   "text": "つまり、今の当たり前は昔は奇抜なものだったかもしれません。"
  },
  {
   "index": 201,
   "startMs": 1562960,
   "endMs": 1564670,
   "text": "周囲に驚かれるよ。"
  },
  {
   "index": 202,
   "startMs": 1564670,
   "endMs": 1568270,
   "text": "うなものこそ、会社にとっては宝なのです。"
  },
  {
   "index": 203,
   "startMs": 1569910,
   "endMs": 1570840,
   "text": "。"
  },
  {
   "index": 204,
   "startMs": 1573760,
   "endMs": 1576910,
   "text": "社長が言いたいことは何ですか？"
  },
  {
   "index": 205,
   "startMs": 1578200,
   "endMs": 1579370,
   "text": "1。"
  },
  {
   "index": 206,
   "startMs": 1579620,
   "endMs": 1583070,
   "text": "会社の業績を回復させてほしい。"
  },
  {
   "index": 207,
   "startMs": 1585330,
   "endMs": 1586440,
   "text": "二？"
  },
  {
   "index": 208,
   "startMs": 1586590,
   "endMs": 1589740,
   "text": "会社の伝統を大事にしてほしい。"
  },
  {
   "index": 209,
   "startMs": 1591980,
   "endMs": 1593150,
   "text": "3。"
  },
  {
   "index": 210,
   "startMs": 1593400,
   "endMs": 1596310,
   "text": "新しいアイディアを出してほしい。"
  },
  {
   "index": 211,
   "startMs": 1598590,
   "endMs": 1599700,
   "text": "4。"
  },
  {
   "index": 212,
   "startMs": 1600060,
   "endMs": 1604110,
   "text": "新しく開発した商品をヒットさせてほしい。"
  },
  {
   "index": 213,
   "startMs": 1615160,
   "endMs": 1616390,
   "text": "2番。"
  },
  {
   "index": 214,
   "startMs": 1616690,
   "endMs": 1621220,
   "text": "テレビでアナウンサーが俳優にインタビューして、います。"
  },
  {
   "index": 215,
   "startMs": 1622530,
   "endMs": 1642960,
   "text": "今日は現在公開中の映画、虹の山に出演されている川本真司さんにお話を伺います、川本さん、今回は山での撮影が多かったそうですが、何かご苦労ありましたか標高の高い場所での撮影ということで、体調管理には気を遣いましたね。"
  },
  {
   "index": 216,
   "startMs": 1643080,
   "endMs": 1664290,
   "text": "無事体調を崩さずに撮影を終えることができてホッとしましたそうですか川本さんは主人公の登山家を取材するカメラマンの役で、すねはい、この役は初めは山の知識がほとんどない設定なんですが、実は僕自身は登山が大好きであ、そうなんですか。"
  },
  {
   "index": 217,
   "startMs": 1664390,
   "endMs": 1669760,
   "text": "最初にお話をいただいた時から、山での撮影を楽しみにしていたぐらいです。"
  },
  {
   "index": 218,
   "startMs": 1669880,
   "endMs": 1676030,
   "text": "なので、山に慣れていないように振る舞うところは不自然にならないように特に意識しました。"
  },
  {
   "index": 219,
   "startMs": 1676030,
   "endMs": 1686350,
   "text": "なるほど、それから登山家の方々に伺った話も参考にして、登山の魅力が伝わるようにということを心がけましたそうですか。"
  },
  {
   "index": 220,
   "startMs": 1687800,
   "endMs": 1688790,
   "text": "。"
  },
  {
   "index": 221,
   "startMs": 1691640,
   "endMs": 1694970,
   "text": "俳優は何について話していますか。"
  },
  {
   "index": 222,
   "startMs": 1696180,
   "endMs": 1697350,
   "text": "1。"
  },
  {
   "index": 223,
   "startMs": 1697540,
   "endMs": 1700510,
   "text": "今回の役を引き受けた経緯。"
  },
  {
   "index": 224,
   "startMs": 1702740,
   "endMs": 1703910,
   "text": "2？"
  },
  {
   "index": 225,
   "startMs": 1704040,
   "endMs": 1707130,
   "text": "役を演じる上で気をつけたこと。"
  },
  {
   "index": 226,
   "startMs": 1709330,
   "endMs": 1710500,
   "text": "3。"
  },
  {
   "index": 227,
   "startMs": 1710690,
   "endMs": 1713480,
   "text": "山での撮影の面白さ。"
  },
  {
   "index": 228,
   "startMs": 1715800,
   "endMs": 1716970,
   "text": "4。"
  },
  {
   "index": 229,
   "startMs": 1717200,
   "endMs": 1719870,
   "text": "登山家との交流の思い出。"
  },
  {
   "index": 230,
   "startMs": 1730870,
   "endMs": 1732280,
   "text": "3番。"
  },
  {
   "index": 231,
   "startMs": 1732420,
   "endMs": 1735870,
   "text": "ラジオでサッカー選手が話して、います。"
  },
  {
   "index": 232,
   "startMs": 1737220,
   "endMs": 1745650,
   "text": "ピアノを弾くのが趣味だっていうと驚かれるんですが、子供の頃7八年習ってて結構弾けるんですよ。"
  },
  {
   "index": 233,
   "startMs": 1746130,
   "endMs": 1753600,
   "text": "他の楽器でもそうかもしれませんが、ピアノを弾くのって意外に運動に通じるところがあるんです。"
  },
  {
   "index": 234,
   "startMs": 1754130,
   "endMs": 1756800,
   "text": "集中力が求められますし。"
  },
  {
   "index": 235,
   "startMs": 1756900,
   "endMs": 1763290,
   "text": "リズム感とか体全体で表現する感覚みたいなものが活性化されるというか。"
  },
  {
   "index": 236,
   "startMs": 1763920,
   "endMs": 1773370,
   "text": "引いてる時、どうすれば上達するかって考えながらやっていて、その点でもサッカーと通じるところがあるなと思います。"
  },
  {
   "index": 237,
   "startMs": 1773900,
   "endMs": 1779990,
   "text": "野球選手にもピアノを習ってることがプレイに役立ってるって言ってる方がいましたね。"
  },
  {
   "index": 238,
   "startMs": 1781370,
   "endMs": 1782420,
   "text": "。"
  },
  {
   "index": 239,
   "startMs": 1785220,
   "endMs": 1789150,
   "text": "この選手は何について話していますか？"
  },
  {
   "index": 240,
   "startMs": 1790250,
   "endMs": 1791360,
   "text": "1。"
  },
  {
   "index": 241,
   "startMs": 1791520,
   "endMs": 1794370,
   "text": "スポーツ選手に人気の趣味。"
  },
  {
   "index": 242,
   "startMs": 1796620,
   "endMs": 1797730,
   "text": "2？"
  },
  {
   "index": 243,
   "startMs": 1797900,
   "endMs": 1800750,
   "text": "ピアノを習い始めたきっかけ。"
  },
  {
   "index": 244,
   "startMs": 1803020,
   "endMs": 1804130,
   "text": "3。"
  },
  {
   "index": 245,
   "startMs": 1804380,
   "endMs": 1807590,
   "text": "ピアノが上達する練習方法。"
  },
  {
   "index": 246,
   "startMs": 1809840,
   "endMs": 1811070,
   "text": "4。"
  },
  {
   "index": 247,
   "startMs": 1811310,
   "endMs": 1814820,
   "text": "ピアノ演奏がスポーツと共通する点。"
  },
  {
   "index": 248,
   "startMs": 1825840,
   "endMs": 1827190,
   "text": "4番。"
  },
  {
   "index": 249,
   "startMs": 1827360,
   "endMs": 1830750,
   "text": "講演会で医者が話しています。"
  },
  {
   "index": 250,
   "startMs": 1832010,
   "endMs": 1837500,
   "text": "テレビなどでよく健康法や長生きの秘訣が紹介されますね。"
  },
  {
   "index": 251,
   "startMs": 1837720,
   "endMs": 1845670,
   "text": "体にある食材を毎日食べるなど、誰にでも簡単にできると言って紹介されるものも多いです。"
  },
  {
   "index": 252,
   "startMs": 1845670,
   "endMs": 1856710,
   "text": "試すこと自体は悪くありません、ただ、患者さんと話してるとそういった健康法が誰にでも効果があると思ってる方が多いと感じます。"
  },
  {
   "index": 253,
   "startMs": 1856710,
   "endMs": 1875490,
   "text": "栄養の偏りや運動不足、あるいはもともとの体質など健康を損なう原因は人によって違いますですから、例えば何かの栄養をとることが勧められていてもすでに十分に足りてる栄養だったら取る必要はないわけです。"
  },
  {
   "index": 254,
   "startMs": 1875630,
   "endMs": 1884600,
   "text": "テレビなどで取り上げられているものでも、自分の状態に合ったものかどうかを見極めることが健康への第一歩なんです。"
  },
  {
   "index": 255,
   "startMs": 1886180,
   "endMs": 1887230,
   "text": "。"
  },
  {
   "index": 256,
   "startMs": 1889980,
   "endMs": 1893190,
   "text": "医者は何について話していますか？"
  },
  {
   "index": 257,
   "startMs": 1894420,
   "endMs": 1895530,
   "text": "1。"
  },
  {
   "index": 258,
   "startMs": 1895780,
   "endMs": 1899530,
   "text": "テレビで紹介された健康法の効果。"
  },
  {
   "index": 259,
   "startMs": 1901680,
   "endMs": 1902730,
   "text": "二？"
  },
  {
   "index": 260,
   "startMs": 1902920,
   "endMs": 1906190,
   "text": "誰にでも効果のある健康法。"
  },
  {
   "index": 261,
   "startMs": 1908450,
   "endMs": 1909560,
   "text": "三。"
  },
  {
   "index": 262,
   "startMs": 1909850,
   "endMs": 1913360,
   "text": "健康法を取り入れる際の注意点。"
  },
  {
   "index": 263,
   "startMs": 1915600,
   "endMs": 1916710,
   "text": "4。"
  },
  {
   "index": 264,
   "startMs": 1916980,
   "endMs": 1920310,
   "text": "長生きしている人の体の特徴。"
  },
  {
   "index": 265,
   "startMs": 1931420,
   "endMs": 1932650,
   "text": "5番。"
  },
  {
   "index": 266,
   "startMs": 1932950,
   "endMs": 1936760,
   "text": "ある市の議会で議員が話して、います。"
  },
  {
   "index": 267,
   "startMs": 1937970,
   "endMs": 1948500,
   "text": "東地区では高層マンションの建設が計画されており、それに伴って今後、学歴期の子供が増えることが見込まれます。"
  },
  {
   "index": 268,
   "startMs": 1948750,
   "endMs": 1955800,
   "text": "東地区の東小学校では、現在の教室数では対応できなくなると予想されています。"
  },
  {
   "index": 269,
   "startMs": 1955910,
   "endMs": 1964460,
   "text": "また、後舎が築50年を経過しており、受震対策など、必ずしも万然とは言えません。"
  },
  {
   "index": 270,
   "startMs": 1964770,
   "endMs": 1969660,
   "text": "特別教室などの設備の拡充も必要になっています。"
  },
  {
   "index": 271,
   "startMs": 1969780,
   "endMs": 1974910,
   "text": "こうした点を踏まえ、早急に立て直すことが求められます。"
  },
  {
   "index": 272,
   "startMs": 1975030,
   "endMs": 1983219,
   "text": "市の財政も潤沢とは言えませんが、未来を担う子どもたちの教育は最優先課題と考え。"
  },
  {
   "index": 273,
   "startMs": 1983330,
   "endMs": 1989120,
   "text": "関係費用を来年度予算に計上することを提案する次第です。"
  },
  {
   "index": 274,
   "startMs": 1994360,
   "endMs": 1997270,
   "text": "議員が言いたいことは何ですか？"
  },
  {
   "index": 275,
   "startMs": 1998440,
   "endMs": 1999550,
   "text": "一？"
  },
  {
   "index": 276,
   "startMs": 1999760,
   "endMs": 2004110,
   "text": "東地区の将来の子供の数を予測するべきだ。"
  },
  {
   "index": 277,
   "startMs": 2006350,
   "endMs": 2007460,
   "text": "二？"
  },
  {
   "index": 278,
   "startMs": 2007600,
   "endMs": 2010810,
   "text": "東小学校を建て替えるべきだ。"
  },
  {
   "index": 279,
   "startMs": 2012930,
   "endMs": 2014160,
   "text": "3。"
  },
  {
   "index": 280,
   "startMs": 2014430,
   "endMs": 2017460,
   "text": "教育内容を改革するべきだ。"
  },
  {
   "index": 281,
   "startMs": 2019760,
   "endMs": 2020870,
   "text": "4。"
  },
  {
   "index": 282,
   "startMs": 2021090,
   "endMs": 2024060,
   "text": "市の予算を削減するべきだ。"
  },
  {
   "index": 283,
   "startMs": 2035440,
   "endMs": 2037270,
   "text": "問題4。"
  },
  {
   "index": 284,
   "startMs": 2037530,
   "endMs": 2042660,
   "text": "問題四では、問題用紙に何も印刷されていません。"
  },
  {
   "index": 285,
   "startMs": 2043140,
   "endMs": 2045870,
   "text": "まず文を聞いてください。"
  },
  {
   "index": 286,
   "startMs": 2046230,
   "endMs": 2049920,
   "text": "それからそれに対する返事を聞いて。"
  },
  {
   "index": 287,
   "startMs": 2050010,
   "endMs": 2055920,
   "text": "一から三の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 288,
   "startMs": 2058190,
   "endMs": 2060440,
   "text": "では、始めます。"
  },
  {
   "index": 289,
   "startMs": 2065800,
   "endMs": 2067090,
   "text": "一番。"
  },
  {
   "index": 290,
   "startMs": 2067370,
   "endMs": 2071360,
   "text": "お客様、そちら新作のジャケットです。"
  },
  {
   "index": 291,
   "startMs": 2071360,
   "endMs": 2074060,
   "text": "よかったらお召しになってみてください。"
  },
  {
   "index": 292,
   "startMs": 2075220,
   "endMs": 2076450,
   "text": "1。"
  },
  {
   "index": 293,
   "startMs": 2076650,
   "endMs": 2079140,
   "text": "あ、遠慮なくいただきます。"
  },
  {
   "index": 294,
   "startMs": 2080410,
   "endMs": 2081520,
   "text": "二？"
  },
  {
   "index": 295,
   "startMs": 2081730,
   "endMs": 2083680,
   "text": "後でお召しになります。"
  },
  {
   "index": 296,
   "startMs": 2084920,
   "endMs": 2086090,
   "text": "3。"
  },
  {
   "index": 297,
   "startMs": 2086410,
   "endMs": 2088540,
   "text": "じゃあこれ試着します。"
  },
  {
   "index": 298,
   "startMs": 2099570,
   "endMs": 2100740,
   "text": "2番。"
  },
  {
   "index": 299,
   "startMs": 2101040,
   "endMs": 2106650,
   "text": "うちの新人たち、みんな必ず契約取ってみせるって営業に向かったよ。"
  },
  {
   "index": 300,
   "startMs": 2107880,
   "endMs": 2109050,
   "text": "1。"
  },
  {
   "index": 301,
   "startMs": 2109260,
   "endMs": 2111390,
   "text": "やる気があっていいね。"
  },
  {
   "index": 302,
   "startMs": 2112560,
   "endMs": 2113670,
   "text": "二？"
  },
  {
   "index": 303,
   "startMs": 2113880,
   "endMs": 2116550,
   "text": "え、何を見せてもらったの？"
  },
  {
   "index": 304,
   "startMs": 2117770,
   "endMs": 2118940,
   "text": "3。"
  },
  {
   "index": 305,
   "startMs": 2119190,
   "endMs": 2121440,
   "text": "契約取れてよかったね。"
  },
  {
   "index": 306,
   "startMs": 2132460,
   "endMs": 2133870,
   "text": "3番。"
  },
  {
   "index": 307,
   "startMs": 2134100,
   "endMs": 2140610,
   "text": "今の映画のラストシーン、映像と繊細な音楽が相まって印象的だったね。"
  },
  {
   "index": 308,
   "startMs": 2141760,
   "endMs": 2142930,
   "text": "1。"
  },
  {
   "index": 309,
   "startMs": 2143130,
   "endMs": 2146340,
   "text": "ほ当、うまく引き立てあってたね。"
  },
  {
   "index": 310,
   "startMs": 2147510,
   "endMs": 2148680,
   "text": "2。"
  },
  {
   "index": 311,
   "startMs": 2148850,
   "endMs": 2151340,
   "text": "音楽が邪魔だったってこと？"
  },
  {
   "index": 312,
   "startMs": 2152510,
   "endMs": 2153740,
   "text": "3。"
  },
  {
   "index": 313,
   "startMs": 2153960,
   "endMs": 2157050,
   "text": "確かにどっちもイマイチだったね。"
  },
  {
   "index": 314,
   "startMs": 2168030,
   "endMs": 2169380,
   "text": "4番。"
  },
  {
   "index": 315,
   "startMs": 2169610,
   "endMs": 2176420,
   "text": "お客様、本日お席にご案内できるまでお時間頂ょ戴しそうなんですが。"
  },
  {
   "index": 316,
   "startMs": 2177540,
   "endMs": 2178710,
   "text": "1。"
  },
  {
   "index": 317,
   "startMs": 2178970,
   "endMs": 2181580,
   "text": "あ、ちょうど空いてましたね。"
  },
  {
   "index": 318,
   "startMs": 2182710,
   "endMs": 2183880,
   "text": "2。"
  },
  {
   "index": 319,
   "startMs": 2184050,
   "endMs": 2185820,
   "text": "じゃあ急ぎます。"
  },
  {
   "index": 320,
   "startMs": 2187030,
   "endMs": 2188260,
   "text": "3。"
  },
  {
   "index": 321,
   "startMs": 2188450,
   "endMs": 2190580,
   "text": "どのくらい待ちますか？"
  },
  {
   "index": 322,
   "startMs": 2197750,
   "endMs": 2198500,
   "text": "あ。"
  },
  {
   "index": 323,
   "startMs": 2201540,
   "endMs": 2202770,
   "text": "5番。"
  },
  {
   "index": 324,
   "startMs": 2203040,
   "endMs": 2208290,
   "text": "総務の佐藤さんの細やかな対応にはいつも頭が下がるよ。"
  },
  {
   "index": 325,
   "startMs": 2209360,
   "endMs": 2210590,
   "text": "一。"
  },
  {
   "index": 326,
   "startMs": 2210790,
   "endMs": 2212860,
   "text": "そんなに不満なんだ。"
  },
  {
   "index": 327,
   "startMs": 2214020,
   "endMs": 2215190,
   "text": "2。"
  },
  {
   "index": 328,
   "startMs": 2215390,
   "endMs": 2217760,
   "text": "本当尊敬するよね。"
  },
  {
   "index": 329,
   "startMs": 2219020,
   "endMs": 2220190,
   "text": "3。"
  },
  {
   "index": 330,
   "startMs": 2220390,
   "endMs": 2222340,
   "text": "注意してあげたら。"
  },
  {
   "index": 331,
   "startMs": 2233320,
   "endMs": 2234670,
   "text": "6番。"
  },
  {
   "index": 332,
   "startMs": 2234960,
   "endMs": 2240870,
   "text": "今回のプロジェクトは、御社のご協力なくしては成功しませんでしたよ。"
  },
  {
   "index": 333,
   "startMs": 2242020,
   "endMs": 2243190,
   "text": "1？"
  },
  {
   "index": 334,
   "startMs": 2243400,
   "endMs": 2246010,
   "text": "お力に慣れて何よりです。"
  },
  {
   "index": 335,
   "startMs": 2247190,
   "endMs": 2248300,
   "text": "2。"
  },
  {
   "index": 336,
   "startMs": 2248500,
   "endMs": 2251470,
   "text": "ご協力できればよかったんですが。"
  },
  {
   "index": 337,
   "startMs": 2252640,
   "endMs": 2253810,
   "text": "3。"
  },
  {
   "index": 338,
   "startMs": 2254060,
   "endMs": 2256970,
   "text": "私どもの力不足でした。"
  },
  {
   "index": 339,
   "startMs": 2267970,
   "endMs": 2269260,
   "text": "7番。"
  },
  {
   "index": 340,
   "startMs": 2269490,
   "endMs": 2274320,
   "text": "村田さん、来週緑山に初めて登るでしょ？"
  },
  {
   "index": 341,
   "startMs": 2274410,
   "endMs": 2278940,
   "text": "初級者向けの山だけど、用心に越したことはないからね。"
  },
  {
   "index": 342,
   "startMs": 2280080,
   "endMs": 2281310,
   "text": "1。"
  },
  {
   "index": 343,
   "startMs": 2281540,
   "endMs": 2284150,
   "text": "確かに用心しすぎですね。"
  },
  {
   "index": 344,
   "startMs": 2285430,
   "endMs": 2286600,
   "text": "2。"
  },
  {
   "index": 345,
   "startMs": 2286780,
   "endMs": 2289270,
   "text": "簡単そうで安心しました。"
  },
  {
   "index": 346,
   "startMs": 2290350,
   "endMs": 2291580,
   "text": "3。"
  },
  {
   "index": 347,
   "startMs": 2291860,
   "endMs": 2293690,
   "text": "注意して臨みます。"
  },
  {
   "index": 348,
   "startMs": 2304750,
   "endMs": 2306100,
   "text": "8番。"
  },
  {
   "index": 349,
   "startMs": 2306330,
   "endMs": 2312060,
   "text": "最近涼しいのにアイスこんなに仕入れて売れる見込みないんじゃない？"
  },
  {
   "index": 350,
   "startMs": 2313270,
   "endMs": 2314380,
   "text": "1。"
  },
  {
   "index": 351,
   "startMs": 2314640,
   "endMs": 2317370,
   "text": "もう少し仕入れておきましょうか。"
  },
  {
   "index": 352,
   "startMs": 2318570,
   "endMs": 2319680,
   "text": "2？"
  },
  {
   "index": 353,
   "startMs": 2319860,
   "endMs": 2321210,
   "text": "よかった。"
  },
  {
   "index": 354,
   "startMs": 2321210,
   "endMs": 2322950,
   "text": "売れ始めたんですね。"
  },
  {
   "index": 355,
   "startMs": 2324200,
   "endMs": 2325370,
   "text": "3。"
  },
  {
   "index": 356,
   "startMs": 2325560,
   "endMs": 2328710,
   "text": "いや、需要あると思いますよ。"
  },
  {
   "index": 357,
   "startMs": 2339710,
   "endMs": 2341060,
   "text": "9番。"
  },
  {
   "index": 358,
   "startMs": 2341360,
   "endMs": 2348290,
   "text": "サークルのことで相談があるって言ってたよね今日の夕方だったら時間取れなくもないよ？"
  },
  {
   "index": 359,
   "startMs": 2349400,
   "endMs": 2350630,
   "text": "1。"
  },
  {
   "index": 360,
   "startMs": 2350820,
   "endMs": 2352650,
   "text": "今日は無理なんだね。"
  },
  {
   "index": 361,
   "startMs": 2354000,
   "endMs": 2355050,
   "text": "2？"
  },
  {
   "index": 362,
   "startMs": 2355220,
   "endMs": 2357590,
   "text": "忙しいのに悪いね。"
  },
  {
   "index": 363,
   "startMs": 2358710,
   "endMs": 2360000,
   "text": "3。"
  },
  {
   "index": 364,
   "startMs": 2360230,
   "endMs": 2362720,
   "text": "夕方までだねわかった。"
  },
  {
   "index": 365,
   "startMs": 2373670,
   "endMs": 2375020,
   "text": "10番。"
  },
  {
   "index": 366,
   "startMs": 2375320,
   "endMs": 2380150,
   "text": "さっき見た映画、アクションシーンが迫力に欠けてたよね。"
  },
  {
   "index": 367,
   "startMs": 2381420,
   "endMs": 2382590,
   "text": "1。"
  },
  {
   "index": 368,
   "startMs": 2382790,
   "endMs": 2385640,
   "text": "アクションシーンだから仕方ないよ。"
  },
  {
   "index": 369,
   "startMs": 2386860,
   "endMs": 2387970,
   "text": "2。"
  },
  {
   "index": 370,
   "startMs": 2388210,
   "endMs": 2390520,
   "text": "ちょっと物足りなかったね。"
  },
  {
   "index": 371,
   "startMs": 2391800,
   "endMs": 2392850,
   "text": "三？"
  },
  {
   "index": 372,
   "startMs": 2393140,
   "endMs": 2395390,
   "text": "そんなに気に入ったんだ。"
  },
  {
   "index": 373,
   "startMs": 2406380,
   "endMs": 2408030,
   "text": "11番。"
  },
  {
   "index": 374,
   "startMs": 2408240,
   "endMs": 2413310,
   "text": "先生に頼まれた文献集め、思いのほかはかどらなかったね。"
  },
  {
   "index": 375,
   "startMs": 2414510,
   "endMs": 2415620,
   "text": "1。"
  },
  {
   "index": 376,
   "startMs": 2415840,
   "endMs": 2418630,
   "text": "長時間探した割にはね。"
  },
  {
   "index": 377,
   "startMs": 2419850,
   "endMs": 2420960,
   "text": "二？"
  },
  {
   "index": 378,
   "startMs": 2421190,
   "endMs": 2423500,
   "text": "順調にできてよかったね。"
  },
  {
   "index": 379,
   "startMs": 2424740,
   "endMs": 2425910,
   "text": "3。"
  },
  {
   "index": 380,
   "startMs": 2426140,
   "endMs": 2428510,
   "text": "一つも見つからなかったの？"
  },
  {
   "index": 381,
   "startMs": 2439960,
   "endMs": 2441670,
   "text": "問題五。"
  },
  {
   "index": 382,
   "startMs": 2441930,
   "endMs": 2445740,
   "text": "問題五では、長めの話を聞きます。"
  },
  {
   "index": 383,
   "startMs": 2446320,
   "endMs": 2449830,
   "text": "問題用紙にメモを取っても構いません。"
  },
  {
   "index": 384,
   "startMs": 2451580,
   "endMs": 2452930,
   "text": "一番。"
  },
  {
   "index": 385,
   "startMs": 2453350,
   "endMs": 2457100,
   "text": "問題用紙に何も印刷されていません。"
  },
  {
   "index": 386,
   "startMs": 2457600,
   "endMs": 2460450,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 387,
   "startMs": 2460740,
   "endMs": 2464550,
   "text": "それから質問と選択肢を聞いて。"
  },
  {
   "index": 388,
   "startMs": 2464680,
   "endMs": 2471010,
   "text": "一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 389,
   "startMs": 2473240,
   "endMs": 2475730,
   "text": "では、始めます。"
  },
  {
   "index": 390,
   "startMs": 2481300,
   "endMs": 2486010,
   "text": "地域の日本語教室でスタッフ三人が話して、います。"
  },
  {
   "index": 391,
   "startMs": 2487300,
   "endMs": 2538390,
   "text": "教室で日本語を教えるボランティアがなかなか増えません市の広報誌に定期的にボランティア募集の案内を載せてるんですが少し前に一人見学に来ま入ってもらえなかっその日はいつもよりさらにボランティアの数が少なかボラティ人でいんなレベルの学習者人らいに対応をしてたのその様子を見て自分には難しそて尻込みし教え方のマニュアルでも作りまマニュアルを作って対応できる問題じゃないです学習者のレベルも目的もボランティアの種類を分けて募集するのはどう日本語を教えるボンティアと会話の相手をするボランティア。"
  },
  {
   "index": 392,
   "startMs": 2538500,
   "endMs": 2542250,
   "text": "会話のボランティアならやってみようと思う人もいるかもしれませんよ。"
  },
  {
   "index": 393,
   "startMs": 2542250,
   "endMs": 2547110,
   "text": "どちらかというと教えられる人に来てもらえるといいんですけどね。"
  },
  {
   "index": 394,
   "startMs": 2547110,
   "endMs": 2559470,
   "text": "去年まで頑張ってくれてた大学生のボランティアが就職を機に何人か抜けちゃったのが残念ですね言語学や教育学を学んでたから教え方も上手でしたし。"
  },
  {
   "index": 395,
   "startMs": 2559550,
   "endMs": 2580640,
   "text": "市内の大学に募集のポスターを貼らせてもらいましょうか大学生だとまた就職とかで辞めちゃうんじゃないですかまずは応募してもらわないとね市の広報士よりも目に止まりそうだしやってみましょうか今回はボランティアの種類は分けずに募集してみましょう。"
  },
  {
   "index": 396,
   "startMs": 2582180,
   "endMs": 2583110,
   "text": "。"
  },
  {
   "index": 397,
   "startMs": 2586000,
   "endMs": 2590530,
   "text": "ボランティアを増やすために何をすることにしましたか。"
  },
  {
   "index": 398,
   "startMs": 2591700,
   "endMs": 2592870,
   "text": "1。"
  },
  {
   "index": 399,
   "startMs": 2593050,
   "endMs": 2596860,
   "text": "市の広報士で募集する回数を増やす。"
  },
  {
   "index": 400,
   "startMs": 2599060,
   "endMs": 2600170,
   "text": "2？"
  },
  {
   "index": 401,
   "startMs": 2600340,
   "endMs": 2603010,
   "text": "教え方のマニュアルを作る。"
  },
  {
   "index": 402,
   "startMs": 2605270,
   "endMs": 2606440,
   "text": "3。"
  },
  {
   "index": 403,
   "startMs": 2606690,
   "endMs": 2609900,
   "text": "ボランティアの種類を分けて募集する。"
  },
  {
   "index": 404,
   "startMs": 2612160,
   "endMs": 2613330,
   "text": "4。"
  },
  {
   "index": 405,
   "startMs": 2613550,
   "endMs": 2617120,
   "text": "市内の大学に募集のポスターを貼る。"
  },
  {
   "index": 406,
   "startMs": 2628740,
   "endMs": 2630030,
   "text": "2番。"
  },
  {
   "index": 407,
   "startMs": 2630320,
   "endMs": 2632930,
   "text": "まず話を聞いてください。"
  },
  {
   "index": 408,
   "startMs": 2633150,
   "endMs": 2636660,
   "text": "それから二つの質問を聞いて。"
  },
  {
   "index": 409,
   "startMs": 2636790,
   "endMs": 2644920,
   "text": "それぞれ問題用紙の一から四の中から最も良いものを一つ選んでください。"
  },
  {
   "index": 410,
   "startMs": 2647240,
   "endMs": 2649550,
   "text": "では、始めます。"
  },
  {
   "index": 411,
   "startMs": 2655150,
   "endMs": 2661120,
   "text": "ある町の農業に関する説明会で役所の人の説明を聞いた後。"
  },
  {
   "index": 412,
   "startMs": 2661250,
   "endMs": 2664460,
   "text": "男の人と女の人が話して、います。"
  },
  {
   "index": 413,
   "startMs": 2665740,
   "endMs": 2670390,
   "text": "この街で力を入れている4つの農作物をご紹介します。"
  },
  {
   "index": 414,
   "startMs": 2670470,
   "endMs": 2676200,
   "text": "説明の後で、各農作物について個別の相談もお受けします。"
  },
  {
   "index": 415,
   "startMs": 2676310,
   "endMs": 2681200,
   "text": "まずは光原の涼しい機構を利用したキャベツ栽培。"
  },
  {
   "index": 416,
   "startMs": 2681330,
   "endMs": 2690660,
   "text": "種巻きから収穫まで手がかかりますが、近年、産地として強価されるようになり、収益性が高いのも特徴です。"
  },
  {
   "index": 417,
   "startMs": 2690830,
   "endMs": 2693680,
   "text": "次に、火のこと一ちご。"
  },
  {
   "index": 418,
   "startMs": 2693800,
   "endMs": 2701150,
   "text": "どちらもハウス栽培で管理は大変ですが、田んぼや畑よりは力仕事が少ないです。"
  },
  {
   "index": 419,
   "startMs": 2701250,
   "endMs": 2707640,
   "text": "キノコは栄養が豊富で健康にいいということで、安定した需要があります。"
  },
  {
   "index": 420,
   "startMs": 2707880,
   "endMs": 2716490,
   "text": "イ号は観光客向けの収客体験通話にも協力していて、農園の一部をカフェにしているところもあります。"
  },
  {
   "index": 421,
   "startMs": 2716790,
   "endMs": 2718380,
   "text": "最後はお米。"
  },
  {
   "index": 422,
   "startMs": 2718380,
   "endMs": 2722880,
   "text": "この町の米は味が良いことで昔から知られて、います。"
  },
  {
   "index": 423,
   "startMs": 2722980,
   "endMs": 2731110,
   "text": "設備投資は大掛かりになりますが、農家と行政が一体となって美味しい米作りに取り組んでいます。"
  },
  {
   "index": 424,
   "startMs": 2732410,
   "endMs": 2733520,
   "text": "いろいろある。"
  },
  {
   "index": 425,
   "startMs": 2733520,
   "endMs": 2734660,
   "text": "んで、すね。"
  },
  {
   "index": 426,
   "startMs": 2734780,
   "endMs": 2738350,
   "text": "どちらからいらしたんですか東京からです。"
  },
  {
   "index": 427,
   "startMs": 2738430,
   "endMs": 2741460,
   "text": "農業に関わりたいなと思ってきたんです。"
  },
  {
   "index": 428,
   "startMs": 2741630,
   "endMs": 2783960,
   "text": "体力に沿う自信があるわけじゃないんですけど力仕事が比較的少ないていうのもあるみたいで私人と接するのも好きなので農作業だけじゃお客さんの対応もするのが向いてると思ってその説明を聞きたと思っまで私は農業で整計を立ててきのでやっぱり収入を重視しまです実は私この街出身なので伝統的に作られてきたものにも思い入れがあるんでそれより新しい地域の名産として評価され始めたものをこれからもっと売り出す方に興味があってその説明を聞きにこうと思てます。"
  },
  {
   "index": 429,
   "startMs": 2785420,
   "endMs": 2786410,
   "text": "。"
  },
  {
   "index": 430,
   "startMs": 2789280,
   "endMs": 2791230,
   "text": "質問一？"
  },
  {
   "index": 431,
   "startMs": 2791470,
   "endMs": 2797200,
   "text": "女の人はどの農作物の説明を聞きたいと言っていますか？"
  },
  {
   "index": 432,
   "startMs": 2806470,
   "endMs": 2807400,
   "text": "。"
  },
  {
   "index": 433,
   "startMs": 2810280,
   "endMs": 2812110,
   "text": "質問2。"
  },
  {
   "index": 434,
   "startMs": 2812240,
   "endMs": 2818030,
   "text": "男の人はどの農作物の説明を聞きたいと言っていますか？"
  }
 ],
 "audioVerified": false,
 "alternatives": {}
}